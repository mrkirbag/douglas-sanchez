---
import Navbar from "../components/Navbar.astro"
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="shortcut icon" href="/favicon.webp" type="image/webp">
		<meta name="generator" content={Astro.generator} />
		<title>Sistema Inventario</title>
	</head>
	<body>

		<div class="navbar">
			<Navbar />
		</div>

		<div class="content">
			<slot />
		</div>
	</body>
</html>

<style is:global>

	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	:root {
		--primary-color: #002a49;
		--secondary-color: #003e58;
		--gray-color: #cccccc;
		--gray-light: #f4f6f8;
		--gray-border: #e2e6ea;
		--table-header-color: #DADADA;
		--danger-color: #ff4d4d;
		--danger-hover-color: #a51515;
		--success-color: #008000;
		--success-hover-color: #006600;
		--shadow-sm: 0 1px 3px rgba(0, 42, 73, 0.08);
		--shadow-md: 0 4px 12px rgba(0, 42, 73, 0.12);
		--radius-sm: 6px;
		--radius-md: 10px;
		--radius-lg: 14px;
		--transition: 0.2s ease;
	}

	@font-face {
		font-family: 'Archivo Black';
		src: url('/fonts/ArchivoBlack-Regular.woff2') format('woff2');
		font-weight: normal;
		font-style: normal;
	}

	@font-face {
		font-family: 'Roboto';
		src: url('/fonts/Roboto-Regular.woff2') format('woff2');
		font-weight: normal;
		font-style: normal;	
	}

	body {
		font-family: 'Roboto', sans-serif;
		overflow-x: hidden;
		max-width: 100%;
	}

	html {
		overflow-x: hidden;
		max-width: 100%;
	}

	.navbar {
		position: fixed;
		z-index: 1;
	}

	.content {
		max-width: 1200px;
		width: calc(100% - 180px);
		min-width: 0;
		height: 100%;
		min-height: 100vh;
		margin: 0 auto;
		margin-left: 180px;
		padding: 1.5rem 2.5rem 2.5rem;
		background-color: var(--gray-light);
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		box-sizing: border-box;
		overflow-x: clip;
	}

	h1 {
		text-align: center;
		font-size: 1.75rem;
		margin: 0.5rem 0 0.25rem;
		font-family: 'Archivo Black', sans-serif;
		color: var(--primary-color);
		letter-spacing: 0.5px;
		position: relative;
		padding-bottom: 0.75rem;
	}

	h1::after {
		content: '';
		display: block;
		width: 60px;
		height: 3px;
		background: var(--primary-color);
		margin: 0.5rem auto 0;
		border-radius: 2px;
		opacity: 0.6;
	}

	.btn-add_container {
		background: var(--primary-color);
		border-radius: var(--radius-sm);
		max-width: fit-content;
		display: inline-flex;
		justify-content: center;
		align-items: center;
		box-shadow: var(--shadow-sm);
		transition: background var(--transition), transform var(--transition), box-shadow var(--transition);

		& .btn-add {
			padding: 0.5rem 1.1rem;
			width: 100%;
			text-align: center;
			color: #fff;
			text-decoration: none;
			font-size: 0.875rem;
			font-weight: 600;
			white-space: nowrap;
		}

		&:hover {
			background: var(--secondary-color);
			transform: translateY(-1px);
			box-shadow: var(--shadow-md);
			cursor: pointer;
		}

		&:active {
			transform: translateY(0);
			cursor: pointer;
		}

	}

	.input-busqueda_container {
		display: flex;
		justify-content: center;
		margin-bottom: 1.25rem;

		& input {
			width: 100%;
			max-width: 280px;
			padding: 0.65rem 0.85rem;
			border: 1px solid var(--gray-border);
			border-radius: var(--radius-sm);
			font-size: 0.9rem;
			background: #fff;
			box-shadow: var(--shadow-sm);
			transition: border-color var(--transition), box-shadow var(--transition);

			&:focus {
				outline: none;
				border-color: var(--primary-color);
				box-shadow: 0 0 0 3px rgba(0, 42, 73, 0.12);
			}
		}
	}

	table {
		width: 100%;
		max-width: 100%;
		margin-bottom: 0.5rem;
		border-collapse: separate;
		border-spacing: 0;
		background: #fff;
		border-radius: var(--radius-md);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		border: 1px solid var(--gray-border);
		table-layout: auto;

		& th {
			background-color: var(--primary-color);
			color: #fff;
			font-weight: 600;
			font-size: 0.8rem;
			text-transform: uppercase;
			letter-spacing: 0.4px;
			padding: 0.85rem 1rem;
			text-align: left;
			border-bottom: 2px solid var(--secondary-color);
		}

		& th:first-child {
			border-top-left-radius: var(--radius-md);
		}

		& th:last-child {
			border-top-right-radius: var(--radius-md);
		}

		& tbody tr {
			border-bottom: 1px solid var(--gray-border);
			width: 100%;
			transition: background-color var(--transition);

			&:nth-child(even) {
				background-color: rgba(0, 42, 73, 0.02);
			}

			&:last-child {
				border-bottom: none;
			}

			&:hover {
				background-color: rgba(0, 42, 73, 0.06);
			}
		}

		td {
			padding: 0.85rem 1rem;
			text-align: left;
			font-size: 0.875rem;
			color: #333;
			vertical-align: middle;
			word-break: break-word;
			overflow-wrap: break-word;
		}

		.acciones {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;

			& button {
				font-size: 0.7rem;
				color: #fff;
				font-weight: 600;
				border: none;
				padding: 0.35rem 0.65rem;
				border-radius: var(--radius-sm);
				transition: background-color var(--transition), transform var(--transition);
				letter-spacing: 0.3px;

				&:hover {
					cursor: pointer;
					transform: translateY(-1px);
				}

				&:active {
					transform: translateY(0);
				}
			}

			& .btn-clave, .btn-stock, .btn-detalles {
				background: var(--primary-color);

				&:hover {
					background-color: var(--secondary-color);
				}
			}

			& .btn-eliminar {
				background-color: var(--danger-color);

				&:hover {
					background-color: var(--danger-hover-color);
				}
			}

			& .btn-editar {
				background-color: var(--primary-color);

				&:hover {
					background-color: var(--secondary-color);
				}
			}

		}
	}
	
	.btn-vermas_container {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 20px;

		& button {
			background-color: var(--primary-color);
			color: #fff;
			border-radius: 5px;
			max-width: 150px;
			padding: .35rem .75rem;
			text-align: center;
			font-size: .9rem;
			border: none;
			outline: none;

			&:hover {
				background-color: var(--secondary-color);
				cursor: pointer;
				scale: 1.05;
			}

			&:active {
				scale: 0.95;
				cursor: pointer;
			}
		}
	}

	.form-container {
		margin: 0 auto;
		width: 100%;
		max-width: 480px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		background: #fff;
		border-radius: var(--radius-lg);
		padding: 1.75rem;
		box-shadow: var(--shadow-md);
		border: 1px solid var(--gray-border);
	}

	form {
		width: 100%;
		max-width: 480px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: stretch;
		gap: 1rem;
	}

	form div {
		width: 100%;
	}

	form label {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--primary-color);
		text-transform: uppercase;
		letter-spacing: 0.4px;
		margin-bottom: 0.35rem;
		display: block;
	}

	form input, form select {
		width: 100%;
		padding: 0.65rem 0.85rem;
		border: 1px solid var(--gray-border);
		border-radius: var(--radius-sm);
		font-size: 0.9rem;
		background: #fff;
		transition: border-color var(--transition), box-shadow var(--transition);

		&:focus {
			outline: none;
			border-color: var(--primary-color);
			box-shadow: 0 0 0 3px rgba(0, 42, 73, 0.12);
		}
	}

	select {
		appearance: none;
		-moz-appearance: none;
		-webkit-appearance: none;
		background: #fff url('/down-arrow.svg') no-repeat right 12px center;
		padding-right: 2rem;
		cursor: pointer;
	}

	form select option {
		font-size: 0.85rem;
		background: #fff;
	}

	form button, .button {
		text-decoration: none;
		margin-top: 0.5rem;
		background-color: var(--primary-color);
		color: #fff;
		border-radius: var(--radius-sm);
		align-self: center;
		min-width: 150px;
		padding: 0.55rem 1.25rem;
		text-align: center;
		font-size: 0.9rem;
		font-weight: 600;
		border: none;
		outline: none;
		box-shadow: var(--shadow-sm);
		transition: background-color var(--transition), transform var(--transition), box-shadow var(--transition);

		&:hover {
			background-color: var(--secondary-color);
			cursor: pointer;
			transform: translateY(-1px);
			box-shadow: var(--shadow-md);
		}

		&:active {
			transform: translateY(0);
			cursor: pointer;
		}
	}

	.password-container {
		width: 100%;
		display: flex;
		align-items: stretch;
		gap: 0.5rem;

		& input {
			flex: 1;
			min-width: 0;
		}
	}

	.btn-toggle-password {
		flex-shrink: 0;
		align-self: stretch;
		padding: 0 0.85rem;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.5px;
		color: var(--primary-color);
		background: var(--gray-light);
		border: 1px solid var(--gray-border);
		border-radius: var(--radius-sm);
		cursor: pointer;
		transition: background var(--transition), color var(--transition), border-color var(--transition);
		white-space: nowrap;

		&:hover {
			background: var(--primary-color);
			color: #fff;
			border-color: var(--primary-color);
		}
	}

	.select-container {
		width: 100%;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;

		& select {
			flex: 1;
			min-width: 0;
		}
	}

	.table-section {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	.mensaje-sin-registros {
		margin: 0 auto;
		width: 100%;
		color: #fff;
		background: var(--danger-color);
		text-align: center;
		font-size: 1rem;
		padding: 0.75rem 1rem;
		border-radius: var(--radius-sm);
		box-shadow: var(--shadow-sm);
	}

	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		width: 100%;
		padding: 2rem 1.5rem;
		background: #fff;
		border: 2px dashed var(--gray-border);
		border-radius: var(--radius-md);
		text-align: center;
		color: #666;

		p {
			font-size: 0.95rem;
			font-weight: 600;
			color: var(--primary-color);
			margin: 0;
		}

		span {
			font-size: 0.8rem;
			color: #888;
		}
	}

	.empty-state.hidden {
		display: none;
	}

	.productos-panel.hidden {
		display: none;
	}

	@media (max-width: 768px) {

		h1 {
			text-align: center;
			font-size: 1.35rem;
		}

		table, tbody, th, td, tr {
			display: block;
			width: 100%;
		}

		table {
			border-radius: var(--radius-sm);
			overflow: visible;
			box-shadow: none;
			border: none;
			background: transparent;
		}

		thead {
			display: none !important;
		}

		tbody tr {
			margin-bottom: 0.75rem;
			border: 1px solid var(--gray-border);
			border-radius: var(--radius-md);
			padding: 0.85rem;
			background-color: #fff;
			box-shadow: var(--shadow-sm);
		}

		td {
			text-align: left;
			padding: 0.35rem 0;
			position: relative;
			font-size: 0.85rem;
			border: none;
		}

		td::before {
			content: attr(data-label);
			font-weight: 700;
			display: block;
			margin-bottom: 0.15rem;
			color: var(--primary-color);
			font-size: 0.7rem;
			text-transform: uppercase;
			letter-spacing: 0.3px;
		}

		form {
			max-width: 100%;
		}

		.form-container {
			padding: 1.25rem;
		}
	}

	@media (max-width: 768px) {
		.content {
			margin-left: 0;
			width: 100%;
			padding: 1rem 1rem;
			overflow-x: hidden;
		}

		.navbar {
			z-index: 1000;
		}

		.form-container {
			width: 100%;
		}
	}

	.modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: clamp(200px, 80vw, 400px); 
        max-height: 80vh;
        background: #FFF;
        color: #000;
        font-size: 1.2rem;
        font-family: "Roboto", sans-serif; 
        padding: 1.5rem;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2); 
        display: flex;
        flex-direction: column; 
        align-items: center;
        justify-content: center;
		text-align: center;
        z-index: 1000;
        transition: display 3s ease-in-out;
    }

    .overlay {
        position: fixed;
        top: 0; 
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);
        z-index: 999;
        transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
    }

    .visible {
        opacity: 1;
        display: flex;
        pointer-events: auto;
    }

    .oculto {
        opacity: 0;
        display: none;
        pointer-events: none;
    }

    .mensaje-exito {
        border: 6px solid var(--success-color);
    }

    .mensaje-error {
        border: 6px solid var(--danger-color);
    }

</style>
