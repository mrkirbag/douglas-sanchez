---
import Layout from '../layouts/Layout.astro';
import { verificarToken } from '../utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}

const usuarioNombre = usuario.nombre;
---

<Layout>
    <main class="dashboard">
        <section class="empresa">
            <img src="/logo.webp" alt="Logo de la Empresa" />
            <div>
                <h2 class="title">DOUGLAS SÁNCHEZ</h2>
                <h3>J-506718936</h3>
            </div>
        </section>

        <section class="usuario">
            <h1>Bienvenido, {usuarioNombre.toUpperCase()}</h1>
        </section>

        <section class="agotados">
            <h2>Productos Agotados</h2>
            <div id="tablaAgotados" class="noResponsive"></div>
        </section>

        <section class="ventas">
            <h2>Ultimas Ventas del Día</h2>
            <div id="ventasDia" class="noResponsive"></div>
        </section>

        <section class="stock-bajo">
            <h2>Productos Bajos en Stock</h2>
            <div id="reportes"></div>
        </section>
    </main>
</Layout>

<style>

    :global(.content:has(.dashboard)) {
        min-height: auto;
        height: auto;
        overflow-y: visible;
        padding-bottom: 1.5rem;
    }

    :global(main.dashboard) {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: auto auto;
        gap: 1.5rem;
        padding: 1.5rem;
        background: linear-gradient(to bottom, #f4f4f4, #fff);
        border-radius: var(--radius-lg);
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }

    @media (max-width: 768px) {

        :global(main.dashboard) {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
            padding: 1rem;
        }

        section {
            width: 100%;
        }

        :global(.empresa),
        :global(.stock-bajo) {
            display: none !important;
        }

        :global(.noResponsive table) {
            display: table !important;
            width: 100% !important;
        }

        :global(.noResponsive thead) {
            display: table-header-group !important;
        }

        :global(.noResponsive tbody) {
            display: table-row-group !important;
        }

        :global(.noResponsive tr) {
            display: table-row !important;
            margin: 0 !important;
            border: none !important;
            border-radius: 0 !important;
            padding: 0 !important;
            background: transparent !important;
        }

        :global(.noResponsive th),
        :global(.noResponsive td) {
            display: table-cell !important;
            width: auto !important;
            text-align: inherit !important;
            position: static !important;
        }

        :global(.noResponsive td)::before {
            content: none !important;
        }
    }


    /* Secciones */
    section {
        background: #fff;
        border-radius: var(--radius-md);
        padding: 1rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-border);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        min-width: 0;
    }

    .agotados,
    .ventas {
        align-items: stretch;

        h2 {
            margin-bottom: 0.75rem;
        }

        :global(.noResponsive) {
            width: 100%;
            overflow-x: auto;
        }
    }

    .stock-bajo {
        :global(#reportes) {
            width: 100%;
            min-height: 200px;
        }
    }

    .empresa {
        grid-column: 1 / 2;
        grid-row: 1 / 2;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;

        & img {
            max-width: 150px;
            height: auto;
        }

        & div {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
        }
    }

    .usuario {
        grid-column: 2 / 4;
        grid-row: 1 / 2;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--secondary-color);
        color: #fff;
    }

    .agotados {
        padding: .5rem;
        grid-column: 1 / 2;
        grid-row: 2 / 3;
        color: var(--primary-color);
    }

    .ventas {
        grid-column: 2 / 3;
        grid-row: 2 / 3;
    }

    .stock-bajo {
        grid-column: 3 / 4;
        grid-row: 2 / 3;
    }

    .title {
        font-family: 'Archivo Black', sans-serif;
        font-size: 1rem;
        text-align: center;
        color: var(--secondary-color);
    }

    h3, h2 {
        color: var(--secondary-color);
        font-weight: 700;
        font-size: 1rem;
    }

    :global(table) {
        width: 100%;
        border-collapse: collapse;
        font-size: .8rem;
    }

    :global(.empty-msg) {
        font-size: 0.85rem;
        color: #888;
        font-style: italic;
        padding: 0.5rem 0;
        margin: 0;
    }

</style>

<script>

    import { formatearFecha } from "@/utils/helpers/formateoFecha";
    import { cambioUSDaCOP } from "@/utils/helpers/cambioMoneda";
    import { renderChart } from "@/utils/helpers/chart.js";
    

    interface Producto {
        nombre: string;
        codigo: string;
        stock: number;
        unidad_medida: string;
    }

    interface Ventas {
        id: number;
        fecha: string;
        total: number;
        cliente: string;
    }

    document.addEventListener('DOMContentLoaded', async () => {

        const tasa = await cambioUSDaCOP();
        
        // agotados
        const tablaAgotados = document.getElementById('tablaAgotados') as HTMLElement;

        const response = await fetch('/api/index/agotados');
        const productos: Producto[] = await response.json();

        if(response.status === 200){

            let tablaHTML = `<table><tbody>`;

            productos.forEach(producto => {
                tablaHTML += `<tr><td>${producto.nombre}<br/>${producto.codigo}</td><td>${producto.stock} ${producto.unidad_medida}.</td></tr>`;
            });

            tablaHTML += '</tbody></table>';
            tablaAgotados.innerHTML = tablaHTML;
        } else {
            tablaAgotados.innerHTML = '<p class="empty-msg">No hay productos agotados</p>';
        }

        // ultimas tres ventas del día
        const ventasDiaDiv = document.getElementById('ventasDia') as HTMLElement;

        const ventasResponse = await fetch('/api/index/ventas');
        const ventasData :Ventas[] = await ventasResponse.json();

        if(ventasResponse.status === 200){

            let ventasHTML = `<table><tbody>`;

            ventasData.forEach(venta => {
                ventasHTML += `<tr><td>${venta.cliente.toUpperCase()}</td><td>${venta.total.toFixed(2)} COP <br/> ${(venta.total / tasa).toFixed(2)} USD</td></tr>`;
            });

            ventasHTML += '</tbody></table>';
            ventasDiaDiv.innerHTML = ventasHTML;

        } else {
            ventasDiaDiv.innerHTML = '<p class="empty-msg">No hay ventas hoy</p>';
        }

        // Grafica de productos bajos en stock
        const stokBajo = document.getElementById('reportes') as HTMLDivElement;

        const stockResponse = await fetch('/api/index/stockBajo');
        const stockData :Producto[] = await stockResponse.json();

        if(stockResponse.status === 200){

            renderChart(
                'Productos Bajos en Stock', 
                stockData.map(producto => producto.nombre), 
                stockData.map(producto => producto.stock)
            );

        } else {
            stokBajo.innerHTML = '<p class="empty-msg">No hay productos bajos en stock</p>';
        }

    });
    



</script>