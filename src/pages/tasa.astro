---
import Layout from "../layouts/Layout.astro";
import { verificarToken } from "../utils/auth.js";

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect("/login");
}
---

<Layout>
    <header class="page-header">
        <p class="eyebrow">Configuración Fiscal y Monetaria</p>
        <h1>Tasas y Retenciones</h1>
    </header>

    <section class="tasas-resumen">
        <article>
            <p class="eyebrow">Tasa COP (USD → COP)</p>
            <p><span id="tasaCopTexto">—</span></p>
        </article>
        <article>
            <p class="eyebrow">Tasa BCV (USD → Bs)</p>
            <p><span id="tasaBsTexto">—</span></p>
        </article>
        <article>
            <p class="eyebrow">Tasa COP → Bs (BCV)</p>
            <p><span id="tasaCopBsTexto">—</span></p>
            <small class="resumen-hint">COP ÷ tasa = Bs a BCV</small>
        </article>
        <article>
            <p class="eyebrow">Alícuota IVA Fiscal</p>
            <p><span id="ivaPorcentajeTexto">16</span>%</p>
            <small class="resumen-hint"
                >Calculado sobre Base Imponible BCV</small
            >
        </article>
        <article>
            <p class="eyebrow">Retención de IVA</p>
            <p><span id="retencionIvaTexto">75</span>%</p>
            <small class="resumen-hint"
                >Por defecto para Contribuyentes Especiales</small
            >
        </article>
    </section>

    <section class="form-container page-form">
        <form id="formulario">
            <div class="form-section-title">
                <h2>Tasas de Cambio del Día</h2>
            </div>

            <div class="form-field">
                <label for="tasaCop"
                    >Tasa COP (pesos por 1 USD en Divisas)</label
                >
                <input
                    type="text"
                    id="tasaCop"
                    name="tasaCop"
                    placeholder="Ej. 4000"
                    required
                />
            </div>

            <div class="form-field">
                <label for="tasaBs">Tasa BCV (Bs por 1 USD)</label>
                <input
                    type="text"
                    id="tasaBs"
                    name="tasaBs"
                    placeholder="Ej. 36.50"
                    required
                />
            </div>

            <div class="form-field">
                <label for="tasaCopBs">Tasa COP a Bs (pesos por 1 Bs)</label>
                <input
                    type="text"
                    id="tasaCopBs"
                    name="tasaCopBs"
                    placeholder="Ej. 3"
                    required
                />
            </div>

            <div class="form-section-title">
                <h2>Retenciones e Impuestos</h2>
            </div>

            <div class="form-field">
                <label for="ivaPorcentaje">IVA General (%)</label>
                <input
                    type="text"
                    id="ivaPorcentaje"
                    name="ivaPorcentaje"
                    placeholder="Ej. 16"
                    required
                />
            </div>

            <div class="form-field">
                <label for="retencionIvaPorcentaje"
                    >Retención de IVA por defecto (%)</label
                >
                <select
                    id="retencionIvaPorcentaje"
                    name="retencionIvaPorcentaje"
                >
                    <option value="75"
                        >75% (Contribuyente Especial Ordinario)</option
                    >
                    <option value="100"
                        >100% (Contribuyente Especial 100%)</option
                    >
                    <option value="0">0% (Sin retención por defecto)</option>
                </select>
            </div>

            <div class="form-actions">
                <button type="submit">Actualizar tasas y retenciones</button>
            </div>
        </form>
    </section>

    <div id="mensaje"></div>
    <div id="overlay" class="overlay oculto">
        <div id="modal" class="modal"></div>
    </div>
</Layout>

<script>
    import { mostrarError, mostrarMensaje } from "@/utils/helpers/mensajes.js";
    import { invalidarCacheTasa } from "@/utils/helpers/cambioMoneda.js";

    async function parseApiResponse(response: Response) {
        const contentType = response.headers.get("content-type") || "";

        if (contentType.includes("application/json")) {
            return response.json();
        }

        const text = await response.text();
        return { error: text || "Error inesperado del servidor" };
    }

    function numeroInput(valor: string) {
        return parseFloat(String(valor || "").replace(",", "."));
    }

    document.addEventListener("DOMContentLoaded", async () => {
        const tasaCopTexto = document.getElementById(
            "tasaCopTexto",
        ) as HTMLElement;
        const tasaBsTexto = document.getElementById(
            "tasaBsTexto",
        ) as HTMLElement;
        const tasaCopBsTexto = document.getElementById(
            "tasaCopBsTexto",
        ) as HTMLElement;
        const ivaPorcentajeTexto = document.getElementById(
            "ivaPorcentajeTexto",
        ) as HTMLElement;
        const retencionIvaTexto = document.getElementById(
            "retencionIvaTexto",
        ) as HTMLElement;

        const inputTasaCop = document.getElementById(
            "tasaCop",
        ) as HTMLInputElement;
        const inputTasaBs = document.getElementById(
            "tasaBs",
        ) as HTMLInputElement;
        const inputTasaCopBs = document.getElementById(
            "tasaCopBs",
        ) as HTMLInputElement;
        const inputIvaPorcentaje = document.getElementById(
            "ivaPorcentaje",
        ) as HTMLInputElement;
        const selectRetencionIva = document.getElementById(
            "retencionIvaPorcentaje",
        ) as HTMLSelectElement;

        try {
            const response = await fetch("/api/tasa");

            if (response.status === 204) {
                mostrarMensaje(
                    "No hay tasa registrada aún. Ingresa los valores iniciales.",
                );
                return;
            }

            const data = await parseApiResponse(response);

            if (!response.ok) {
                mostrarError(
                    data.error ||
                        data.message ||
                        "Error al cargar las tasas del día",
                );
                return;
            }

            const cop = data.tasa_cop ?? data.cop ?? data.valor ?? "";
            const bs = data.tasa_bcv ?? data.bs ?? "";
            const copABs = data.tasa_cop_bs ?? data.cop_a_bs ?? 3;
            const iva = data.iva_porcentaje ?? 16;
            const retIva = data.retencion_iva_porcentaje ?? 75;

            tasaCopTexto.textContent = cop === "" ? "—" : String(cop);
            tasaBsTexto.textContent =
                bs === "" || Number(bs) === 0 ? "—" : String(bs);
            tasaCopBsTexto.textContent =
                copABs === "" || Number(copABs) === 0 ? "—" : String(copABs);
            ivaPorcentajeTexto.textContent = String(iva);
            retencionIvaTexto.textContent = String(retIva);

            inputTasaCop.value = cop === "" ? "" : String(cop);
            inputTasaBs.value = bs === "" || Number(bs) === 0 ? "" : String(bs);
            inputTasaCopBs.value = copABs === "" || Number(copABs) === 0 ? "" : String(copABs);
            inputIvaPorcentaje.value = String(iva);
            selectRetencionIva.value = String(retIva);
        } catch (error: any) {
            mostrarError(error.message || "Error al cargar las tasas del día");
        }
    });

    const formulario = document.getElementById("formulario") as HTMLFormElement;

    formulario?.addEventListener("submit", async (event: SubmitEvent) => {
        event.preventDefault();

        const cop = numeroInput(
            (document.getElementById("tasaCop") as HTMLInputElement).value,
        );
        const bs = numeroInput(
            (document.getElementById("tasaBs") as HTMLInputElement).value,
        );
        const cop_a_bs = numeroInput(
            (document.getElementById("tasaCopBs") as HTMLInputElement).value,
        );
        const iva_porcentaje = numeroInput(
            (document.getElementById("ivaPorcentaje") as HTMLInputElement)
                .value,
        );
        const retencion_iva_porcentaje = numeroInput(
            (
                document.getElementById(
                    "retencionIvaPorcentaje",
                ) as HTMLSelectElement
            ).value,
        );

        if (!Number.isFinite(cop) || cop <= 0) {
            mostrarError("La tasa COP debe ser un número mayor a 0");
            return;
        }

        if (!Number.isFinite(bs) || bs <= 0) {
            mostrarError("La tasa BCV (Bs) debe ser un número mayor a 0");
            return;
        }

        if (!Number.isFinite(cop_a_bs) || cop_a_bs <= 0) {
            mostrarError("La tasa COP a Bs debe ser un número mayor a 0");
            return;
        }

        if (
            !Number.isFinite(iva_porcentaje) ||
            iva_porcentaje < 0 ||
            iva_porcentaje > 100
        ) {
            mostrarError("El porcentaje de IVA debe estar entre 0 y 100");
            return;
        }

        try {
            const response = await fetch("/api/tasa", {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({
                    tasa_cop: cop,
                    tasa_bcv: bs,
                    tasa_cop_bs: cop_a_bs,
                    cop,
                    bs,
                    cop_a_bs,
                    iva_porcentaje,
                    retencion_iva_porcentaje,
                }),
            });

            const data = await parseApiResponse(response);

            if (!response.ok) {
                mostrarError(
                    data.error ||
                        data.message ||
                        "Error al actualizar las tasas y retenciones",
                );
                return;
            }

            invalidarCacheTasa();
            mostrarMensaje("Tasas y retenciones actualizadas correctamente");
            setTimeout(() => {
                window.location.reload();
            }, 900);
        } catch (error: any) {
            mostrarError(error.message);
        }
    });
</script>

<style>
    .tasas-resumen {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin: 1.25rem 0;
    }

    .tasas-resumen article {
        padding: 1.1rem 1.2rem;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.86);
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
        box-shadow: 0 18px 32px rgba(var(--primary-rgb), 0.08);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .tasas-resumen p:nth-child(2) {
        margin: 0.2rem 0 0;
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--secondary-color);
    }

    .resumen-hint {
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    .form-section-title {
        grid-column: 1 / -1;
        margin-top: 0.5rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid rgba(var(--secondary-rgb), 0.12);
    }

    .form-section-title h2 {
        margin: 0;
        font-size: 1.05rem;
        color: var(--primary-color);
    }

    .form-section-title p {
        margin: 0.25rem 0 0;
        font-size: 0.84rem;
        color: var(--text-muted);
    }

    @media (max-width: 960px) {
        .tasas-resumen {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 560px) {
        .tasas-resumen {
            grid-template-columns: 1fr;
        }
    }
</style>
