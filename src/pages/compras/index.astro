---
import Layout from "../../layouts/Layout.astro";
import { verificarToken } from "@/utils/auth.js";

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect("/login");
}
if (usuario.rol !== "admin") {
    return Astro.redirect("/dashboard");
}
---

<Layout>
    <header class="page-header">
        <p class="eyebrow">Gestión de inventario</p>
        <h1>Compras</h1>
        <p class="page-intro">Visualiza y gestiona las compras realizadas a proveedores.</p>
    </header>
    <div class="page-toolbar">
        <div class="toolbar-actions">
            <div class="btn-add_container">
                <a class="btn-add" href="/compras/nueva">Registrar compra</a>
            </div>
            <div class="btn-add_container">
                <a class="btn-add" id="btnImportarExcel" style="cursor: pointer;">Importar desde Excel</a>
            </div>
            <div class="btn-add_container" style="background: linear-gradient(135deg, #15803d, #166534);">
                <a class="btn-add" id="btnExportarExcel" style="cursor: pointer;">Exportar a Excel</a>
            </div>
        </div>
    </div>

    <div id="overlayExcel" class="overlay oculto" style="z-index: 1000;">
        <div class="modal" style="max-width: 560px; width: 92%; text-align: left;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                <h3 style="margin:0;">Importar Inventario / Compra desde Excel</h3>
                <button type="button" id="btnCerrarModalExcel" style="background:none; border:none; font-size:1.5rem; cursor:pointer; color:inherit;">&times;</button>
            </div>
            <div style="margin-bottom:1rem;">
                <button type="button" id="btnDescargarPlantilla" style="background: rgba(21,128,61,0.12); color:#15803d; border:1px solid rgba(21,128,61,0.3); padding:0.45rem 0.9rem; border-radius:8px; font-weight:700; cursor:pointer;">
                    Descargar Plantilla (.xlsx)
                </button>
            </div>
            <form id="formImportarExcel" style="display:grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap:0.75rem;">
                <div class="form-field" style="grid-column: 1 / -1;">
                    <label for="impTipoDoc">Tipo de Documento</label>
                    <select id="impTipoDoc">
                        <option value="nota_entrega">Nota de Entrega / Inventario Inicial (Sin IVA)</option>
                        <option value="factura">Factura Fiscal de Compra (Con IVA)</option>
                    </select>
                </div>
                <div class="form-field">
                    <label for="impProveedor">Proveedor *</label>
                    <input type="text" id="impProveedor" required placeholder="Ej: Distribuidora XYZ" />
                </div>
                <div class="form-field">
                    <label for="impRif">RIF Proveedor</label>
                    <input type="text" id="impRif" placeholder="J-12345678-9" />
                </div>
                <div class="form-field imp-fiscal" style="display:none;">
                    <label for="impNroFactura">N° Factura *</label>
                    <input type="text" id="impNroFactura" placeholder="00012345" />
                </div>
                <div class="form-field imp-fiscal" style="display:none;">
                    <label for="impNroControl">N° Control</label>
                    <input type="text" id="impNroControl" placeholder="00-0012345" />
                </div>
                <div class="form-field imp-fiscal" style="display:none; grid-column: 1 / -1;">
                    <label for="impRetencion">Retención IVA (%)</label>
                    <select id="impRetencion">
                        <option value="0">0% (Sin retención)</option>
                        <option value="75">75%</option>
                        <option value="100">100%</option>
                    </select>
                </div>
                <div class="form-field" style="grid-column: 1 / -1;">
                    <label for="archivoExcel">Archivo Excel (.xlsx / .xls) *</label>
                    <input type="file" id="archivoExcel" accept=".xlsx, .xls" required />
                </div>
                <div style="grid-column: 1 / -1; display:flex; justify-content:flex-end; gap:0.6rem; margin-top:0.5rem;">
                    <button type="button" id="btnCancelarExcel" class="btn-detalles">Cancelar</button>
                    <button type="submit" id="btnConfirmarExcel" class="btn-confirmar" style="padding:0.6rem 1.2rem;">Importar Inventario</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-wrap">
        <table>
            <thead id="thead">
                <tr>
                    <th>Fecha / Doc</th>
                    <th>Proveedor</th>
                    <th>IVA Crédito</th>
                    <th>Monto Total</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="lista"> </tbody>
        </table>
    </div>

    <div id="mensaje"></div>
</Layout>

<script>
    // @ts-nocheck
    import { noRegistros, mostrarError, mostrarMensaje } from "@/utils/helpers/mensajes.js";
    import { obtenerTasas } from "@/utils/helpers/cambioMoneda.js";
    import { convertirAMonedaBase, desgloseMontos, formatearMoneda, obtenerMonedaBase } from "@/utils/helpers/tasas.js";
    import { formatearFecha } from "@/utils/helpers/formateoFecha.js";
    import { descargarExcel } from "@/utils/helpers/exportarExcel.js";

    let comprasCargadas = [];
    let tasasActuales = { cop: 0, bs: 0, cop_a_bs: 3 };
    const monedaBase = obtenerMonedaBase();

    document.addEventListener("DOMContentLoaded", () => {
        const thead = document.getElementById("thead");
        const lista = document.getElementById("lista");

        async function cargarCompras() {
            // Cargar datos
            try {
                const respuesta = await fetch("/api/compras/");

                if (respuesta.status === 202) {
                    thead.style.display = "none";
                    noRegistros(
                        "No hay compras registradas",
                        document.getElementById("mensaje"),
                    );
                    return;
                }

                const datos = await respuesta.json();
                comprasCargadas = Array.isArray(datos) ? datos : [];
                tasasActuales = await obtenerTasas();

                thead.style.display = "table-header-group";

                datos.forEach((compra) => {
                    const fila = document.createElement("tr");
                    const esNota = compra.tipo_documento === "nota_entrega";
                    const badge = esNota
                        ? `<span style="display:inline-block; font-size:0.65rem; padding:2px 6px; border-radius:99px; background:rgba(16,185,129,0.14); color:#047857; font-weight:800;">NOTA ENTREGA</span>`
                        : `<span style="display:inline-block; font-size:0.65rem; padding:2px 6px; border-radius:99px; background:rgba(37,99,235,0.14); color:#1d4ed8; font-weight:800;">FACTURA FISCAL</span>`;
                    const esCreditoPendiente = compra.tipo_pago === "credito" && compra.estado_pago === "pendiente";
                    const creditoBadge = compra.tipo_pago === "credito"
                        ? (esCreditoPendiente
                            ? ` <span style="display:inline-block; font-size:0.65rem; padding:2px 6px; border-radius:99px; background:rgba(217,119,6,0.14); color:#b45309; font-weight:800;">CRÉDITO PENDIENTE</span>`
                            : ` <span style="display:inline-block; font-size:0.65rem; padding:2px 6px; border-radius:99px; background:rgba(22,163,74,0.14); color:#15803d; font-weight:800;">CRÉDITO PAGADO</span>`)
                        : "";
                    const docInfo = compra.nro_factura
                        ? `<br/><strong>Fact: ${compra.nro_factura}</strong>${compra.nro_control ? ` <small>(Ctrl: ${compra.nro_control})</small>` : ""}`
                        : "";
                    const rifInfo = compra.proveedor_rif ? `<br/><small>RIF: ${compra.proveedor_rif}</small>` : "";
                    const ivaVal = Number(compra.iva_monto) || 0;
                    const retVal = Number(compra.retencion_iva_monto) || 0;
                    const ivaHtml = esNota
                        ? `<small>Sin IVA</small>`
                        : `<strong>${formatearMoneda(ivaVal, monedaBase)}</strong>${retVal > 0 ? `<br/><small style="color:#b45309;">Ret: -${formatearMoneda(retVal, monedaBase)}</small>` : ""}`;
                    const totalVal = Number(compra.monto_total) || 0;
                    const tasaBcv = Number(compra.tasa_bcv) || 0;
                    const tasasCompra = {
                        ...tasasActuales,
                        bs: tasaBcv > 0 ? tasaBcv : tasasActuales.bs,
                    };
                    const totalDesglose = desgloseMontos(totalVal, monedaBase, tasasCompra);

                    fila.innerHTML = `
                        <td data-label="Fecha / Doc">${badge}${creditoBadge}<br/>${formatearFecha(compra.fecha)}${docInfo}</td>
                        <td data-label="Proveedor"><strong>${compra.proveedor.toUpperCase()}</strong>${rifInfo}</td>
                        <td data-label="IVA Crédito">${ivaHtml}</td>
                        <td data-label="Monto Total">
                            <strong>${totalDesglose.principal}</strong>
                            <br />
                            <small>${totalDesglose.secundarias}</small>
                        </td>
                    `;

                    const tdAcciones = document.createElement("td");
                    tdAcciones.classList.add("acciones");

                    const btnDetalles = document.createElement("button");
                    btnDetalles.type = "button";
                    btnDetalles.classList.add("btn-detalles");
                    btnDetalles.textContent = "Ver Detalles";
                    btnDetalles.onclick = () => {
                        window.location.href = `/compras/${compra.id}`;
                    };

                    tdAcciones.appendChild(btnDetalles);
                    fila.appendChild(tdAcciones);
                    lista.appendChild(fila);
                });
            } catch (error) {
                console.error(error);
            }
        }

        cargarCompras();

        // Importación Excel (Modal + Plantilla + Campos Fiscales)
        const btnImportarExcel = document.getElementById("btnImportarExcel");
        const overlayExcel = document.getElementById("overlayExcel");
        const btnCerrarModalExcel = document.getElementById("btnCerrarModalExcel");
        const btnCancelarExcel = document.getElementById("btnCancelarExcel");
        const formImportarExcel = document.getElementById("formImportarExcel");
        const impTipoDoc = document.getElementById("impTipoDoc");
        const btnDescargarPlantilla = document.getElementById("btnDescargarPlantilla");
        const btnConfirmarExcel = document.getElementById("btnConfirmarExcel");
        const archivoExcel = document.getElementById("archivoExcel");

        const cerrarModalExcel = () => overlayExcel?.classList.add("oculto");

        btnImportarExcel?.addEventListener("click", () => {
            overlayExcel?.classList.remove("oculto");
        });
        btnCerrarModalExcel?.addEventListener("click", cerrarModalExcel);
        btnCancelarExcel?.addEventListener("click", cerrarModalExcel);

        impTipoDoc?.addEventListener("change", () => {
            const esFactura = impTipoDoc.value === "factura";
            document.querySelectorAll(".imp-fiscal").forEach((el) => {
                el.style.display = esFactura ? "flex" : "none";
            });
        });

        btnDescargarPlantilla?.addEventListener("click", async () => {
            try {
                await descargarExcel({
                    nombreArchivo: "plantilla_importacion_inventario",
                    hojas: [
                        {
                            nombre: "Productos",
                            filas: [
                                {
                                    codigo: "PROD-001",
                                    nombre: "PRODUCTO EJEMPLO GRAVADO",
                                    cantidad: 10,
                                    unidad_medida: "UNIDAD",
                                    costo_usd: 5.0,
                                    precio_divisas_usd: 8.0,
                                    precio_bcv_usd: 8.5,
                                    exento_iva: "NO",
                                },
                                {
                                    codigo: "PROD-002",
                                    nombre: "PRODUCTO EJEMPLO EXENTO",
                                    cantidad: 20,
                                    unidad_medida: "KG",
                                    costo_usd: 2.0,
                                    precio_divisas_usd: 3.5,
                                    precio_bcv_usd: 3.5,
                                    exento_iva: "SI",
                                },
                            ],
                        },
                    ],
                });
            } catch (err) {
                mostrarError(err?.message || "No se pudo descargar la plantilla");
            }
        });

        formImportarExcel?.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (!archivoExcel.files || archivoExcel.files.length === 0) {
                mostrarError("Selecciona un archivo Excel (.xlsx o .xls)");
                return;
            }

            const proveedor = document.getElementById("impProveedor").value.trim();
            if (!proveedor) {
                mostrarError("Ingresa el nombre del proveedor");
                return;
            }

            const tipoDoc = impTipoDoc.value;
            const nroFactura = document.getElementById("impNroFactura").value.trim();
            if (tipoDoc === "factura" && !nroFactura) {
                mostrarError("Ingresa el N° de Factura del proveedor");
                return;
            }

            const formData = new FormData();
            formData.append("archivo", archivoExcel.files[0]);
            formData.append("tipo_documento", tipoDoc);
            formData.append("proveedor", proveedor);
            formData.append("proveedor_rif", document.getElementById("impRif").value.trim());
            formData.append("nro_factura", nroFactura);
            formData.append("nro_control", document.getElementById("impNroControl").value.trim());
            formData.append("retencion_iva_porcentaje", document.getElementById("impRetencion").value || "0");

            btnConfirmarExcel.disabled = true;
            btnConfirmarExcel.textContent = "Importando...";
            try {
                const res = await fetch("/api/compras/excel", {
                    method: "POST",
                    body: formData,
                });
                const data = await res.json();
                if (res.ok) {
                    cerrarModalExcel();
                    mostrarMensaje(data.message || "Importación completada con éxito");
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    mostrarError(data.error || "Error al importar el archivo Excel");
                }
            } catch {
                mostrarError("Error de red al importar");
            } finally {
                btnConfirmarExcel.disabled = false;
                btnConfirmarExcel.textContent = "Importar Inventario";
            }
        });

        const btnExportarExcel = document.getElementById("btnExportarExcel");
        btnExportarExcel?.addEventListener("click", async () => {
            if (!comprasCargadas.length) {
                mostrarError("No hay compras para exportar");
                return;
            }
            btnExportarExcel.textContent = "Exportando...";
            try {
                await descargarExcel({
                    nombreArchivo: `compras_fiscales_${new Date().toISOString().split("T")[0]}`,
                    hojas: [
                        {
                            nombre: "Libro de Compras",
                            filas: comprasCargadas.map((c) => {
                                const esNota = c.tipo_documento === "nota_entrega";
                                const tBcv = Number(c.tasa_bcv) || 0;
                                const tasasC = { ...tasasActuales, bs: tBcv > 0 ? tBcv : tasasActuales.bs };
                                const total = Number(c.monto_total) || 0;
                                const totalUsd = convertirAMonedaBase(total, monedaBase, "USD", tasasC);
                                const totalBs = convertirAMonedaBase(total, monedaBase, "BS", tasasC);
                                return {
                                    Fecha: c.fecha,
                                    Tipo_Documento: esNota ? "NOTA ENTREGA" : "FACTURA FISCAL",
                                    Nro_Factura: c.nro_factura || "",
                                    Nro_Control: c.nro_control || "",
                                    Proveedor: String(c.proveedor || "").toUpperCase(),
                                    RIF: c.proveedor_rif || "",
                                    Tasa_BCV: tBcv,
                                    Base_Imponible: Number((Number(c.subtotal_base) || 0).toFixed(2)),
                                    Exento: Number((Number(c.subtotal_exento) || 0).toFixed(2)),
                                    IVA_Credito: Number((Number(c.iva_monto) || 0).toFixed(2)),
                                    Retencion_IVA: Number((Number(c.retencion_iva_monto) || 0).toFixed(2)),
                                    Total_Principal: Number(total.toFixed(2)),
                                    Moneda: monedaBase,
                                    Ref_USD: Number(totalUsd.toFixed(2)),
                                    Ref_Bs: Number(totalBs.toFixed(2)),
                                };
                            }),
                        },
                    ],
                });
            } catch (err) {
                mostrarError(err?.message || "No se pudo exportar a Excel");
            } finally {
                btnExportarExcel.textContent = "Exportar a Excel";
            }
        });
    });
</script>
