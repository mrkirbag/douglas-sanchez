        box-shadow: 0 0 0 3px rgba(0, 42, 73, 0.12);
    }

    .password-container {
        display: flex;
        align-items: stretch;
        gap: 0.5rem;
    }

    .password-container input {
        flex: 1;
        min-width: 0;
    }

    .btn-toggle-password {
        flex-shrink: 0;
        padding: 0 0.85rem;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--primary-color);
        background: var(--gray-light);
        border: 1px solid var(--gray-border);
        border-radius: var(--radius-sm);
        cursor: pointer;
        transition: background var(--transition), color var(--transition), border-color var(--transition);
        font-family: 'Roboto', sans-serif;
        white-space: nowrap;
    }

    .btn-toggle-password:hover {
        background: var(--primary-color);
        color: #fff;
        border-color: var(--primary-color);
    }

    .btn-submit {
        width: 100%;
        background-color: var(--primary-color);
        color: #fff;
        border-radius: var(--radius-sm);
        padding: 0.65rem 1rem;
        text-align: center;
        font-size: 0.95rem;
        font-weight: 600;
        border: none;
        outline: none;
        cursor: pointer;
        transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
        font-family: 'Roboto', sans-serif;
        margin-top: 0.25rem;
        box-shadow: var(--shadow-sm);
    }

    .btn-submit:hover {
        background: var(--secondary-color);
        box-shadow: var(--shadow-md);
    }

    .btn-submit:active {
        transform: translateY(0);
    }

    .modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: clamp(200px, 80vw, 400px); 
        max-height: 80vh;
        background: #FFF;
        color: #000;
        font-size: 1.2rem;
        font-family: "Roboto", sans-serif; 
        padding: 1.5rem;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2); 
        display: flex;
        flex-direction: column; 
        align-items: center;
        justify-content: center;
        text-align: center;
        z-index: 1000;
        transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
    }

    .overlay {
        position: fixed;
        top: 0; 
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);
        z-index: 999;
        transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
    }

    .visible {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .oculto {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }

    .mensaje-exito {
        border: 6px solid var(--success-color);
    }

    .mensaje-error {
        border: 6px solid var(--danger-color);
    }

    @media (max-width: 480px) {
        body {
            padding: 0.5rem;
        }

        .login-section {
            padding: 1.25rem 1rem;
            max-height: calc(100dvh - 1rem);
        }

        .login-logo {
            width: min(120px, 45vw);
            max-height: 18dvh;
        }

        .login-section h1 {
            font-size: 1.25rem;
        }

        .login-header {
            margin-bottom: 1rem;
        }

