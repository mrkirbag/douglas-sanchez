        position: relative;
        z-index: 1;
        background: #fff;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-md);
        border: 1px solid var(--gray-border);
        padding: 1.75rem 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        min-width: 0;
        max-width: 420px;
        max-height: calc(100dvh - 1.5rem);
        width: 100%;
        flex-shrink: 1;
    }

    .login-header {
        text-align: center;
        margin-bottom: 1.25rem;
        flex-shrink: 0;
    }

    .login-logo {
        width: min(140px, 50vw);
