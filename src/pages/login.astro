        flex-direction: column;
        gap: 1rem;
        flex-shrink: 1;
        min-height: 0;
    }

    .field-group {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .field-group label {
        font-size: 0.75rem;
        font-weight: 700;
