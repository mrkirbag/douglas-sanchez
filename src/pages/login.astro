            gap: 0.85rem;
        }
    }

    @media (max-height: 640px) {
        .login-logo {
            width: min(100px, 40vw);
            max-height: 14dvh;
            margin-bottom: 0.5rem;
        }

        .login-header {
            margin-bottom: 0.75rem;
        }

        .login-section {
            padding: 1rem 1.25rem;
        }

        .login-section h1 {
            font-size: 1.15rem;
        }

        .login-subtitle {
            font-size: 0.8rem;
            margin-top: 0.25rem;
        }

