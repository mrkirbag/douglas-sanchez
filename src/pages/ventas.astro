    document.getElementById('btnAbrirCaja')?.addEventListener('click', mostrarModalAperturaCaja);

    document.getElementById('btnCorteX')?.addEventListener('click', async () => {
        await cargarEstadoCaja();
        if (estadoCajaActual?.cajaAbierta && estadoCajaActual?.corteX) {
            mostrarModalReporteFiscal(estadoCajaActual.cajaAbierta, estadoCajaActual.corteX, false);
        }
    });

    document.getElementById('btnCerrarCaja')?.addEventListener('click', async () => {
        const ok = await confirmarAccion(
            '¿Deseas cerrar la caja del turno actual y emitir el Reporte Diario Z correlativo? Una vez cerrada, deberás abrir un nuevo turno para facturar.',
            {
                titulo: 'Cierre de Caja y Emisión de Reporte Z',
                textoAceptar: 'Cerrar Caja y Emitir Z',
            }
        );
        if (!ok) return;

        try {
            const res = await fetch('/api/caja', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ accion: 'cerrar' }),
            });
            const data = await res.json();
            if (!res.ok) {
                mostrarError(data.error || 'No se pudo cerrar la caja');
                return;
            }
            mostrarMensaje(data.message || 'Caja cerrada y Reporte Z generado');
            await cargarEstadoCaja();
            mostrarModalReporteFiscal(data.caja, data.metricas, true);
        } catch (err) {
            mostrarError('Error de conexión al cerrar la caja');
        }
    });

    document.getElementById('btnHistorialZ')?.addEventListener('click', mostrarModalHistorialZ);

    document.getElementById('btnNuevaVenta')?.addEventListener('click', (e) => {
        if (estadoCajaActual && !estadoCajaActual.abierta) {
            e.preventDefault();
            mostrarError('Debes abrir la caja antes de registrar una venta.');
            mostrarModalAperturaCaja();
