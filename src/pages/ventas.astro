    interface Venta {
        id: number;
        tipo_documento?: string;
        nro_factura?: number;
        nro_nota_entrega?: number;
        fecha: string;
        cliente_id: number;
        cliente: string;
        cedula_cliente: string;
        subtotal_base?: number;
        subtotal_exento?: number;
        iva_porcentaje?: number;
        iva_monto?: number;
        retencion_iva_monto?: number;
        total_divisas?: number;
        tasa_bcv?: number;
        tasa_cop?: number;
        total: number;
        tipo_pago: string;
        estado: string;
        facturada_en_venta_id?: string | null;
        nota_entrega_origen_id?: string | null;
        ganancia_aproximada?: number;
    }

    function obtenerClaseEstado(estado: string) {
        const normalizado = estado.toLowerCase();
        if (normalizado.includes('anul')) return 'status-badge--anulada';
        if (normalizado.includes('devuel')) return 'status-badge--devuelta';
        return 'status-badge--activa';
    }

    function actualizarResumen(cantidad: number, fecha: string) {
        const resumen = document.getElementById('resumenVentas') as HTMLParagraphElement;
        if (!resumen) return;

        if (cantidad === 0) {
            resumen.textContent = `No hay documentos registrados para el ${fecha}.`;
            return;
        }

        const texto = cantidad === 1 ? '1 documento registrado' : `${cantidad} documentos registrados`;
        resumen.textContent = `${texto} para el ${fecha}.`;
    }

    document.addEventListener('DOMContentLoaded', () => {
        cargarEstadoCaja();
        const inputBusqueda = document.getElementById("inputBusqueda") as HTMLInputElement;
        inputBusqueda.dispatchEvent(new Event('input'));
    });

    let ventasDelDiaActuales: Venta[] = [];
    let tasasDelDiaActuales: { cop: number; bs: number } = { cop: 0, bs: 0 };

    const inputBusqueda = document.getElementById("inputBusqueda") as HTMLInputElement;
    inputBusqueda.addEventListener('input', async () => {
        const tablaVentasHead = document.getElementById('tablaVentasHead') as HTMLTableSectionElement;
        const tbody = document.getElementById('listaVentas') as HTMLTableSectionElement;

        tbody.innerHTML = "";
        const fechaFormateadaResumen = formatearFecha(inputBusqueda.value);

        try {
            const res = await fetch(`/api/ventas?fecha=${inputBusqueda.value}`);
            const ventas : Venta[] = await res.json();

            if (res.status === 202) {
                const imprimirContainer = document.getElementById('imprimirContainer') as HTMLDivElement;
                const excelVentasContainer = document.getElementById('excelVentasContainer') as HTMLDivElement;
                imprimirContainer.style.display = 'none';
                if (excelVentasContainer) excelVentasContainer.style.display = 'none';
                tablaVentasHead.style.display = 'none';
                actualizarResumen(0, fechaFormateadaResumen);
                noRegistros("No hay ventas registradas para esa fecha");
                return;
            } else {
                tbody.innerHTML = "";
                noRegistros("");
            }

            tablaVentasHead.style.display = 'table-header-group';
            const imprimirContainer = document.getElementById('imprimirContainer') as HTMLDivElement;
            const excelVentasContainer = document.getElementById('excelVentasContainer') as HTMLDivElement;
            imprimirContainer.style.display = 'inline-flex';
            if (excelVentasContainer) excelVentasContainer.style.display = 'inline-flex';
            actualizarResumen(ventas.length, fechaFormateadaResumen);

            const tasas = await obtenerTasas();
            ventasDelDiaActuales = Array.isArray(ventas) ? ventas : [];
            tasasDelDiaActuales = tasas;

            ventas.forEach(venta => {
                const esNotaEntrega = venta.tipo_documento === 'nota_entrega';
                const fechaFormateada = formatearFecha(venta.fecha);
                const tasaCop = Number(venta.tasa_cop) > 0 ? Number(venta.tasa_cop) : tasas.cop;
                const tasaBcv = Number(venta.tasa_bcv) > 0 ? Number(venta.tasa_bcv) : tasas.bs;

                const totalUsd = Number(venta.total) || 0;
                const totalBs = redondearBS(totalUsd * tasaBcv);

                const baseUsd = (Number(venta.subtotal_base) || 0) + (Number(venta.subtotal_exento) || 0) || totalUsd;
                const baseBs = redondearBS(baseUsd * tasaBcv);
                const ivaUsd = Number(venta.iva_monto) || 0;
                const ivaBs = redondearBS(ivaUsd * tasaBcv);

                const refDivisasUsd = Number(venta.total_divisas) > 0 ? Number(venta.total_divisas) : totalUsd;
                const totalCOP = redondearCOP(refDivisasUsd * tasaCop);
                const gananciaUsd = Number(venta.ganancia_aproximada) || 0;
                const gananciaBs = redondearBS(gananciaUsd * tasaBcv);
                const gananciaCop = Math.round(gananciaUsd * tasaCop);
                const gananciaColor = gananciaUsd < 0 ? '#b91c1c' : '#047857';

                const estadoClase = obtenerClaseEstado(venta.estado);

                const badgeTipoDoc = esNotaEntrega
                    ? `<span style="display:inline-block; font-size:0.65rem; padding:2px 7px; border-radius:99px; background:rgba(16,185,129,0.14); color:#047857; font-weight:800;">NOTA DE ENTREGA</span>`
                    : `<span style="display:inline-block; font-size:0.65rem; padding:2px 7px; border-radius:99px; background:rgba(37,99,235,0.14); color:#1d4ed8; font-weight:800;">FACTURA FISCAL (BS)</span>`;

                const badgeEstadoNota = esNotaEntrega
                    ? (venta.facturada_en_venta_id
                        ? `<a href="/ventas/${venta.facturada_en_venta_id}" style="display:inline-block; margin-top:2px; font-size:0.62rem; padding:2px 6px; border-radius:99px; background:rgba(37,99,235,0.12); color:#1d4ed8; font-weight:800; text-decoration:none;">FACTURADA ↗</a>`
                        : (venta.estado.toLowerCase() !== 'devuelto'
                            ? `<span style="display:inline-block; margin-top:2px; font-size:0.62rem; padding:2px 6px; border-radius:99px; background:rgba(217,119,6,0.14); color:#b45309; font-weight:800;">PENDIENTE FACTURAR</span>`
                            : ''))
                    : (venta.nota_entrega_origen_id
                        ? `<a href="/ventas/${venta.nota_entrega_origen_id}" style="display:inline-block; margin-top:2px; font-size:0.62rem; padding:2px 6px; border-radius:99px; background:rgba(16,185,129,0.12); color:#047857; font-weight:700; text-decoration:none;">DE NOTA ENTREGA ↗</a>`
                        : '');

                const nroDocTexto = esNotaEntrega
                    ? `${badgeTipoDoc}${badgeEstadoNota ? `<br/>${badgeEstadoNota}` : ''}<br/><strong>NE-${String(venta.nro_nota_entrega || 1).padStart(6, '0')}</strong><br/><span class="monto-cop">${fechaFormateada}</span>`
                    : `${badgeTipoDoc}${badgeEstadoNota ? `<br/>${badgeEstadoNota}` : ''}<br/><strong>#${String(venta.nro_factura || 1).padStart(6, '0')}</strong><br/><span class="monto-cop">${fechaFormateada}</span>`;

                const colImpuestoHtml = esNotaEntrega
                    ? `<span class="monto-usd" style="color:#047857;">En Divisas (Sin IVA)</span><br/><span class="monto-cop">Nota de Entrega</span>`
                    : `<span class="monto-usd">Base: ${baseBs.toFixed(4)} Bs</span><br/><span class="monto-cop">IVA: ${ivaBs.toFixed(4)} Bs ($${ivaUsd.toFixed(4)})</span>`;

                const colBsHtml = esNotaEntrega
                    ? `<span class="monto-cop">N/A (Facturado en Divisas)</span>`
                    : `<span class="monto-usd">${totalBs.toFixed(4)} Bs</span><br/><span class="monto-cop">$${totalUsd.toFixed(4)} USD (BCV)</span>`;

                const tr = document.createElement('tr');
                tr.innerHTML = `    
                    <td data-label="Documento / Fecha">${nroDocTexto}</td>
                    <td data-label="Cliente">
                        <strong>${venta.cliente.toUpperCase()}</strong><br />
                        <span class="monto-cop">C.I./RIF ${venta.cedula_cliente}</span>
                    </td>
                    <td data-label="Modalidad / Impuesto">${colImpuestoHtml}</td>
                    <td data-label="Total Factura (Bs / BCV)">${colBsHtml}</td>
                    <td data-label="Total Divisas (USD / COP)">
                        <span class="monto-usd">$${refDivisasUsd.toFixed(4)} USD</span>
                        <br />
                        <span class="monto-cop">${totalCOP.toLocaleString('es-CO')} COP</span>
                    </td>
                    <td data-label="Ganancia Aproximada">
                        <span class="monto-usd" style="color:${gananciaColor};">≈ $${gananciaUsd.toFixed(4)} USD</span>
                        <br />
                        <span class="monto-cop">${gananciaBs.toFixed(4)} Bs · ${gananciaCop.toLocaleString('es-CO')} COP</span>
                    </td>
                    <td data-label="Tipo Pago">
                        <span class="pago-badge">${venta.tipo_pago.toUpperCase()}</span>
                    </td>
                    <td data-label="Estado">
                        <span class="status-badge ${estadoClase}">${venta.estado.toUpperCase()}</span>
                    </td>
                `;

                const tdAcciones = document.createElement('td');
                tdAcciones.classList.add('acciones');

                const estadoNorm = venta.estado.toLowerCase();
                if (esNotaEntrega && !venta.facturada_en_venta_id && estadoNorm !== 'anulado' && estadoNorm !== 'devuelto') {
                    const btnFacturar = document.createElement('button');
                    btnFacturar.type = 'button';
                    btnFacturar.classList.add('btn-editar');
                    btnFacturar.style.background = '#1d4ed8';
                    btnFacturar.style.color = '#fff';
                    btnFacturar.textContent = 'FACTURAR';

                    btnFacturar.onclick = async () => {
                        const confirmado = await confirmarAccion(
                            `¿Deseas emitir una Factura Fiscal (en Bs a tasa BCV + IVA) a partir de la Nota de Entrega NE-${String(venta.nro_nota_entrega || 1).padStart(6, '0')}? No volverá a descontar inventario ni duplicará el cobro en caja.`,
                            {
                                titulo: 'Convertir Nota de Entrega a Factura Fiscal',
                                textoAceptar: 'Sí, Emitir Factura',
                            }
                        );
                        if (!confirmado) return;

                        btnFacturar.disabled = true;
                        try {
                            const resp = await fetch('/api/ventas/facturar-nota', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ notaEntregaId: venta.id }),
                            });
                            const data = await resp.json();
                            if (!resp.ok) {
                                mostrarError(data.error || 'No se pudo facturar la nota de entrega');
                                btnFacturar.disabled = false;
                                return;
                            }
                            mostrarMensaje(data.message || 'Factura generada exitosamente');
                            cargarEstadoCaja();
                            inputBusqueda.dispatchEvent(new Event('input'));
                        } catch {
                            mostrarError('Error de conexión al facturar la nota de entrega');
                            btnFacturar.disabled = false;
                        }
                    };
                    tdAcciones.appendChild(btnFacturar);
                }

                if (esAdmin && estadoNorm !== 'anulado' && estadoNorm !== 'devuelto') {
                    const btnDevolver = document.createElement('button');
                    btnDevolver.type = 'button';
                    btnDevolver.classList.add('btn-eliminar');
                    btnDevolver.textContent = 'NOTA CRÉDITO / DEVOLVER';

                    btnDevolver.onclick = () => {
                        (window as any).abrirModalDevolucion(venta.id, venta.cliente_id);
                    };
                    tdAcciones.appendChild(btnDevolver);
                }

                const btnVerInfo = document.createElement('button');
                btnVerInfo.type = 'button';
                btnVerInfo.classList.add('btn-editar');
                btnVerInfo.textContent = esNotaEntrega ? 'VER NOTA' : 'VER FACTURA';

                btnVerInfo.onclick = () => {
                    window.location.href = `/ventas/${venta.id}`;
                };

                tdAcciones.appendChild(btnVerInfo);

                tr.appendChild(tdAcciones);
                tbody.appendChild(tr);
            });
        } catch (err) {
            console.error('Error al cargar ventas:', err);
        }
    });

    const btnImprimir = document.querySelector('#imprimir') as HTMLAnchorElement;

    btnImprimir.addEventListener('click', () => {
        const tabla = document.getElementById('tabla');
        if (!tabla) return;

        const tablaClon : any = tabla.cloneNode(true);

        for (const fila of tablaClon.rows) {
            if (fila.cells.length > 0) {
                fila.deleteCell(fila.cells.length - 1);
            }
        }

        imprimir({
            titulo: 'Impresión de ventas',
            tituloDocumento: 'RELACIÓN DE FACTURAS DEL DÍA',
            contenido: tablaClon.outerHTML,
        });
    });

    document.getElementById('btnExportarExcelVentas')?.addEventListener('click', async () => {
        if (!ventasDelDiaActuales.length) {
            mostrarError('No hay ventas en la fecha seleccionada para exportar');
            return;
        }

        const fechaSel = inputBusqueda.value || 'ventas';
        const filasFacturas = ventasDelDiaActuales
            .filter((v) => v.tipo_documento !== 'nota_entrega')
            .map((v) => {
                const tBcv = Number(v.tasa_bcv) > 0 ? Number(v.tasa_bcv) : tasasDelDiaActuales.bs;
                const baseUsd = Number(v.subtotal_base) || 0;
                const exentoUsd = Number(v.subtotal_exento) || 0;
                const ivaUsd = Number(v.iva_monto) || 0;
                const retUsd = Number(v.retencion_iva_monto) || 0;
                const totUsd = Number(v.total) || 0;
                return {
                    Fecha: v.fecha,
                    Nro_Factura: v.nro_factura || '',
                    Cliente: String(v.cliente || '').toUpperCase(),
                    Cedula_RIF: v.cedula_cliente || '',
                    Tasa_BCV: tBcv,
                    Base_Imponible_Bs: Number((baseUsd * tBcv).toFixed(4)),
                    Exento_Bs: Number((exentoUsd * tBcv).toFixed(4)),
                    IVA_Bs: Number((ivaUsd * tBcv).toFixed(4)),
                    Retencion_IVA_Bs: Number((retUsd * tBcv).toFixed(4)),
                    Total_Bs: Number((totUsd * tBcv).toFixed(4)),
                    Equiv_BCV_USD: Number(totUsd.toFixed(4)),
                    Tipo_Pago: String(v.tipo_pago || '').toUpperCase(),
                    Estado: String(v.estado || '').toUpperCase(),
                };
            });

        const filasNotas = ventasDelDiaActuales
            .filter((v) => v.tipo_documento === 'nota_entrega')
            .map((v) => {
                const totUsd = Number(v.total_divisas) > 0 ? Number(v.total_divisas) : Number(v.total) || 0;
                const tCop = Number(v.tasa_cop) > 0 ? Number(v.tasa_cop) : tasasDelDiaActuales.cop;
                return {
                    Fecha: v.fecha,
                    Nro_Nota_Entrega: v.nro_nota_entrega ? `NE-${String(v.nro_nota_entrega).padStart(6, '0')}` : '',
                    Cliente: String(v.cliente || '').toUpperCase(),
                    Cedula_RIF: v.cedula_cliente || '',
                    Total_USD: Number(totUsd.toFixed(4)),
                    Total_COP: Math.ceil(totUsd * tCop),
                    Facturada: v.facturada_en_venta_id ? 'SI' : 'NO',
                    Tipo_Pago: String(v.tipo_pago || '').toUpperCase(),
                    Estado: String(v.estado || '').toUpperCase(),
                };
            });

        try {
            await descargarExcel({
                nombreArchivo: `ventas_${fechaSel}`,
                hojas: [
                    ...(filasFacturas.length > 0 ? [{ nombre: 'Facturas Fiscales BCV', filas: filasFacturas }] : []),
                    ...(filasNotas.length > 0 ? [{ nombre: 'Notas Entrega Divisas', filas: filasNotas }] : []),
                ],
            });
        } catch (err: any) {
            mostrarError(err?.message || 'Error al exportar ventas a Excel');
        }
    });
</script>
