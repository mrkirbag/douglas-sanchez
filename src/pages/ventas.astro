---
import Layout from '../layouts/Layout.astro';
import ModalDevolucion from '../components/ModalDevolucion.astro';
import empresa from '../data/empresa.json';
import { verificarToken } from '@/utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}

const esAdmin = usuario.rol === 'admin';

const fechaActual = new Date().toLocaleDateString("es-VE", {
    timeZone: "America/Caracas",
    year: "numeric",
    month: "2-digit",
    day: "2-digit"
}).split('/').reverse().join('-');
---

<Layout>
    <header class="page-header">
        <p class="eyebrow">Gestión comercial y fiscal</p>
        <h1>Ventas y Caja Fiscal</h1>
        <p class="page-intro">Gestiona la apertura y cierre de caja con emisión de Reporte Diario Z, consulta la facturación legal con Base Imponible BCV + IVA y referencia en Divisas/COP.</p>
    </header>

    <!-- Panel de Control de Caja Fiscal -->
    <section class="caja-banner" id="cajaBanner" data-empresa-nombre={empresa.nombre} data-empresa-rif={empresa.rif} data-empresa-dir={empresa.direccion}>
        <div class="caja-banner__status">
            <span class="caja-indicator" id="cajaIndicator"></span>
            <div>
                <p class="caja-eyebrow" id="cajaEstadoLabel">Verificando estado de caja...</p>
                <h2 class="caja-title" id="cajaTitulo">Cargando turno...</h2>
                <p class="caja-meta" id="cajaMeta">Consultando información de apertura y facturación del turno.</p>
            </div>
        </div>

        <div class="caja-banner__metrics" id="cajaMetricas" hidden>
            <div class="caja-metric">
                <span>Facturas turno</span>
                <strong id="cajaFacturasCount">0</strong>
            </div>
            <div class="caja-metric">
                <span>Base Imponible (Bs)</span>
                <strong id="cajaBaseBs">0.00 Bs</strong>
            </div>
            <div class="caja-metric">
                <span>IVA Fiscal (Bs)</span>
                <strong id="cajaIvaBs">0.00 Bs</strong>
            </div>
            <div class="caja-metric caja-metric--highlight">
                <span>Total Facturado (Bs / BCV)</span>
                <strong id="cajaTotalBs">0.00 Bs</strong>
                <small id="cajaTotalUsd">$0.00 USD</small>
            </div>
        </div>

        <div class="caja-banner__actions">
            <button type="button" class="btn-caja btn-caja--open" id="btnAbrirCaja" hidden>
                Abrir Caja
            </button>
            <button type="button" class="btn-caja btn-caja--x" id="btnCorteX" hidden>
                Ver Corte X
            </button>
            <button type="button" class="btn-caja btn-caja--close" id="btnCerrarCaja" hidden>
                Cerrar Caja (Reporte Z)
            </button>
            <button type="button" class="btn-caja btn-caja--history" id="btnHistorialZ">
                Reportes Z
            </button>
        </div>
    </section>

    <div class="page-toolbar ventas-toolbar">
        <div class="toolbar-actions">
            <div class="btn-add_container">
                <a class="btn-add" href="/ventas/agregarVentas" id="btnNuevaVenta">Agregar venta / Facturar</a>
            </div>

            <div class="btn-add_container imprimir-container" id="imprimirContainer" style="display: none;">
                <a class="btn-add" id="imprimir">Imprimir relación del día</a>
            </div>

            <div class="btn-add_container" id="excelVentasContainer" style="display: none; background: linear-gradient(135deg, #15803d, #166534);">
                <a class="btn-add" id="btnExportarExcelVentas">Exportar a Excel</a>
            </div>
        </div>

        <div class="filtro-fecha">
            <label class="filtro-fecha_label" for="inputBusqueda">Fecha de consulta</label>
            <div class="input-busqueda_container fecha-filtro">
                <input type="date" id="inputBusqueda" value={fechaActual} />
            </div>
        </div>
    </div>

    <section class="ventas-summary-card" data-es-admin={esAdmin} aria-live="polite">
        <div class="summary-icon" aria-hidden="true">$</div>
        <div>
            <p class="summary-eyebrow">Facturación Fiscal (Bs) y Notas de Entrega (Divisas)</p>
            <p class="summary-text" id="resumenVentas">Selecciona una fecha para ver los documentos registrados.</p>
            <p style="margin: 0.25rem 0 0; font-size: 0.78rem; color: #1e40af; font-weight: 600;">
                🔒 Normativa SENIAT: Las facturas están numeradas correlativamente y no pueden ser canceladas ni eliminadas (solo admiten Nota de Crédito / Devolución).
            </p>
        </div>
    </section>

    <div class="table-wrap">
        <table id="tabla">
            <thead id="tablaVentasHead" style="display: none;">
                <tr>
                    <th>Documento / Fecha</th>
                    <th>Cliente</th>
                    <th>Modalidad / Impuesto</th>
                    <th>Total Factura (Bs / BCV)</th>
                    <th>Total Divisas (USD / COP)</th>
                    <th>Ganancia Aproximada</th>
                    <th>Tipo pago</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="listaVentas">
            </tbody>
        </table>
    </div>

    <div id="mensaje"></div>
    <div id="overlay" class="overlay oculto"> 
        <div id="modal" class="modal"></div>
    </div>

    <!-- Modal de Caja / Reporte Z -->
    <div id="overlayCaja" class="overlay oculto">
        <div id="modalCaja" class="modal modal-caja"></div>
    </div>

    <ModalDevolucion />
</Layout>

<style>
    .caja-banner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.15rem;
        padding: 1.25rem 1.4rem;
        margin-bottom: 1.2rem;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(var(--secondary-rgb), 0.12);
        box-shadow: 0 18px 32px rgba(var(--primary-rgb), 0.08);
    }

    .caja-banner.is-open {
        border-left: 6px solid #16a34a;
    }

    .caja-banner.is-closed {
        border-left: 6px solid #dc2626;
    }

    .caja-banner__status {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: 1 1 280px;
    }

    .caja-indicator {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #94a3b8;
        flex-shrink: 0;
    }

    .caja-banner.is-open .caja-indicator {
        background: #16a34a;
        box-shadow: 0 0 0 6px rgba(22, 163, 74, 0.16);
    }

    .caja-banner.is-closed .caja-indicator {
        background: #dc2626;
        box-shadow: 0 0 0 6px rgba(220, 38, 38, 0.16);
    }

    .caja-eyebrow {
        margin: 0;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--secondary-color);
    }

    .caja-title {
        margin: 0.15rem 0;
        font-size: 1.2rem;
        color: var(--primary-strong);
    }

    .caja-meta {
        margin: 0;
        font-size: 0.84rem;
        color: var(--text-muted);
    }

    .caja-banner__metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        flex: 2 1 380px;
        justify-content: center;
    }

    .caja-banner__metrics[hidden],
    .btn-caja[hidden] {
        display: none !important;
    }

    .caja-metric {
        padding: 0.65rem 0.95rem;
        border-radius: 14px;
        background: rgba(var(--secondary-rgb), 0.05);
        border: 1px solid rgba(var(--secondary-rgb), 0.1);
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        min-width: 130px;
    }

    .caja-metric span {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    .caja-metric strong {
        font-size: 1rem;
        color: var(--primary-strong);
    }

    .caja-metric small {
        font-size: 0.74rem;
        color: var(--secondary-color);
        font-weight: 600;
    }

    .caja-metric--highlight {
        background: linear-gradient(135deg, rgba(var(--primary-rgb), 0.1), rgba(var(--secondary-rgb), 0.15));
        border-color: rgba(var(--primary-rgb), 0.25);
    }

    .caja-banner__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    .btn-caja,
    .modal-caja :global(.btn-caja) {
        appearance: none;
        border: none;
        border-radius: 14px;
        padding: 0.68rem 1.15rem;
        font-size: 0.84rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        line-height: 1.2;
        transition: transform 150ms ease, box-shadow 150ms ease, background 150ms ease, border-color 150ms ease;
    }

    .btn-caja:hover,
    .modal-caja :global(.btn-caja:hover) {
        transform: translateY(-1px);
    }

    .btn-caja--open,
    .modal-caja :global(.btn-caja--open) {
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: #fff;
        box-shadow: 0 8px 20px rgba(22, 163, 74, 0.25);
    }

    .btn-caja--x,
    .modal-caja :global(.btn-caja--x) {
        background: rgba(var(--secondary-rgb), 0.1);
        color: var(--primary-strong);
        border: 1px solid rgba(var(--secondary-rgb), 0.22);
    }

    .btn-caja--x:hover,
    .modal-caja :global(.btn-caja--x:hover) {
        background: rgba(var(--secondary-rgb), 0.18);
        border-color: rgba(var(--secondary-rgb), 0.35);
    }

    .btn-caja--close,
    .modal-caja :global(.btn-caja--close) {
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        color: #fff;
        box-shadow: 0 8px 20px rgba(220, 38, 38, 0.25);
    }

    .btn-caja--history,
    .modal-caja :global(.btn-caja--history) {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: #fff;
        box-shadow: 0 8px 20px rgba(var(--primary-rgb), 0.22);
    }

    .btn-caja--history:hover,
    .modal-caja :global(.btn-caja--history:hover) {
        box-shadow: 0 10px 24px rgba(var(--primary-rgb), 0.3);
    }

    .modal-caja {
        width: min(100%, 720px);
        max-height: 90vh;
        overflow-y: auto;
        text-align: left;
        padding: 1.6rem;
    }

    .modal-caja :global(.modal-caja__actions) {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(var(--secondary-rgb), 0.14);
    }

    .modal-caja :global(.modal-caja__close) {
        background: rgba(var(--secondary-rgb), 0.08);
        border: 1px solid rgba(var(--secondary-rgb), 0.16);
        color: var(--primary-strong);
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        line-height: 1;
        cursor: pointer;
        transition: background 150ms ease, transform 150ms ease;
    }

    .modal-caja :global(.modal-caja__close:hover) {
        background: rgba(var(--secondary-rgb), 0.16);
        transform: translateY(-1px);
    }

    .modal-caja :global(.btn-ver-z) {
        padding: 0.5rem 0.9rem;
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.03em;
        border-radius: 10px;
        white-space: nowrap;
    }

    @media (max-width: 540px) {
        .modal-caja :global(.modal-caja__actions) {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .modal-caja :global(.modal-caja__actions .btn-caja) {
            width: 100%;
        }
    }

    .filtro-fecha {
        display: grid;
        gap: 0.35rem;
        flex: 0 0 auto;
        min-width: min(100%, 220px);
        justify-items: end;
        margin-left: auto;
        align-self: center;
    }

    .filtro-fecha_label {
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--secondary-color);
    }

    .fecha-filtro {
        margin: 0;
        padding: 0;
        justify-content: flex-end;
        height: auto;
        min-height: 0;
        align-items: stretch;
    }

    .fecha-filtro input {
        max-width: 220px;
        margin: 0;
    }

    .imprimir-container {
        min-width: 0;
    }

    .ventas-summary-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.15rem;
        border-radius: var(--radius-lg);
        background: linear-gradient(135deg, rgba(var(--secondary-rgb), 0.06), rgba(217, 209, 236, 0.42));
        border: 1px solid rgba(var(--secondary-rgb), 0.1);
        box-shadow: var(--shadow-card);
    }

    .summary-icon {
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: #fff;
        font-family: "Archivo Black", sans-serif;
        font-size: 1.35rem;
        flex-shrink: 0;
        box-shadow: 0 10px 22px rgba(var(--primary-rgb), 0.2);
    }

    .summary-eyebrow {
        margin: 0 0 0.2rem;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--secondary-color);
    }

    .summary-text {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--primary-strong);
        line-height: 1.5;
    }

    :global(.status-badge) {
        display: inline-flex;
        align-items: center;
        padding: 0.32rem 0.7rem;
        border-radius: 999px;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border: 1px solid transparent;
    }

    :global(.status-badge--activa) {
        background: rgba(0, 128, 0, 0.12);
        color: #0b5f2b;
        border-color: rgba(0, 128, 0, 0.2);
    }

    :global(.status-badge--anulada) {
        background: rgba(255, 77, 77, 0.12);
        color: #9f1f1f;
        border-color: rgba(255, 77, 77, 0.22);
    }

    :global(.status-badge--devuelta) {
        background: rgba(234, 179, 8, 0.12);
        color: #854d0e;
        border-color: rgba(234, 179, 8, 0.22);
    }

    :global(.pago-badge) {
        display: inline-flex;
        align-items: center;
        padding: 0.32rem 0.7rem;
        border-radius: 999px;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        background: rgba(var(--secondary-rgb), 0.08);
        color: var(--primary-strong);
        border: 1px solid rgba(var(--secondary-rgb), 0.12);
    }

    :global(.monto-usd) {
        font-weight: 700;
        color: var(--primary-strong);
    }

    :global(.monto-cop) {
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    @media (max-width: 768px) {
        .ventas-toolbar .filtro-fecha {
            order: -1;
            width: 100%;
            margin-left: 0;
            justify-items: stretch;
        }

        .ventas-toolbar .fecha-filtro input {
            width: 100%;
            max-width: none;
        }
    }
</style>

<script>
    import { noRegistros, mostrarError, mostrarMensaje, confirmarAccion } from "@/utils/helpers/mensajes.js";
    import { obtenerTasas } from "@/utils/helpers/cambioMoneda.js";
    import { formatearFecha } from "@/utils/helpers/formateoFecha.js";
    import { imprimir } from '@/utils/helpers/imprimir.js';
    import { redondearCOP, redondearBS, formatearMoneda } from '@/utils/helpers/tasas.js';
    import { descargarExcel } from '@/utils/helpers/exportarExcel.js';

    const esAdmin = document.querySelector('.ventas-summary-card')?.getAttribute('data-es-admin') === 'true';
    const cajaBanner = document.getElementById('cajaBanner') as HTMLElement;
    const empresaNombre = cajaBanner?.dataset.empresaNombre || 'EMPRESA';
    const empresaRif = cajaBanner?.dataset.empresaRif || '';
    const empresaDir = cajaBanner?.dataset.empresaDir || '';

    const overlayCaja = document.getElementById('overlayCaja') as HTMLDivElement;
    const modalCaja = document.getElementById('modalCaja') as HTMLDivElement;

    let estadoCajaActual: any = null;

    function cerrarModalCaja() {
        overlayCaja.classList.add('oculto');
        modalCaja.innerHTML = '';
    }

    overlayCaja?.addEventListener('click', (e) => {
        if (e.target === overlayCaja) cerrarModalCaja();
    });

    async function cargarEstadoCaja() {
        try {
            const res = await fetch('/api/caja');
            if (!res.ok) return;
            const data = await res.json();
            estadoCajaActual = data;

            const estadoLabel = document.getElementById('cajaEstadoLabel') as HTMLElement;
            const titulo = document.getElementById('cajaTitulo') as HTMLElement;
            const meta = document.getElementById('cajaMeta') as HTMLElement;
            const metricasBox = document.getElementById('cajaMetricas') as HTMLElement;
            const btnAbrir = document.getElementById('btnAbrirCaja') as HTMLButtonElement;
            const btnCorteX = document.getElementById('btnCorteX') as HTMLButtonElement;
            const btnCerrar = document.getElementById('btnCerrarCaja') as HTMLButtonElement;

            cajaBanner.classList.toggle('is-open', Boolean(data.abierta));
            cajaBanner.classList.toggle('is-closed', !data.abierta);

            if (data.abierta && data.cajaAbierta) {
                const c = data.cajaAbierta;
                const x = data.corteX || {};
                estadoLabel.textContent = 'Turno Fiscal Activo';
                titulo.textContent = `Caja Abierta (${formatearFecha(c.fecha_apertura)} · ${c.hora_apertura})`;
                meta.textContent = `Responsable: ${c.usuario_apertura_nombre} · Fondo Inicial: $${Number(c.monto_apertura_usd || 0).toFixed(4)} USD / ${Number(c.monto_apertura_bs || 0).toFixed(4)} Bs`;

                metricasBox.hidden = false;
                (document.getElementById('cajaFacturasCount') as HTMLElement).textContent = String(x.cantidad_facturas || 0);
                (document.getElementById('cajaBaseBs') as HTMLElement).textContent = `${Number(x.base_imponible_bs || 0).toFixed(4)} Bs`;
                (document.getElementById('cajaIvaBs') as HTMLElement).textContent = `${Number(x.iva_bs || 0).toFixed(4)} Bs`;
                (document.getElementById('cajaTotalBs') as HTMLElement).textContent = `${Number(x.total_facturado_bs || 0).toFixed(4)} Bs`;
                (document.getElementById('cajaTotalUsd') as HTMLElement).textContent = `$${Number(x.total_facturado_usd || 0).toFixed(4)} USD (BCV)`;

                btnAbrir.hidden = true;
                btnCorteX.hidden = false;
                btnCerrar.hidden = false;
            } else {
                estadoLabel.textContent = 'Sin Turno Activo';
                titulo.textContent = 'Caja Cerrada';
                meta.textContent = 'Debes realizar la Apertura de Caja antes de emitir nuevas facturas de venta.';
                metricasBox.hidden = true;
                btnAbrir.hidden = false;
                btnCorteX.hidden = true;
                btnCerrar.hidden = true;
            }
        } catch (err) {
            console.error('Error cargando caja:', err);
        }
    }

    function mostrarModalAperturaCaja() {
        modalCaja.innerHTML = `
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                <div>
                    <p style="margin:0; font-size:0.75rem; font-weight:800; text-transform:uppercase; color:var(--secondary-color);">Operación Fiscal</p>
                    <h3 style="margin:0.2rem 0 0; font-size:1.35rem;">Apertura de Caja</h3>
                </div>
                <button type="button" id="cerrarModalCajaBtn" style="background:none; border:none; font-size:1.5rem; cursor:pointer;">&times;</button>
            </div>
            <p style="font-size:0.9rem; color:var(--text-muted); margin-bottom:1rem;">
                Registra el fondo inicial disponible en caja para iniciar las operaciones de facturación del turno.
            </p>
            <form id="formAbrirCaja" style="display:grid; grid-template-columns:repeat(3, 1fr); gap:0.85rem;">
                <div class="form-field">
                    <label for="aperturaUsd">Fondo USD ($)</label>
                    <input type="text" id="aperturaUsd" value="0.00" />
                </div>
                <div class="form-field">
                    <label for="aperturaCop">Fondo COP (Pesos)</label>
                    <input type="text" id="aperturaCop" value="0" />
                </div>
                <div class="form-field">
                    <label for="aperturaBs">Fondo Bs (Bolívares)</label>
                    <input type="text" id="aperturaBs" value="0.00" />
                </div>
                <div class="form-field" style="grid-column: 1 / -1;">
                    <label for="aperturaObs">Observaciones de apertura (opcional)</label>
                    <input type="text" id="aperturaObs" placeholder="Ej. Turno mañana - Caja Principal" />
                </div>
                <div class="form-actions" style="grid-column: 1 / -1; display:flex; justify-content:flex-end; gap:0.6rem; margin-top:0.5rem;">
                    <button type="button" id="cancelarAperturaBtn" style="background:#e2e8f0; color:#0f172a;">Cancelar</button>
                    <button type="submit">Confirmar Apertura de Caja</button>
                </div>
            </form>
        `;
        overlayCaja.classList.remove('oculto');

        document.getElementById('cerrarModalCajaBtn')?.addEventListener('click', cerrarModalCaja);
        document.getElementById('cancelarAperturaBtn')?.addEventListener('click', cerrarModalCaja);

        document.getElementById('formAbrirCaja')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const monto_apertura_usd = (document.getElementById('aperturaUsd') as HTMLInputElement).value;
            const monto_apertura_cop = (document.getElementById('aperturaCop') as HTMLInputElement).value;
            const monto_apertura_bs = (document.getElementById('aperturaBs') as HTMLInputElement).value;
            const observaciones = (document.getElementById('aperturaObs') as HTMLInputElement).value;

            try {
                const res = await fetch('/api/caja', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        accion: 'abrir',
                        monto_apertura_usd,
                        monto_apertura_cop,
                        monto_apertura_bs,
                        observaciones,
                    }),
                });
                const data = await res.json();
                if (!res.ok) {
                    mostrarError(data.error || 'No se pudo abrir la caja');
                    return;
                }
                cerrarModalCaja();
                mostrarMensaje('Caja abierta correctamente. Ya puedes registrar ventas.');
                await cargarEstadoCaja();
            } catch (err) {
                mostrarError('Error de conexión al abrir la caja');
            }
        });
    }

