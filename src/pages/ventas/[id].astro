---
import Layout from "../../layouts/Layout.astro";
import EmpresaEncabezado from "../../components/EmpresaEncabezado.astro";
import { verificarToken } from "@/utils/auth.js";

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect("/login");
}

const { id } = Astro.params;
---

<Layout>
    <div class="btn-add_container actions-top">
        <a class="btn-add" href="/ventas">Regresar</a>
    </div>

    <EmpresaEncabezado id="headerImp" documento="FACTURA DE VENTA" />

    <main class="invoice-page">
        <div
            id="avisoNoFiscal"
            hidden
            style="padding: 0.75rem 1rem; border: 2px dashed #b45309; background: #fffbeb; color: #92400e; border-radius: 12px; font-weight: 800; text-align: center; font-size: 0.88rem; letter-spacing: 0.03em;"
        ></div>
        <section class="datos-cliente" id="datosClienteImp">
            <article class="detail-card">
                <span class="detail-label" id="lblNroDocumento">N° Factura</span>
                <strong id="nroFactura">—</strong>
            </article>
            <article class="detail-card detail-card--wide">
                <span class="detail-label">Cliente / Razón Social</span>
                <strong id="clienteNombre"></strong>
            </article>
            <article class="detail-card">
                <span class="detail-label">C.I. / RIF</span>
                <strong id="clienteCedula"></strong>
            </article>
            <article class="detail-card">
                <span class="detail-label">Teléfono</span>
                <strong id="clienteTelefono"></strong>
            </article>
            <article class="detail-card">
                <span class="detail-label">Fecha de emisión</span>
                <strong id="fecha"></strong>
            </article>
            <article class="detail-card">
                <span class="detail-label">Condición de pago</span>
                <strong id="tipoPago"></strong>
            </article>
            <article class="detail-card">
                <span class="detail-label">Estado</span>
                <strong id="estado"></strong>
            </article>
        </section>

        <section class="invoice-table-card">
            <div class="table-heading">
                <div>
                    <p class="eyebrow" id="eyebrowDetalleTabla">Productos</p>
                    <h2 id="tituloDetalleTabla">Detalle de productos</h2>
                </div>
            </div>

            <div class="table-wrap">
                <table id="table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th id="thDetalleUnit">Precio Unitario</th>
                            <th>Cant.</th>
                            <th id="thDetalleSub">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody id="listaProductos"></tbody>
                </table>
            </div>
        </section>

        <section class="invoice-table-card" id="pagosVentaCard" hidden>
            <div class="table-heading">
                <div>
                    <p class="eyebrow">Pagos</p>
                    <h2>Métodos de pago recibidos</h2>
                </div>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Método</th>
                            <th>Monto Recibido</th>
                        </tr>
                    </thead>
                    <tbody id="listaPagosVenta"></tbody>
                </table>
            </div>
        </section>

        <section class="total-box" id="totalImp">
            <p class="total-box_label" id="lblTituloTotalBox">Resumen de Factura</p>
            <div class="fiscal-summary" id="fiscalSummaryBox">
                <div class="fiscal-line">
                    <span>Base Imponible (G):</span>
                    <strong id="baseImponibleTexto">0.00 Bs</strong>
                </div>
                <div class="fiscal-line" id="lineaExento" style="display:none;">
                    <span>Monto Exento (E):</span>
                    <strong id="exentoTexto">0.00 Bs</strong>
                </div>
                <div class="fiscal-line">
                    <span>IVA (<span id="ivaAlicuotaTexto">16</span>%):</span>
                    <strong id="ivaMontoTexto">0.00 Bs</strong>
                </div>
                <div
                    class="fiscal-line"
                    id="lineaRetencion"
                    style="display:none; color:#b45309;"
                >
                    <span>(-) Retención IVA (<span id="retAlicuotaTexto">75</span>%):</span>
                    <strong id="retMontoTexto">-0.00 Bs</strong>
                </div>
            </div>

            <div class="total-box_values" id="totalBoxValues">
                <div id="cardTotalBs" style="grid-column: 1 / -1;">
                    <span class="total-box_caption" id="lblCardTotalBs">Total Factura</span>
                    <strong id="totalBs">0.00 Bs</strong>
                </div>
                <div id="cardTotalDivisas" style="display: none;">
                    <span class="total-box_caption" id="lblCardDivisas">Total Divisas (USD)</span>
                    <strong id="totalDivisas">0.00 USD</strong>
                </div>
                <div id="cardTotalCop" style="display: none;">
                    <span class="total-box_caption" id="lblCardCop">Total Pesos (COP)</span>
                    <strong id="totalCOP">0 COP</strong>
                </div>
                <div id="cardFleteVenta" style="display: none; grid-column: 1 / -1; padding-top: 0.4rem; border-top: 1px dashed rgba(var(--secondary-rgb), 0.2);">
                    <span class="total-box_caption">Flete (Referencia visual)</span>
                    <strong id="lblFleteVenta" style="font-size: 0.98rem; color: #b45309;">$0.0000 USD</strong>
                </div>
                <div id="cardGananciaAprox" style="grid-column: 1 / -1; padding-top: 0.4rem; border-top: 1px dashed rgba(var(--secondary-rgb), 0.2);">
                    <span class="total-box_caption">Ganancia Aproximada</span>
                    <strong id="lblGananciaAproxUsd" style="font-size: 1rem; color: #047857;">≈ $0.0000 USD</strong>
                    <span id="lblGananciaAproxRef" style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600;">0.0000 Bs · 0 COP</span>
                </div>
            </div>
        </section>
    </main>

    <div class="actions-bottom">
        <div class="btn-add_container">
            <a class="btn-add" id="imprimir">Imprimir Factura (Carta)</a>
        </div>
        <div class="btn-add_container btn-termica">
            <a class="btn-add" id="imprimirTermica">Ticket 58mm</a>
        </div>
    </div>

    <div id="mensaje"></div>
    <div id="overlay" class="overlay oculto">
        <div id="modal" class="modal"></div>
    </div>
</Layout>

<style>
    .invoice-page {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .actions-top,
    .actions-bottom {
        position: relative;
        z-index: 1;
    }

    .actions-bottom {
        margin-left: auto;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: flex-end;
    }

    .btn-termica {
        background: #1e293b !important;
        border-color: #1e293b !important;
    }

    .btn-termica:hover {
        background: #0f172a !important;
    }

    .detail-card,
    .invoice-table-card {
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
        box-shadow: 0 18px 32px rgba(var(--primary-rgb), 0.08);
    }

    .detail-label,
    .table-caption {
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .datos-cliente {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 0.95rem;
        padding: 0.55rem;
    }

    .detail-card {
        grid-column: span 3;
        display: grid;
        gap: 0.38rem;
        padding: 1rem 1.05rem;
    }

    .detail-card--wide {
        grid-column: span 6;
    }

    .detail-label {
        color: #4f3d78;
    }

    .detail-card strong {
        color: #1d1430;
        font-size: 0.96rem;
        word-break: break-word;
    }

    .invoice-table-card {
        padding: 1.15rem;
    }

    .table-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .table-heading h2 {
        font-size: 1.2rem;
    }

    .table-caption {
        color: #4f3d78;
        text-align: right;
        max-width: 32ch;
    }

    .total-box {
        width: min(100%, 560px);
        margin-left: auto;
        margin-top: 0.4rem;
        padding: 1.15rem 1.25rem;
        border-radius: 22px;
        background: linear-gradient(135deg, #dbeafe, #bfdbfe);
        color: #0f172a;
        border: 1px solid rgba(37, 99, 235, 0.18);
        box-shadow: 0 18px 28px rgba(37, 99, 235, 0.14);
    }

    .total-box_label {
        margin: 0 0 0.75rem;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #1d4ed8;
    }

    .fiscal-summary {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-bottom: 0.9rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px dashed rgba(37, 99, 235, 0.3);
        font-size: 0.9rem;
    }

    .fiscal-line {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .total-box_values {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
    }

    .total-box_values div {
        display: grid;
        gap: 0.25rem;
        padding: 0.8rem 0.9rem;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid rgba(59, 130, 246, 0.2);
    }

    .total-box_caption {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #2563eb;
    }

    .total-box_values strong {
        font-size: 1.15rem;
        line-height: 1.1;
        color: #0f172a;
    }

    @media (max-width: 768px) {
        .table-heading {
            flex-direction: column;
        }

        .datos-cliente {
            grid-template-columns: 1fr;
        }

        .detail-card,
        .detail-card--wide {
            grid-column: auto;
        }

        .total-box {
            width: 100%;
            margin-left: 0;
        }

        .total-box_values {
            grid-template-columns: 1fr;
        }

        .actions-bottom {
            margin-left: 0;
        }

        .table-caption {
            text-align: left;
            max-width: none;
        }
    }
</style>

<script>
    import { mostrarError } from "@/utils/helpers/mensajes.js";
    import { obtenerTasas } from "@/utils/helpers/cambioMoneda.js";
    import { formatearFecha } from "@/utils/helpers/formateoFecha.js";
    import { imprimirDocumentoVenta } from "@/utils/helpers/imprimirVenta.js";
    import {
        formatearMoneda,
        redondearBS,
        redondearCOP,
    } from "@/utils/helpers/tasas.js";
    import { etiquetaPago } from "@/utils/helpers/metodosPago.js";

    interface Producto {
        codigo_producto: string;
        nombre_producto: string;
        precio_unitario: number;
        precio_divisas?: number;
        exento_iva?: number;
        alicuota_iva?: number;
        monto_iva?: number;
        cantidad: number;
        subtotal: number;
        seriales?: string[];
    }

    document.addEventListener("DOMContentLoaded", async () => {
        const id = location.pathname.split("/").pop() as string;
        const nroFacturaEl = document.querySelector(
            "#nroFactura",
        ) as HTMLElement;
        const clienteNombre = document.querySelector(
            "#clienteNombre",
        ) as HTMLElement;
        const clienteCedula = document.querySelector(
            "#clienteCedula",
        ) as HTMLElement;
        const clienteTelefono = document.querySelector(
            "#clienteTelefono",
        ) as HTMLElement;
        const fecha = document.querySelector("#fecha") as HTMLElement;
        const tipoPago = document.querySelector("#tipoPago") as HTMLElement;
        const estado = document.querySelector("#estado") as HTMLElement;

        const baseImponibleTexto = document.querySelector(
            "#baseImponibleTexto",
        ) as HTMLElement;
        const lineaExento = document.querySelector(
            "#lineaExento",
        ) as HTMLElement;
        const exentoTexto = document.querySelector(
            "#exentoTexto",
        ) as HTMLElement;
        const ivaAlicuotaTexto = document.querySelector(
            "#ivaAlicuotaTexto",
        ) as HTMLElement;
        const ivaMontoTexto = document.querySelector(
            "#ivaMontoTexto",
        ) as HTMLElement;
        const lineaRetencion = document.querySelector(
            "#lineaRetencion",
        ) as HTMLElement;
        const retAlicuotaTexto = document.querySelector(
            "#retAlicuotaTexto",
        ) as HTMLElement;
        const retMontoTexto = document.querySelector(
            "#retMontoTexto",
        ) as HTMLElement;

        const totalBsEl = document.querySelector("#totalBs") as HTMLElement;
        const totalDivisasEl = document.querySelector(
            "#totalDivisas",
        ) as HTMLElement;
        const totalCOP = document.querySelector("#totalCOP") as HTMLElement;
        const listaProductos = document.querySelector(
            "#listaProductos",
        ) as HTMLElement;

        let ventaDataActual: any = null;
        let tasaBcvActual = 0;
        let tasaCopActual = 0;

        try {
            const res = await fetch(`/api/ventas/${id}`);

            if (!res.ok) {
                mostrarError("Error al obtener los datos de la venta");
                const errorText = await res.text();
                throw new Error(`Status ${res.status} Mensaje ${errorText}`);
            }

            const data: any = await res.json();
            const tasasActuales = await obtenerTasas();

            const esNotaEntrega = data.venta.tipo_documento === "nota_entrega";
            const tasaBcv =
                Number(data.venta.tasa_bcv) > 0
                    ? Number(data.venta.tasa_bcv)
                    : tasasActuales.bs;
            const tasaCop =
                Number(data.venta.tasa_cop) > 0
                    ? Number(data.venta.tasa_cop)
                    : tasasActuales.cop;

            ventaDataActual = data;
            tasaBcvActual = tasaBcv;
            tasaCopActual = tasaCop;

            const lblNroDocumento = document.querySelector(
                "#lblNroDocumento",
            ) as HTMLElement;
            const headerImp = document.querySelector(
                "#headerImp",
            ) as HTMLElement;
            const eyebrowDetalleTabla = document.querySelector(
                "#eyebrowDetalleTabla",
            ) as HTMLElement;
            const tituloDetalleTabla = document.querySelector(
                "#tituloDetalleTabla",
            ) as HTMLElement;
            const thDetalleUnit = document.querySelector(
                "#thDetalleUnit",
            ) as HTMLElement;
            const thDetalleSub = document.querySelector(
                "#thDetalleSub",
            ) as HTMLElement;
            const lblTituloTotalBox = document.querySelector(
                "#lblTituloTotalBox",
            ) as HTMLElement;
            const fiscalSummaryBox = document.querySelector(
                "#fiscalSummaryBox",
            ) as HTMLElement;
            const cardTotalBs = document.querySelector(
                "#cardTotalBs",
            ) as HTMLElement;
            const cardTotalDivisas = document.querySelector(
                "#cardTotalDivisas",
            ) as HTMLElement;
            const cardTotalCop = document.querySelector(
                "#cardTotalCop",
            ) as HTMLElement;
            const lblCardDivisas = document.querySelector(
                "#lblCardDivisas",
            ) as HTMLElement;
            const lblCardCop = document.querySelector(
                "#lblCardCop",
            ) as HTMLElement;
            const btnImpEl = document.querySelector("#imprimir") as HTMLElement;

            const avisoNoFiscal = document.querySelector("#avisoNoFiscal") as HTMLElement | null;

            if (esNotaEntrega) {
                if (avisoNoFiscal) {
                    avisoNoFiscal.hidden = false;
                    const linkFactura = data.venta.facturada_en_venta_id
                        ? ` · <a href="/ventas/${data.venta.facturada_en_venta_id}" style="color:#1d4ed8; text-decoration:underline;">Ver Factura Fiscal asociada ↗</a>`
                        : " · Pendiente por facturar";
                    avisoNoFiscal.innerHTML = `DOCUMENTO NO FISCAL — NO VÁLIDO COMO FACTURA NI CRÉDITO FISCAL${linkFactura}`;
                }
                if (lblNroDocumento)
                    lblNroDocumento.textContent = "N° Nota de Entrega";
                nroFacturaEl.textContent = data.venta.nro_nota_entrega
                    ? `NE-${String(data.venta.nro_nota_entrega).padStart(6, "0")}`
                    : `NE-${String(id).slice(0, 6).toUpperCase()}`;

                if (headerImp) {
                    const docTitle = headerImp.querySelector(
                        ".empresa-documento, h2, strong",
                    );
                    if (docTitle)
                        docTitle.textContent = "NOTA DE ENTREGA";
                }
                if (eyebrowDetalleTabla)
                    eyebrowDetalleTabla.textContent = "Nota de Entrega";
                if (tituloDetalleTabla)
                    tituloDetalleTabla.textContent =
                        "Detalle de Productos";
                if (thDetalleUnit)
                    thDetalleUnit.textContent = "Precio Unitario";
                if (thDetalleSub)
                    thDetalleSub.textContent = "Subtotal";
                if (lblTituloTotalBox)
                    lblTituloTotalBox.textContent =
                        "Total Nota de Entrega";
                if (fiscalSummaryBox) fiscalSummaryBox.style.display = "none";
                if (cardTotalBs) cardTotalBs.style.display = "none";
                if (cardTotalDivisas) cardTotalDivisas.style.display = "block";
                if (cardTotalCop) cardTotalCop.style.display = "block";
                if (lblCardDivisas)
                    lblCardDivisas.textContent = "Total Divisas (USD)";
                if (lblCardCop)
                    lblCardCop.textContent = "Total Pesos (COP)";
                if (btnImpEl) btnImpEl.textContent = "Imprimir Nota de Entrega (Carta)";
            } else {
                if (avisoNoFiscal && data.venta.nota_entrega_origen_id) {
                    avisoNoFiscal.hidden = false;
                    avisoNoFiscal.style.borderColor = "#1d4ed8";
                    avisoNoFiscal.style.background = "#eff6ff";
                    avisoNoFiscal.style.color = "#1e40af";
                    avisoNoFiscal.innerHTML = `FACTURA FISCAL GENERADA DESDE NOTA DE ENTREGA · <a href="/ventas/${data.venta.nota_entrega_origen_id}" style="color:#1d4ed8; text-decoration:underline;">Ver Nota de Entrega de origen ↗</a>`;
                }
                if (lblNroDocumento)
                    lblNroDocumento.textContent = "N° Factura";
                nroFacturaEl.textContent = data.venta.nro_factura
                    ? `#${String(data.venta.nro_factura).padStart(6, "0")}`
                    : `#${String(id).slice(0, 8).toUpperCase()}`;
                if (cardTotalBs) cardTotalBs.style.display = "block";
                if (cardTotalDivisas) cardTotalDivisas.style.display = "none";
                if (cardTotalCop) cardTotalCop.style.display = "none";
                if (btnImpEl) btnImpEl.textContent = "Imprimir Factura (Carta)";
            }

            clienteNombre.textContent = data.cliente.nombre.toUpperCase();
            clienteCedula.textContent = data.cliente.cedula;
            clienteTelefono.textContent = data.cliente.telefono;

            fecha.textContent = formatearFecha(data.venta.fecha);
            tipoPago.textContent = data.venta.tipo_pago.toUpperCase();
            estado.textContent = data.venta.estado.toUpperCase();

            const estadoNorm = data.venta.estado.toLowerCase();
            if (estadoNorm === "devuelto") {
                estado.style.color = "#854d0e";
            } else if (estadoNorm === "anulado") {
                estado.style.color = "#9f1f1f";
            }

            const subtotalBaseUsd = Number(data.venta.subtotal_base) || 0;
            const subtotalExentoUsd = Number(data.venta.subtotal_exento) || 0;
            const ivaPorc = Number(data.venta.iva_porcentaje ?? 16);
            const ivaUsd = Number(data.venta.iva_monto) || 0;
            const retPorc = Number(data.venta.retencion_iva_porcentaje) || 0;
            const retUsd = Number(data.venta.retencion_iva_monto) || 0;
            const montoTotalUsd = Number(data.venta.monto_total) || 0;
            const totalDivisasUsd =
                Number(data.venta.total_divisas) || montoTotalUsd;

            const baseBs = redondearBS(subtotalBaseUsd * tasaBcv);
            const exentoBs = redondearBS(subtotalExentoUsd * tasaBcv);
            const ivaBs = redondearBS(ivaUsd * tasaBcv);
            const retBs = redondearBS(retUsd * tasaBcv);
            const totalLegalBs = redondearBS(montoTotalUsd * tasaBcv);
            const totalRefCop = redondearCOP(totalDivisasUsd * tasaCop);

            if (!esNotaEntrega) {
                baseImponibleTexto.textContent = `${baseBs.toFixed(4)} Bs`;
                if (subtotalExentoUsd > 0) {
                    lineaExento.style.display = "flex";
                    exentoTexto.textContent = `${exentoBs.toFixed(4)} Bs`;
                }
                ivaAlicuotaTexto.textContent = String(ivaPorc);
                ivaMontoTexto.textContent = `${ivaBs.toFixed(4)} Bs`;

                if (retUsd > 0) {
                    lineaRetencion.style.display = "flex";
                    retAlicuotaTexto.textContent = String(retPorc);
                    const compTxt = data.venta.comprobante_retencion
                        ? ` [Comp: ${data.venta.comprobante_retencion}]`
                        : "";
                    retMontoTexto.textContent = `-${retBs.toFixed(4)} Bs${compTxt}`;
                }
            }

            const fleteVentaVal = Number(data.venta.flete_monto) || 0;
            const cardFleteVenta = document.getElementById("cardFleteVenta");
            const lblFleteVenta = document.getElementById("lblFleteVenta");
            if (fleteVentaVal > 0 && cardFleteVenta && lblFleteVenta) {
                cardFleteVenta.style.display = "grid";
                lblFleteVenta.textContent = `$${fleteVentaVal.toFixed(4)} USD`;
            }

            const gananciaUsd = Number(data.venta.ganancia_aproximada) || 0;
            const gananciaBs = redondearBS(gananciaUsd * tasaBcv);
            const gananciaCop = Math.round(gananciaUsd * tasaCop);
            const lblGananciaUsd = document.getElementById("lblGananciaAproxUsd");
            const lblGananciaRef = document.getElementById("lblGananciaAproxRef");
            if (lblGananciaUsd) {
                lblGananciaUsd.textContent = `≈ $${gananciaUsd.toFixed(4)} USD`;
                lblGananciaUsd.style.color = gananciaUsd < 0 ? "#b91c1c" : "#047857";
            }
            if (lblGananciaRef) {
                lblGananciaRef.textContent = `${gananciaBs.toFixed(4)} Bs · ${gananciaCop.toLocaleString("es-CO")} COP`;
            }

            totalBsEl.textContent = `${totalLegalBs.toFixed(4)} Bs`;
            totalDivisasEl.textContent = `$${totalDivisasUsd.toFixed(4)} USD`;
            totalCOP.textContent = `${totalRefCop.toLocaleString("es-CO")} COP`;

            listaProductos.innerHTML = "";

            const dataProductos = data.productos as Producto[];

            dataProductos.forEach((p) => {
                const row = document.createElement("tr");
                const pUnitBcvUsd = Number(p.precio_unitario) || 0;
                const pUnitBcvBs = redondearBS(pUnitBcvUsd * tasaBcv);
                const pUnitDivUsd =
                    Number(p.precio_divisas) > 0
                        ? Number(p.precio_divisas)
                        : pUnitBcvUsd;
                const pUnitCop = redondearCOP(pUnitDivUsd * tasaCop);

                const subBaseUsd = Number(p.subtotal) || 0;
                const subBaseBs = redondearBS(subBaseUsd * tasaBcv);
                const subDivCop = redondearCOP(
                    pUnitDivUsd * Number(p.cantidad) * tasaCop,
                );
                const esExento = Boolean(Number(p.exento_iva));

                let serialesHTML = "";
                if (p.seriales && p.seriales.length > 0) {
                    serialesHTML = `
                        <div style="margin-top: 0.4rem; font-size: 0.75rem; color: var(--text-muted); font-family: monospace;">
                            S/N: ${p.seriales.join(", ")}
                        </div>
                    `;
                }

                if (esNotaEntrega) {
                    row.innerHTML = `
                        <td data-label="Código">${p.codigo_producto.toUpperCase()}</td>
                        <td data-label="Descripción">
                            ${p.nombre_producto.toUpperCase()}
                            ${serialesHTML}
                        </td>
                        <td data-label="Precio Unitario">
                            <strong>$${pUnitDivUsd.toFixed(4)} USD</strong>
                            <br />
                            <span style="font-size:0.78rem; color:var(--text-muted);">${pUnitCop.toLocaleString("es-CO")} COP</span>
                        </td>
                        <td data-label="Cantidad">${p.cantidad}</td>
                        <td data-label="Subtotal">
                            <strong>$${(pUnitDivUsd * Number(p.cantidad)).toFixed(4)} USD</strong>
                            <br />
                            <span style="font-size:0.78rem; color:var(--text-muted);">${subDivCop.toLocaleString("es-CO")} COP</span>
                        </td>
                    `;
                } else {
                    row.innerHTML = `
                        <td data-label="Código">${p.codigo_producto.toUpperCase()}</td>
                        <td data-label="Descripción">
                            ${p.nombre_producto.toUpperCase()} <strong>(${esExento ? "E" : "G"})</strong>
                            ${serialesHTML}
                        </td>
                        <td data-label="Precio Unitario">
                            <strong>${pUnitBcvBs.toFixed(4)} Bs</strong>
                        </td>
                        <td data-label="Cantidad">${p.cantidad}</td>
                        <td data-label="Subtotal">
                            <strong>${subBaseBs.toFixed(4)} Bs</strong>
                        </td>
                    `;
                }
                listaProductos.appendChild(row);
            });

            const pagos = Array.isArray(data.pagos) ? data.pagos : [];
            const pagosCard = document.getElementById(
                "pagosVentaCard",
            ) as HTMLElement | null;
            const listaPagos = document.getElementById(
                "listaPagosVenta",
            ) as HTMLTableSectionElement | null;
            if (pagosCard && listaPagos) {
                pagosCard.hidden = pagos.length === 0;
                listaPagos.innerHTML = "";
                pagos.forEach(
                    (pago: {
                        moneda: string;
                        metodo: string;
                        monto: number;
                        monto_base: number;
                        moneda_base?: string;
                    }) => {
                        const fila = document.createElement("tr");
                        fila.innerHTML = `
                        <td data-label="Método">${etiquetaPago(pago.moneda, pago.metodo)}</td>
                        <td data-label="Monto Recibido">${formatearMoneda(pago.monto, pago.moneda)}</td>
                    `;
                        listaPagos.appendChild(fila);
                    },
                );
            }
        } catch (error) {
            console.error(error);
        }

        const btnImprimir = document.querySelector(
            "#imprimir",
        ) as HTMLAnchorElement | null;
        const btnImprimirTermica = document.querySelector(
            "#imprimirTermica",
        ) as HTMLAnchorElement | null;

        const lanzarImpresion = (formato: "carta" | "termica58") => {
            if (!ventaDataActual) {
                mostrarError("Los datos del documento aún no han cargado");
                return;
            }
            imprimirDocumentoVenta({
                data: ventaDataActual,
                tasaBcv: tasaBcvActual,
                tasaCop: tasaCopActual,
                formato,
            });
        };

        btnImprimir?.addEventListener("click", () => lanzarImpresion("carta"));
        btnImprimirTermica?.addEventListener("click", () => lanzarImpresion("termica58"));
    });
</script>
