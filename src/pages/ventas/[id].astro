---
import Layout from '../../layouts/Layout.astro';
import { verificarToken } from '@/utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}

const {id} = Astro.params;
---

<Layout>

    <div class="btn-add_container">
        <a class="btn-add" href="/ventas">Regresar</a>
    </div>


    <header id="headerImp">
        <h3>TECNO AIRES Y REFRIGERACIÓN</h3>
        <h1>DOUGLAS SANCHEZ</h1>
        <h3>J-506718936</h3>
    </header>

    <main>
        <section class="datos-cliente" id="datosClienteImp">
            <p>Nombre: <span id="clienteNombre"></span></p>
            <p>C.I. <span id="clienteCedula"></span></p>
            <p>Telf: <span id="clienteTelefono"></span></p>
            <p>Fecha de Compra: <span id="fecha"></span></p>
            <p>Tipo de Pago: <span id="tipoPago"></span></p>
            <p>Estado: <span id="estado"></span></p>
        </section>

        <table id="table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>P. Unitario</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody id="listaProductos"></tbody>
        </table>

        <section class="total" id="totalImp">
            <p>El total de la venta es de</p>
            <p><span id="total"></span> COP</p>
            <p>o</p>
            <p><span id="totalUsd"></span> USD</p>
            <p>o</p>
            <p><span id="totalBs"></span> Bs</p>
        </section>
    </main>

    <div class="btns-imprimir">
        <div class="btn-add_container">
            <a class="btn-add" id="imprimirDivisas">Imprimir en Divisas</a>
        </div>
        <div class="btn-add_container btn-bcv-wrap">
            <a class="btn-add" id="imprimirBs">Imprimir en Bs</a>
        </div>
    </div>

    <div id="mensaje"></div>
    <div id="overlay" class="overlay oculto"> 
        <div id="modal" class="modal"></div>
    </div>
</Layout>

<style>

    header {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;

        & h2{
            font-size: 1.5rem;
        }

        & h3{
            font-size: 1rem;
        }
    }

    .datos-cliente {
        display: flex;
        flex-direction: column;
        gap: .25rem;
        margin-bottom: 1.5rem;
    }

    span {
        font-weight: 700;
        font-size: 1rem
    }
    
    p {
        font-size: .85rem;
    }

    .total {
        display: flex;
        gap: 1rem;
        align-items: center;
        justify-content: center;
        margin-top: 1.5rem;
    }

    .btns-imprimir {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        justify-content: center;
        align-items: center;
        margin: 2rem auto 1.5rem;
        padding: 0 1rem;
        max-width: 32rem;
    }

    .btn-bcv-wrap {
        background: var(--secondary-color, #2c5282);
    }

    .btn-bcv-wrap:hover {
        background: var(--primary-color);
    }


</style>

<script>

    import { mostrarError } from '@/utils/helpers/mensajes.js';
    import { obtenerTasasPrecios } from '@/utils/helpers/cambioMoneda.js';
    import { calcularPventaBcv, calcularBsBcv, calcularBsBcvDesdeCop } from '@/utils/helpers/precios.js';
    import { formatearFecha } from '@/utils/helpers/formateoFecha.js';

    interface Producto {
        codigo_producto: string;
        nombre_producto: string;
        precio_unitario: number;
        cantidad: number;
        subtotal: number;
    }

    interface DatosVenta {
        cliente: { nombre: string; cedula: string; telefono: string };
        venta: { fecha: string; monto_total: number; tipo_pago: string; estado: string };
        productos: Producto[];
    }

    let datosVenta: DatosVenta | null = null;

    const estilosImpresion = `
        @media print {
            @page { size: 5.5in 8.5in; margin: 0.5in; }
            body { font-size: 11pt; }
        }
        body { font-family: Arial, sans-serif; margin: 20px; font-size: 12px; }
        h1, h3 { margin: 0; padding: 2px 0; text-align: center; }
        table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
        th, td { border: 1px solid #000; padding: 6px; text-align: left; font-size: 11px; }
        thead { background: #eee; }
        p { margin: 4px 0; }
        .total-impresion { margin-top: 1rem; font-size: 13px; }
        .total-impresion strong { font-size: 14px; }
        .precio-dual { line-height: 1.35; }
    `;

    function abrirVentanaImpresion(titulo: string, cuerpo: string) {
        const ventana = window.open('', '', 'width=800,height=600') as Window;
        ventana.document.write(`
            <html>
                <head><title>${titulo}</title><style>${estilosImpresion}</style></head>
                <body>${cuerpo}</body>
            </html>
        `);
        ventana.document.close();
        ventana.focus();
        ventana.print();
        ventana.close();
    }

    function encabezadoImpresion() {
        const headerImp = document.querySelector('#headerImp');
        if (!datosVenta) {
            return `<div>${headerImp?.outerHTML || ''}</div>`;
        }
        const { cliente, venta } = datosVenta;
        return `
            <div>${headerImp?.outerHTML || ''}</div>
            <div class="datos-cliente">
                <p>Nombre: <span>${cliente.nombre.toUpperCase()}</span></p>
                <p>C.I. <span>${cliente.cedula}</span></p>
                <p>Telf: <span>${cliente.telefono}</span></p>
                <p>Fecha de Compra: <span>${formatearFecha(venta.fecha)}</span></p>
                <p>Tipo de Pago: <span>${venta.tipo_pago.toUpperCase()}</span></p>
                <p>Estado: <span>${venta.estado.toUpperCase()}</span></p>
            </div>
        `;
    }

    function tablaDivisas(productos: Producto[], tasaCopUsd: number) {
        const filas = productos.map(p => {
            const usdUnit = tasaCopUsd > 0 ? p.precio_unitario / tasaCopUsd : 0;
            const usdSub = tasaCopUsd > 0 ? p.subtotal / tasaCopUsd : 0;
            return `
                <tr>
                    <td>${p.codigo_producto.toUpperCase()}</td>
                    <td>${p.nombre_producto.toUpperCase()}</td>
                    <td class="precio-dual">
                        ${Number(p.precio_unitario).toFixed(2)} COP<br />
                        ${usdUnit.toFixed(2)} USD
                    </td>
                    <td>${p.cantidad}</td>
                    <td class="precio-dual">
                        ${Number(p.subtotal).toFixed(2)} COP<br />
                        ${usdSub.toFixed(2)} USD
                    </td>
                </tr>
            `;
        }).join('');

        return `
            <table>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>P. Unitario</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>${filas}</tbody>
            </table>
        `;
    }

    function tablaBsBcv(
        productos: Producto[],
        tasaCopUsd: number,
        tasaBcvUsd: number,
        recargoBcv: number
    ) {
        const filas = productos.map(p => {
            const pventaBcv = calcularPventaBcv(p.precio_unitario, tasaCopUsd, recargoBcv);
            const precioBs = calcularBsBcv(pventaBcv, tasaBcvUsd);
            const subtotalBs = precioBs * Number(p.cantidad);
            return `
                <tr>
                    <td>${p.codigo_producto.toUpperCase()}</td>
                    <td>${p.nombre_producto.toUpperCase()}</td>
                    <td>${precioBs.toFixed(2)} Bs</td>
                    <td>${p.cantidad}</td>
                    <td>${subtotalBs.toFixed(2)} Bs</td>
                </tr>
            `;
        }).join('');

        return `
            <table>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>P. Unitario (Bs)</th>
                        <th>Cantidad</th>
                        <th>Subtotal (Bs)</th>
                    </tr>
                </thead>
                <tbody>${filas}</tbody>
            </table>
        `;
    }

    document.addEventListener('DOMContentLoaded', async () => {

        const id = location.pathname.split("/").pop() as string;
        //Datos a rellenar del cliente
        const clienteNombre = document.querySelector('#clienteNombre') as HTMLElement;
        const clienteCedula = document.querySelector('#clienteCedula') as HTMLElement;
        const clienteTelefono = document.querySelector('#clienteTelefono') as HTMLElement;
        //Datos a rellenar de la venta
        const fecha = document.querySelector('#fecha') as HTMLElement;
        const tipoPago = document.querySelector('#tipoPago') as HTMLElement;
        const estado = document.querySelector('#estado') as HTMLElement;
        const total = document.querySelector('#total') as HTMLElement;

        const totalUsdEl = document.querySelector('#totalUsd') as HTMLElement;
        const totalBsEl = document.querySelector('#totalBs') as HTMLElement;
        const listaProductos = document.querySelector('#listaProductos') as HTMLElement;

        try {

            const res = await fetch(`/api/ventas/${id}`);

            if (!res.ok) {
                mostrarError('Error al obtener los datos de la venta');
                const errorText = await res.text();
                throw new Error(`Status ${res.status} Mensaje ${errorText}`);
            }

            const data = await res.json() as DatosVenta;
            datosVenta = data;

            // Cliente
            clienteNombre.textContent = data.cliente.nombre.toUpperCase();
            clienteCedula.textContent = data.cliente.cedula;
            clienteTelefono.textContent = data.cliente.telefono;

            // Formatear Fecha
            const fechaFormateada = formatearFecha(data.venta.fecha);

            // Venta
            fecha.textContent = fechaFormateada;
            tipoPago.textContent = data.venta.tipo_pago.toUpperCase();
            estado.textContent = data.venta.estado.toUpperCase();
            total.textContent = data.venta.monto_total.toFixed(2);

            //Traer las tasas para los precios:
            const { tasaCopUsd, tasaBcvUsd, recargoBcv } = await obtenerTasasPrecios();

            totalUsdEl.textContent = (tasaCopUsd > 0 ? Number(data.venta.monto_total) / Number(tasaCopUsd) : 0).toFixed(2);
            totalBsEl.textContent = calcularBsBcvDesdeCop(
                data.venta.monto_total,
                tasaCopUsd,
                tasaBcvUsd,
                recargoBcv
            ).toFixed(2);

            // Productos
            listaProductos.innerHTML = '';

            const dataProductos = data.productos as Producto[];

            dataProductos.forEach(p => {
                const row = document.createElement('tr');
                const pventaBcv = calcularPventaBcv(p.precio_unitario, tasaCopUsd, recargoBcv);
                const pUnitarioUsd = tasaCopUsd > 0 ? p.precio_unitario / tasaCopUsd : 0;
                const pUnitarioBs = calcularBsBcv(pventaBcv, tasaBcvUsd);
                const subtotalUsd = tasaCopUsd > 0 ? p.subtotal / tasaCopUsd : 0;
                const subtotalBs = calcularBsBcv(pventaBcv, tasaBcvUsd) * p.cantidad;
                row.innerHTML = `
                                    <td data-label="Código">${p.codigo_producto.toUpperCase()}</td>
                                    <td data-label="Producto">${p.nombre_producto.toUpperCase()}</td>
                                    <td data-label="P. Unitario">
                                        ${p.precio_unitario} COP
                                        <br />
                                        ${pUnitarioUsd.toFixed(2)} USD
                                        <br />
                                        ${pUnitarioBs.toFixed(2)} Bs
                                    </td>
                                    <td data-label="Cantidad">${p.cantidad}</td>
                                    <td data-label="Subtotal">
                                        ${p.subtotal} COP
                                        <br />
                                        ${subtotalUsd.toFixed(2)} USD
                                        <br />
                                        ${subtotalBs.toFixed(2)} Bs
                                    </td>
                                `;
                listaProductos.appendChild(row);
            });

        }catch(error){
            console.error(error)
        }
    });

    const btnImprimirBs = document.querySelector('#imprimirBs') as HTMLAnchorElement;

    btnImprimirBs.addEventListener('click', async () => {
        if (!datosVenta) {
            mostrarError('Los datos de la venta aún no están disponibles');
            return;
        }

        const { tasaCopUsd, tasaBcvUsd, recargoBcv } = await obtenerTasasPrecios();
        const totalBs = calcularBsBcvDesdeCop(
            datosVenta.venta.monto_total,
            tasaCopUsd,
            tasaBcvUsd,
            recargoBcv
        );

        abrirVentanaImpresion('Comprobante en Bs', `
            ${encabezadoImpresion()}
            ${tablaBsBcv(datosVenta.productos, tasaCopUsd, tasaBcvUsd, recargoBcv)}
            <div class="total-impresion">
                <p><strong>Total de la venta:</strong> ${totalBs.toFixed(2)} Bs</p>
            </div>
        `);
    });

    const btnImprimirDivisas = document.querySelector('#imprimirDivisas') as HTMLAnchorElement;

    btnImprimirDivisas.addEventListener('click', async () => {
        if (!datosVenta) {
            mostrarError('Los datos de la venta aún no están disponibles');
            return;
        }

        const { tasaCopUsd } = await obtenerTasasPrecios();
        const totalCop = datosVenta.venta.monto_total;
        const totalUsd = tasaCopUsd > 0 ? totalCop / tasaCopUsd : 0;

        abrirVentanaImpresion('Comprobante Divisas', `
            ${encabezadoImpresion()}
            ${tablaDivisas(datosVenta.productos, tasaCopUsd)}
            <div class="total-impresion">
                <p><strong>Total de la venta:</strong></p>
                <p>${Number(totalCop).toFixed(2)} COP</p>
                <p>${totalUsd.toFixed(2)} USD</p>
            </div>
        `);
    });

</script> 