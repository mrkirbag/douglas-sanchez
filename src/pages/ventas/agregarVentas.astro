---
import Layout from "../../layouts/Layout.astro";
import { verificarToken } from "@/utils/auth.js";
import { obtenerMonedaBase } from "@/utils/helpers/tasas.js";

const monedaBase = obtenerMonedaBase();

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect("/login");
}

const fechaVenezuela = new Intl.DateTimeFormat("es-VE", {
    timeZone: "America/Caracas",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
}).format(new Date());

const [dia, mes, ano] = fechaVenezuela.split("/");
const fechaCompleta = `${ano}-${mes}-${dia}`;
---

<Layout>
    <header class="page-header">
        <p class="eyebrow">Facturación y Ventas</p>
        <h1>Emitir Factura Fiscal o Nota de Entrega</h1>
    </header>

    <div class="btn-add_container">
        <a class="btn-add" href="/ventas">Regresar</a>
    </div>

    <!-- Aviso si la caja está cerrada -->
    <div
        id="alertaCajaCerrada"
        style="display:none; padding: 1.1rem 1.3rem; margin-bottom: 1.1rem; border-radius: 18px; background: rgba(220, 38, 38, 0.1); border: 1px solid rgba(220, 38, 38, 0.3); color: #991b1b; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;"
    >
        <div>
            <strong style="display:block; font-size: 1rem;"
                >⚠️ Caja Cerrada</strong
            >
            <span style="font-size: 0.88rem;"
                >Para poder emitir facturas o notas de entrega debes abrir
                primero el turno de caja del día.</span
            >
        </div>
        <a
            href="/ventas"
            style="padding: 0.65rem 1.2rem; border-radius: 12px; background: #dc2626; color: #fff; text-decoration: none; font-weight: 700; font-size: 0.86rem;"
            >Ir a Abrir Caja</a
        >
    </div>

    <main class="venta-flow">
        <section class="venta-panel">
            <div class="panel-heading">
                <span class="step-badge">1</span>
                <div>
                    <p class="eyebrow">Modalidad y Productos</p>
                    <h2>Selecciona el tipo de documento y agrega productos</h2>
                </div>
            </div>

            <section class="form-container page-form venta-form">
                <form onsubmit="return false;">
                    <div class="form-field" style="grid-column: 1 / -1;">
                        <select
                            id="tipoDocumento"
                            name="tipoDocumento"
                            style="font-weight: 700;"
                        >
                            <option value="factura"
                                >Factura en Bs (Precio BCV)</option
                            >
                            <option value="nota_entrega"
                                >Nota de Entrega en Divisas</option
                            >
                        </select>
                    </div>

                    <div class="form-field">
                        <label for="fecha">Fecha de emisión</label>
                        <input
                            type="date"
                            name="fecha"
                            id="fecha"
                            value={fechaCompleta}
                        />
                    </div>

                    <div id="productos-container" class="producto-module">
                        <div class="form-field producto-module_search">
                            <label for="busquedaProductos"
                                >Buscar producto</label
                            >
                            <input
                                type="text"
                                id="busquedaProductos"
                                placeholder="Nombre o código del producto"
                                autocomplete="off"
                            />
                        </div>

                        <div class="form-field producto-module_select">
                            <label for="productoSelect">Producto</label>
                            <select name="producto" id="productoSelect"
                            ></select>
                        </div>

                        <div class="form-field">
                            <label for="cantidad">Cantidad</label>
                            <input
                                type="text"
                                id="cantidad"
                                placeholder="Ej. 2"
                            />
                        </div>

                        <div class="form-field">
                            <label for="precio" id="lblPrecioInput"
                                >Base Imponible BCV por unidad (Bs)</label
                            >
                            <input type="text" id="precio" placeholder="0.00" />
                            <span
                                id="precioReferencia"
                                class="precio-referencia"
                                >Base Bs: — · Ref. Divisas/COP: —</span
                            >
                        </div>

                        <div
                            class="form-field"
                            id="panelSerialesVenta"
                            style="display: none; grid-column: 1 / -1;"
                        >
                            <label>Seleccionar Seriales</label>
                            <p
                                style="font-size: 0.8rem; color: var(--text-muted); margin: 0 0 0.5rem;"
                            >
                                Busca y selecciona los seriales (se irán
                                agregando abajo).
                            </p>

                            <div
                                style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: end; margin-bottom: 0.5rem;"
                            >
                                <div
                                    class="form-field"
                                    style="margin-bottom: 0;"
                                >
                                    <label
                                        for="busquedaSeriales"
                                        style="font-size: 0.8rem;"
                                        >Filtro de búsqueda</label
                                    >
                                    <input
                                        type="text"
                                        id="busquedaSeriales"
                                        placeholder="Ej. ABC12..."
                                        autocomplete="off"
                                    />
                                </div>
                                <div
                                    class="form-field"
                                    style="margin-bottom: 0; position: relative;"
                                >
                                    <label
                                        for="dropdownSeriales"
                                        style="font-size: 0.8rem;"
                                        >Seleccionar serial</label
                                    >
                                    <select id="dropdownSeriales"></select>
                                </div>
                            </div>

                            <div
                                id="listaSerialesVenta"
                                class="serial-tags-container"
                                style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.85rem;"
                            >
                            </div>
                        </div>

                        <div class="form-actions producto-module_actions">
                            <button type="button" id="agregarProducto"
                                >Agregar producto</button
                            >
                        </div>
                    </div>
                </form>
            </section>
        </section>

        <section class="venta-panel invoice-table-card">
            <div class="table-heading">
                <div>
                    <p class="eyebrow">Detalle</p>
                    <h2 id="tituloTablaSeleccionados">
                        Productos seleccionados
                    </h2>
                </div>
            </div>

            <div class="table-wrap">
                <table>
                    <thead id="headerTablaProductos" style="opacity: 0;">
                        <tr>
                            <th>Producto</th>
                            <th id="thPrecioUnitario">Precio Unitario</th>
                            <th>Cantidad</th>
                            <th id="thSubtotalCol">Subtotal</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="listaProductos"> </tbody>
                </table>
            </div>
        </section>

        <div class="confirm-step">
            <button
                id="btnConfirmacion"
                class="btn-confirmar"
                disabled
                style="display: none;"
            >
                Continuar con el documento
            </button>
        </div>

        <section
            class="form-container page-form venta-panel checkout-panel"
            id="moduloDatosCompletar"
            style="display: none;"
        >
            <div class="panel-heading">
                <span class="step-badge">2</span>
                <div>
                    <p class="eyebrow" id="eyebrowPaso2">
                        Finalizar Factura Fiscal
                    </p>
                    <h2 id="tituloPaso2">Cliente, Retenciones de IVA y Pago</h2>
                </div>
            </div>

            <form class="checkout-form" onsubmit="return false;">
                <div class="form-field">
                    <label for="busquedaClientes">Buscar cliente</label>
                    <input
                        type="text"
                        id="busquedaClientes"
                        placeholder="Nombre, cédula o RIF"
                        autocomplete="off"
                    />
                </div>

                <div class="form-field select-container password-container">
                    <label for="cliente">Cliente</label>
                    <select name="cliente" id="cliente"></select>
                    <span
                        class="btn-cliente"
                        id="abrirMenuClienteNuevo"
                        title="Registrar nuevo cliente">+</span
                    >
                </div>

                <div
                    id="infoCreditoCliente"
                    style="display: none; grid-column: 1 / -1; padding: 0.8rem; background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.3); border-radius: 8px; color: #854d0e; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.5rem;"
                >
                    El cliente tiene un saldo a favor de <strong
                        id="montoCreditoCliente">0.00</strong
                    > en notas de crédito. Puedes usarlo en la sección de pagos seleccionando
                    "Nota de crédito" en USD.
                </div>

                <div
                    id="moduloAgregarClienteNuevo"
                    class="cliente-nuevo-panel"
                    style="display: none;"
                >
                    <p class="cliente-nuevo_title">
                        Registrar cliente no existente
                    </p>
                    <div class="form-field">
                        <label for="clienteNuevoNombre"
                            >Nombre / Razón Social</label
                        >
                        <input
                            type="text"
                            name="clienteNuevoNombre"
                            id="clienteNuevoNombre"
                            placeholder="Ej. Carlos Pérez"
                            maxlength="80"
                            autocomplete="off"
                        />
                    </div>
                    <div class="form-field">
                        <label for="clienteNuevoCedula">Cédula o RIF</label>
                        <input
                            type="text"
                            name="clienteNuevoCedula"
                            id="clienteNuevoCedula"
                            placeholder="Ej. 12345678 o J-12345678-9"
                            maxlength="15"
                            autocomplete="off"
                        />
                    </div>
                    <div class="form-field">
                        <label for="clienteNuevoTelefono">Teléfono</label>
                        <input
                            type="text"
                            name="clienteNuevoTelefono"
                            id="clienteNuevoTelefono"
                            placeholder="Ej. 04141234567"
                            maxlength="20"
                            autocomplete="off"
                        />
                    </div>
                    <div class="form-actions">
                        <button type="button" id="btnAgregarClienteNuevo"
                            >Registrar cliente</button
                        >
                    </div>
                </div>

                <div class="form-field" id="tipoPago-container">
                    <label for="tipoPago">Condición de pago</label>
                    <select name="tipoPago" id="tipoPago">
                        <option value="">Selecciona el tipo de pago</option>
                        <option value="contado">De contado</option>
                        <option value="credito">A crédito</option>
                    </select>
                </div>

                <div class="form-field" id="grupoRetencionIva">
                    <label for="retencionIvaSelect"
                        >Retención de IVA (Contribuyente Especial)</label
                    >
                    <select id="retencionIvaSelect">
                        <option value="0">Sin retención de IVA (0%)</option>
                        <option value="75">Retención de IVA 75%</option>
                        <option value="100">Retención de IVA 100%</option>
                    </select>
                </div>

                <div
                    class="form-field"
                    id="campoComprobanteRetencion"
                    style="display: none; grid-column: 1 / -1;"
                >
                    <label for="comprobanteRetencion"
                        >N° Comprobante de Retención (opcional)</label
                    >
                    <input
                        type="text"
                        id="comprobanteRetencion"
                        placeholder="Ej. 20261100001234"
                        autocomplete="off"
                    />
                </div>

                <div id="moduloPagosVenta" class="pagos-venta-panel" hidden>
                    <p class="pagos-venta_title">Métodos de pago</p>
                    <p class="pagos-venta_hint" id="pagosEyebrow">
                        Puedes combinar USD, COP y Bs. El total cubierto debe
                        igualar el Neto a Pagar del documento.
                    </p>

                    <div class="pagos-venta_form">
                        <div class="form-field">
                            <label for="pagoMoneda">Moneda</label>
                            <select id="pagoMoneda"></select>
                        </div>
                        <div class="form-field">
                            <label for="pagoMetodo">Método</label>
                            <select id="pagoMetodo"></select>
                        </div>
                        <div class="form-field">
                            <label for="pagoMonto">Monto recibido</label>
                            <input
                                type="text"
                                id="pagoMonto"
                                inputmode="decimal"
                                placeholder="0"
                                autocomplete="off"
                            />
                        </div>
                        <div class="form-actions pagos-venta_add">
                            <button type="button" id="btnAgregarPago"
                                >Agregar pago</button
                            >
                        </div>
                    </div>

                    <div
                        class="table-wrap pagos-venta_tabla"
                        id="pagosVentaTablaWrap"
                        hidden
                    >
                        <table>
                            <thead>
                                <tr>
                                    <th>Método</th>
                                    <th>Recibido</th>
                                    <th>Equivalente</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="listaPagosVenta"></tbody>
                        </table>
                    </div>

                    <div class="pagos-venta_resumen" id="pagosVentaResumen">
                        <p>Cubierto: <strong id="pagosCubierto">—</strong></p>
                        <p>Falta: <strong id="pagosFalta">—</strong></p>
                    </div>
                </div>

                <div class="flete-box" style="grid-column: 1 / -1; margin-top: 0.75rem; padding: 0.9rem 1rem; border-radius: 14px; background: #f9fafb; border: 1px solid #e5e7eb; display: grid; gap: 0.65rem;">
                    <label style="display:flex; align-items:center; gap:0.6rem; cursor:pointer; font-weight:700; color:#111827; margin:0; text-transform:none; letter-spacing:0;">
                        <input type="checkbox" id="chkFlete" style="width:18px; height:18px; accent-color: var(--accent-brand);" />
                        <span>Registrar monto de flete (solo visual/informativo; no altera el total ni los cálculos)</span>
                    </label>
                    <div id="grpFleteMonto" style="display:none; max-width: 280px;">
                        <label for="fleteMonto">Monto del Flete (COP) *</label>
                        <input type="text" id="fleteMonto" inputmode="decimal" placeholder="Ej. 15000" autocomplete="off" />
                    </div>
                </div>

                <p class="pagos-venta_credito" id="avisoPagoCredito" hidden>
                    En ventas a crédito el ingreso se registra cuando se abona.
                </p>

                <!-- Desglose Fiscal Completo -->
                <div class="total-box checkout-total">
                    <p class="total-box_label" id="lblTituloLiquidacion">
                        Resumen de Factura
                    </p>
                    <div class="fiscal-breakdown">
                        <div class="fiscal-row" id="filaBaseGravada">
                            <span>Base Imponible Gravada:</span>
                            <strong id="resumenBaseGravada">0.00 Bs</strong>
                        </div>
                        <div
                            class="fiscal-row"
                            id="filaExento"
                            style="display:none;"
                        >
                            <span>Monto Exento (E):</span>
                            <strong id="resumenExento">0.00 Bs</strong>
                        </div>
                        <div class="fiscal-row" id="filaIva">
                            <span
                                >IVA (<span id="lblIvaPorcentaje">16</span
                                >%):</span
                            >
                            <strong id="resumenIva">0.00 Bs</strong>
                        </div>
                        <div
                            class="fiscal-row"
                            id="filaRetencion"
                            style="display:none; color:#b45309;"
                        >
                            <span
                                >(-) Retención IVA (<span id="lblRetPorcentaje"
                                    >75</span
                                >%):</span
                            >
                            <strong id="resumenRetencion">-0.00 Bs</strong>
                        </div>
                        <hr
                            id="separadorFiscal"
                            style="border:none; border-top:1px dashed rgba(37, 99, 235, 0.3); margin: 0.45rem 0;"
                        />
                        <div class="fiscal-row fiscal-row--total">
                            <span id="lblTotalAPagar">TOTAL FACTURA:</span>
                            <strong id="totalDeVenta">—</strong>
                        </div>
                        <div
                            class="fiscal-row fiscal-row--ref"
                            id="filaRefSecundaria"
                            style="display: none;"
                        >
                            <span id="lblRefSecundaria"
                                >Equivalente en Pesos (COP):</span
                            >
                            <strong id="resumenRefDivisas">—</strong>
                        </div>
                    </div>
                </div>

                <div class="form-actions checkout-actions">
                    <button id="btnFinalizar" type="button"
                        >Emitir Factura Fiscal (Bs)</button
                    >
                </div>
            </form>
        </section>
    </main>

    <div id="overlay" class="overlay oculto">
        <div id="modal" class="modal"></div>
    </div>
</Layout>

<style>
    .venta-flow {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .venta-panel,
    .invoice-table-card {
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
        box-shadow: 0 18px 32px rgba(var(--primary-rgb), 0.08);
    }

    .venta-panel {
        padding: 1.15rem;
    }

    .panel-heading {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        margin-bottom: 1rem;
    }

    .step-badge {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        color: #fff;
        font-family: "Archivo Black", sans-serif;
        font-size: 1rem;
        flex-shrink: 0;
        box-shadow: 0 10px 20px rgba(var(--primary-rgb), 0.18);
    }

    .panel-heading h2 {
        margin: 0;
        font-size: 1.2rem;
    }

    .venta-form {
        width: 100%;
        margin: 0;
        padding: 0;
        background: transparent;
        border: none;
        box-shadow: none;
        backdrop-filter: none;
    }

    .producto-module {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem 1rem;
        padding: 1.1rem;
        border-radius: var(--radius-md);
        background: linear-gradient(
            180deg,
            rgba(236, 231, 246, 0.5),
            rgba(255, 255, 255, 0.72)
        );
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
    }

    .producto-module_search,
    .producto-module_select,
    .producto-module_actions {
        grid-column: 1 / -1;
    }

    .precio-referencia {
        display: block;
        margin-top: 0.35rem;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--secondary-color);
        line-height: 1.4;
    }

    .invoice-table-card {
        padding: 1.15rem;
    }

    .table-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .table-heading h2 {
        margin: 0;
        font-size: 1.2rem;
    }

    .confirm-step {
        display: flex;
        justify-content: center;
    }

    .btn-confirmar {
        appearance: none;
        border: none;
        border-radius: 999px;
        padding: 0.75rem 1.4rem;
        font-size: 0.86rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        color: #fff;
        box-shadow: 0 10px 24px rgba(var(--primary-rgb), 0.22);
    }

    .btn-confirmar:hover:not(:disabled) {
        transform: translateY(-2px);
        cursor: pointer;
    }

    .btn-confirmar:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .checkout-panel {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        width: 100%;
        max-width: none;
    }

    .checkout-form {
        align-items: start;
    }

    .checkout-form .select-container {
        grid-template-columns: 1fr auto;
        align-items: end;
    }

    .checkout-form .select-container label {
        grid-column: 1 / -1;
    }

    .btn-cliente {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        width: 44px;
        border-radius: 50%;
        cursor: pointer;
        font-weight: bold;
        font-size: 1.2rem;
        color: #fff;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        align-self: end;
    }

    .cliente-nuevo-panel {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem 1rem;
        padding: 1rem;
        border-radius: var(--radius-md);
        background: rgba(236, 231, 246, 0.45);
        border: 1px dashed rgba(var(--secondary-rgb), 0.18);
    }

    .cliente-nuevo_title {
        grid-column: 1 / -1;
        margin: 0 0 0.15rem;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--secondary-color);
    }

    .cliente-nuevo-panel .form-actions {
        grid-column: 1 / -1;
    }

    .checkout-total {
        grid-column: 1 / -1;
        width: min(100%, 540px);
        margin-left: auto;
        padding: 1.15rem 1.3rem;
        border-radius: 22px;
        background: linear-gradient(135deg, #dbeafe, #bfdbfe);
        color: #0f172a;
        border: 1px solid rgba(37, 99, 235, 0.18);
        box-shadow: 0 18px 28px rgba(37, 99, 235, 0.14);
    }

    .total-box_label {
        margin: 0 0 0.65rem;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #1d4ed8;
    }

    .fiscal-breakdown {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        font-size: 0.9rem;
    }

    .fiscal-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .fiscal-row--total {
        font-size: 1.15rem;
        font-weight: 800;
        color: #0f172a;
    }

    .fiscal-row--ref {
        margin-top: 0.2rem;
        font-size: 0.8rem;
        color: #1e40af;
    }

    .checkout-actions {
        grid-column: 1 / -1;
        justify-content: flex-end;
    }

    .pagos-venta-panel,
    .pagos-venta_credito {
        grid-column: 1 / -1;
    }

    .pagos-venta-panel {
        display: grid;
        gap: 0.85rem;
        padding: 1rem;
        border-radius: var(--radius-md);
        background: rgba(236, 231, 246, 0.45);
        border: 1px dashed rgba(var(--secondary-rgb), 0.18);
    }

    .pagos-venta-panel[hidden],
    .pagos-venta_credito[hidden],
    .pagos-venta_tabla[hidden] {
        display: none !important;
    }

    .pagos-venta_title {
        margin: 0;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--secondary-color);
    }

    .pagos-venta_hint,
    .pagos-venta_credito {
        margin: 0;
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.45;
    }

    .pagos-venta_form {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem 1rem;
        align-items: end;
    }

    .pagos-venta_add {
        grid-column: 1 / -1;
        margin: 0;
    }

    .pagos-venta_resumen {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.4rem;
        font-size: 0.9rem;
    }

    .pagos-venta_resumen p {
        margin: 0;
    }

    .pagos-venta_resumen.is-completo strong {
        color: #15803d;
    }

    @media (max-width: 768px) {
        .producto-module,
        .cliente-nuevo-panel,
        .checkout-form,
        .pagos-venta_form {
            grid-template-columns: 1fr;
        }

        .checkout-total {
            width: 100%;
            margin-left: 0;
        }
    }

    :global(.serial-tag) {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: linear-gradient(
            135deg,
            rgba(var(--primary-rgb), 0.1),
            rgba(var(--primary-rgb), 0.2)
        );
        border: 1px solid rgba(var(--primary-rgb), 0.3);
        color: var(--secondary-color);
        font-family: monospace;
        font-size: 0.9rem;
        font-weight: 600;
        padding: 0.3rem 0.6rem 0.3rem 0.85rem;
        border-radius: 99px;
    }

    :global(.serial-tag-remove) {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: bold;
    }
</style>

<script>
    import { mostrarError, mostrarMensaje } from "@/utils/helpers/mensajes.js";
    import { crearModuloSeriales } from "@/utils/helpers/seleccionSerial.js";
    import { obtenerTasas } from "@/utils/helpers/cambioMoneda.js";
    import { ponerIcono } from "@/utils/helpers/iconosAccion.js";
    import { validarCliente } from "@/utils/clienteValidaciones.js";
    import {
        convertirPrecioBcv,
        convertirPrecioDivisas,
        formatearMoneda,
        obtenerMonedaBase,
        redondearBS,
        redondearCOP,
        toleranciaPago,
        formatearDecimal,
    } from "@/utils/helpers/tasas.js";
    import {
        etiquetaPago,
        metodosDeMoneda,
        montoRestanteEnMoneda,
        monedasPagoDisponibles,
        parsearLineaPago,
        resumenPagos,
        validarPagosVenta,
    } from "@/utils/helpers/metodosPago.js";
    import {
        crearModuloProductos,
        enfocarBusquedaProductos,
        reiniciarBusquedaProductos,
    } from "@/utils/helpers/seleccionProducto.js";

    let serialesDisponiblesMemoria: string[] = [];
    let serialesSeleccionadosMemoria: string[] = [];
    let moduloSeriales: any = null;
    let productoActualEnFormulario: any = null;

    const monedaBase = obtenerMonedaBase();
    let moduloProductos: ReturnType<typeof crearModuloProductos> | null = null;

    const tipoDocumentoSelect = document.getElementById(
        "tipoDocumento",
    ) as HTMLSelectElement;
    const avisoModalidadFiscal = document.getElementById(
        "avisoModalidadFiscal",
    ) as HTMLDivElement;
    const lblPrecioInput = document.getElementById(
        "lblPrecioInput",
    ) as HTMLLabelElement;
    const productoSelect = document.getElementById(
        "productoSelect",
    ) as HTMLSelectElement;
    const precioInput = document.getElementById("precio") as HTMLInputElement;
    const precioReferencia = document.getElementById(
        "precioReferencia",
    ) as HTMLSpanElement;

    function esModoNotaEntrega() {
        return tipoDocumentoSelect?.value === "nota_entrega";
    }

    async function verificarCajaAbierta() {
        try {
            const res = await fetch("/api/caja");
            if (!res.ok) return;
            const data = await res.json();
            const alerta = document.getElementById(
                "alertaCajaCerrada",
            ) as HTMLElement;
            if (alerta) {
                alerta.style.display = data.abierta ? "none" : "flex";
            }
        } catch (err) {
            console.error("Error verificando caja:", err);
        }
    }

    async function actualizarReferenciaPrecio() {
        const valorPrecio = parseFloat(
            (precioInput.value || "").replace(",", "."),
        );
        const tasas = await obtenerTasas();
        const esNota = esModoNotaEntrega();

        if (!Number.isFinite(valorPrecio) || valorPrecio <= 0) {
            precioReferencia.textContent = esNota
                ? "Precio Divisas (COP): — · Sin IVA (Nota de Entrega)"
                : "Base Bs: — · Ref. Divisas/COP: —";
            return;
        }

        if (esNota) {
            const calcDiv = convertirPrecioDivisas(valorPrecio, tasas);
            precioReferencia.textContent = `Nota de Entrega (Sin IVA): ${formatearMoneda(calcDiv.usd, "USD")} · ${formatearMoneda(calcDiv.cop, "COP")}`;
            return;
        }

        const exento = Boolean(Number(productoActualEnFormulario?.exento_iva));
        const calcBcv = convertirPrecioBcv(valorPrecio, tasas, { exento });
        const precioDiv =
            Number(productoActualEnFormulario?.precio_divisas) > 0
                ? Number(productoActualEnFormulario.precio_divisas)
                : valorPrecio;
        const calcDiv = convertirPrecioDivisas(precioDiv, tasas);

        const textoIva = exento
            ? "Exento IVA"
            : `+IVA (${calcBcv.alicuota}%): ${formatearMoneda(calcBcv.totalBs, "BS")}`;

        precioReferencia.textContent = `Base BCV: ${formatearMoneda(calcBcv.baseBs, "BS")} (${textoIva}) · Divisas: ${formatearMoneda(calcDiv.usd, "USD")} (${formatearMoneda(calcDiv.cop, "COP")})`;
    }

    async function aplicarPrecioProducto(producto: any) {
        productoActualEnFormulario = producto;
        const esNota = esModoNotaEntrega();
        const bcv = parseFloat(
            String(producto.precio_bcv ?? producto.venta ?? ""),
        );
        const div = parseFloat(
            String(
                producto.precio_divisas ??
                    producto.precio_bcv ??
                    producto.venta ??
                    "",
            ),
        );
        const elegido = esNota ? (div > 0 ? div : bcv) : bcv;

        if (!Number.isNaN(elegido) && elegido > 0) {
            precioInput.value = formatearDecimal(elegido, 2, 4);
        } else {
            precioInput.value = "";
        }

        await actualizarReferenciaPrecio();
    }

    function iniciarModuloProductos() {
        if (moduloProductos) return;

        const cantidadInput = document.getElementById(
            "cantidad",
        ) as HTMLInputElement;

        moduloProductos = crearModuloProductos({
            productoSelect,
            cantidadInput,
            onNoEncontrado: mostrarError,
        });

        const busquedaSeriales = document.getElementById(
            "busquedaSeriales",
        ) as HTMLInputElement;
        const serialSelect = document.getElementById(
            "dropdownSeriales",
        ) as HTMLSelectElement;
        moduloSeriales = crearModuloSeriales({
            serialSelect,
            busquedaInput: busquedaSeriales,
        });
    }

    function iniciarPagina() {
        verificarCajaAbierta();
        rellenarSelectClientes();
        iniciarModuloProductos();
    }

    interface Cliente {
        id: number;
        nombre: string;
        cedula: string;
        telefono: string;
    }

    interface ProductoSeleccionado {
        codigo: string;
        nombre: string;
        precio: number; // Base BCV USD
        precio_divisas: number; // Divisas USD
        exento_iva: number;
        cantidad: number;
        id: number;
        stock: number;
        costo: number;
        venta: number;
        unidad_medida: string;
        serialesSeleccionados?: string[];
    }

    const btnAbrirMenuClienteNuevo = document.getElementById(
        "abrirMenuClienteNuevo",
    ) as HTMLSpanElement;
    const btnAgregarClienteNuevo = document.getElementById(
        "btnAgregarClienteNuevo",
    ) as HTMLButtonElement;
    const selectClientes = document.getElementById(
        "cliente",
    ) as HTMLSelectElement;
    const busquedaClientes = document.getElementById(
        "busquedaClientes",
    ) as HTMLInputElement;
    const moduloAgregarCliente = document.getElementById(
        "moduloAgregarClienteNuevo",
    ) as HTMLDivElement;
    const inputClienteNombre = document.getElementById(
        "clienteNuevoNombre",
    ) as HTMLInputElement;
    const inputClienteCedula = document.getElementById(
        "clienteNuevoCedula",
    ) as HTMLInputElement;
    const inputClienteTelefono = document.getElementById(
        "clienteNuevoTelefono",
    ) as HTMLInputElement;

    let clientesListados: Cliente[] = [];
    let clienteDeLaVenta: Cliente | null = null;
    let cargaClientesSeq = 0;
    let busquedaClientesTimer: ReturnType<typeof setTimeout> | null = null;
    let registrandoCliente = false;

    function idCliente(valor: unknown) {
        if (!valor) return "";
        return String(valor).trim();
    }

    function textoOpcionCliente(cliente: Cliente) {
        return `${String(cliente.nombre || "").toUpperCase()} - ${cliente.cedula}`;
    }

    function clientesParaSelect(clientes: Cliente[]) {
        if (!clienteDeLaVenta) return clientes;
        const id = idCliente(clienteDeLaVenta.id);
        return [
            clienteDeLaVenta,
            ...clientes.filter((cliente) => idCliente(cliente.id) !== id),
        ];
    }

    function renderOpcionesClientes(clientes: Cliente[]) {
        const lista = clientesParaSelect(clientes);
        const seleccionado =
            idCliente(clienteDeLaVenta?.id) || idCliente(selectClientes.value);
        selectClientes.innerHTML = "";

        const defaultOption = document.createElement("option");
        defaultOption.value = "";
        defaultOption.textContent = "Selecciona un cliente";
        defaultOption.disabled = true;
        selectClientes.appendChild(defaultOption);

        if (lista.length === 0) {
            const noResultsOption = document.createElement("option");
            noResultsOption.value = "";
            noResultsOption.textContent =
                "— Sin coincidencias para la búsqueda —";
            noResultsOption.disabled = true;
            selectClientes.appendChild(noResultsOption);
            defaultOption.selected = true;
            return;
        }

        lista.forEach((cliente) => {
            const option = document.createElement("option");
            option.value = idCliente(cliente.id);
            option.textContent = textoOpcionCliente(cliente);
            selectClientes.appendChild(option);
        });

        if (
            seleccionado &&
            lista.some((cliente) => idCliente(cliente.id) === seleccionado)
        ) {
            selectClientes.value = seleccionado;
            return;
        }

        defaultOption.selected = true;
    }

    async function cargarClientes(filtro = "") {
        const seq = ++cargaClientesSeq;
        const params = new URLSearchParams({ limit: filtro ? "80" : "500" });
        if (filtro) params.set("search", filtro);

        try {
            const response = await fetch(`/api/clientes?${params.toString()}`);
            const data = await response.json();
            if (seq !== cargaClientesSeq) return;
            clientesListados = Array.isArray(data) ? data : [];
            renderOpcionesClientes(clientesListados);
        } catch (error) {
            if (seq !== cargaClientesSeq) return;
            console.error("Error al cargar los clientes:", error);
            mostrarError("No se pudieron cargar los clientes");
        }
    }

    function seleccionarClienteEnVenta(cliente: Cliente) {
        if (busquedaClientesTimer) {
            clearTimeout(busquedaClientesTimer);
            busquedaClientesTimer = null;
        }

        clienteDeLaVenta = {
            id: cliente.id,
            nombre: cliente.nombre,
            cedula: cliente.cedula,
            telefono: cliente.telefono,
        };

        const id = idCliente(clienteDeLaVenta.id);
        const yaListado = clientesListados.some(
            (item) => idCliente(item.id) === id,
        );
        if (!yaListado) {
            clientesListados = [clienteDeLaVenta, ...clientesListados];
        } else {
            clientesListados = clientesListados.map((item) =>
                idCliente(item.id) === id
                    ? (clienteDeLaVenta as Cliente)
                    : item,
            );
        }

        busquedaClientes.value = "";
        cargaClientesSeq += 1;
        renderOpcionesClientes(clientesListados);
        selectClientes.value = id;
        selectClientes.dispatchEvent(new Event("change"));
    }

    function cerrarPanelClienteNuevo() {
        moduloAgregarCliente.style.display = "none";
        btnAbrirMenuClienteNuevo.textContent = "+";
        inputClienteNombre.value = "";
        inputClienteCedula.value = "";
        inputClienteTelefono.value = "";
    }

    async function rellenarSelectClientes() {
        await cargarClientes(busquedaClientes.value.trim());
    }

    productoSelect.addEventListener("change", async () => {
        const productoId = productoSelect.value;
        const panelSeriales = document.getElementById(
            "panelSerialesVenta",
        ) as HTMLDivElement;
        const listaSeriales = document.getElementById(
            "listaSerialesVenta",
        ) as HTMLDivElement;
        const cantidadInput = document.getElementById(
            "cantidad",
        ) as HTMLInputElement;

        if (!productoId) {
            productoActualEnFormulario = null;
            precioInput.value = "";
            panelSeriales.style.display = "none";
            listaSeriales.innerHTML = "";
            cantidadInput.readOnly = false;
            cantidadInput.value = "";
            await actualizarReferenciaPrecio();
            return;
        }

        try {
            const response = await fetch(`/api/productos/${productoId}`);

            if (!response.ok) {
                productoActualEnFormulario = null;
                precioInput.value = "";
                panelSeriales.style.display = "none";
                listaSeriales.innerHTML = "";
                cantidadInput.readOnly = false;
                await actualizarReferenciaPrecio();
                return;
            }

            const producto = await response.json();
            await aplicarPrecioProducto(producto);

            if (
                producto.serialesDisponibles &&
                producto.serialesDisponibles.length > 0
            ) {
                panelSeriales.style.display = "grid";
                serialesDisponiblesMemoria = [...producto.serialesDisponibles];
                serialesSeleccionadosMemoria = [];
                listaSeriales.innerHTML = "";
                moduloSeriales.cargarSeriales(serialesDisponiblesMemoria);
                cantidadInput.readOnly = true;
                cantidadInput.value = "0";
            } else {
                panelSeriales.style.display = "none";
                const ls = document.getElementById("dropdownSeriales");
                if (ls) ls.innerHTML = "";
                cantidadInput.readOnly = false;
                cantidadInput.value = "";
                serialesDisponiblesMemoria = [];
                serialesSeleccionadosMemoria = [];
                if (moduloSeriales) {
                    moduloSeriales.cargarSeriales([]);
                }
            }
        } catch (error) {
            console.error("Error de red o parsing:", error);
            productoActualEnFormulario = null;
            precioInput.value = "";
            panelSeriales.style.display = "none";
            listaSeriales.innerHTML = "";
            cantidadInput.readOnly = false;
            await actualizarReferenciaPrecio();
        }
    });

    precioInput.addEventListener("input", () => {
        actualizarReferenciaPrecio();
    });

    const btnagregarProducto = document.getElementById(
        "agregarProducto",
    ) as HTMLButtonElement;
    let productosSeleccionados: ProductoSeleccionado[] = [];

    async function renderizarTablaProductos() {
        const theader = document.getElementById(
            "headerTablaProductos",
        ) as HTMLTableSectionElement;
        const btnConfirmacion = document.getElementById(
            "btnConfirmacion",
        ) as HTMLButtonElement;
        const tablaProductos = document.getElementById(
            "listaProductos",
        ) as HTMLTableSectionElement;
        const tasas = await obtenerTasas();
        const esNota = esModoNotaEntrega();

        tablaProductos.innerHTML = "";

        if (productosSeleccionados.length === 0) {
            theader.style.opacity = "0";
            btnConfirmacion.style.display = "none";
            btnConfirmacion.disabled = true;
            return;
        }

        theader.style.opacity = "1";
        btnConfirmacion.style.display = "inline-block";
        btnConfirmacion.disabled = false;

        productosSeleccionados.forEach((item) => {
            const fila = document.createElement("tr");

            if (esNota) {
                const badgeNota = `<span style="font-size:0.65rem; padding:1px 6px; border-radius:99px; background:rgba(16,185,129,0.15); color:#047857; font-weight:700;">SIN IVA · NOTA ENTREGA</span>`;
                const calcUnit = convertirPrecioDivisas(item.precio_divisas, tasas);
                const calcSub = convertirPrecioDivisas(item.precio_divisas * item.cantidad, tasas);

                fila.innerHTML = `
                    <td data-label="Producto">
                        <strong>${item.nombre.toUpperCase()}</strong> ${badgeNota}
                        <br />
                        <span style="font-size: 0.78rem; color: var(--text-muted);">${item.codigo}</span>
                    </td>
                    <td data-label="Precio Unitario">
                        <strong>${formatearMoneda(calcUnit.cop, "COP")}</strong>
                        <br />
                        <span style="font-size: 0.78rem; color: var(--secondary-color);">${formatearMoneda(calcUnit.usd, "USD")}</span>
                    </td>
                    <td data-label="Cantidad">${item.cantidad} U.</td>
                    <td data-label="Subtotal">
                        <strong>${formatearMoneda(calcSub.cop, "COP")}</strong>
                        <br />
                        <span style="font-size: 0.78rem; color: var(--secondary-color);">${formatearMoneda(calcSub.usd, "USD")}</span>
                    </td>
                `;
            } else {
                const precioUnitarioBcv = +Number(item.precio).toFixed(2);
                const subtotalBaseVal = +(precioUnitarioBcv * item.cantidad).toFixed(2);
                const unitBaseBs = monedaBase === "COP"
                    ? redondearBS(precioUnitarioBcv)
                    : redondearBS(precioUnitarioBcv * tasas.bs);
                const subtotalBaseBs = monedaBase === "COP"
                    ? redondearBS(subtotalBaseVal)
                    : redondearBS(subtotalBaseVal * tasas.bs);

                const etiquetaFiscal = item.exento_iva
                    ? `<span style="font-size:0.65rem; padding:1px 6px; border-radius:99px; background:rgba(16,185,129,0.15); color:#047857; font-weight:700;">EXENTO (E)</span>`
                    : `<span style="font-size:0.65rem; padding:1px 6px; border-radius:99px; background:rgba(37,99,235,0.12); color:#1d4ed8; font-weight:700;">+IVA (${tasas.iva_porcentaje}%)</span>`;

                fila.innerHTML = `
                    <td data-label="Producto">
                        <strong>${item.nombre.toUpperCase()}</strong> ${etiquetaFiscal}
                        <br />
                        <span style="font-size: 0.78rem; color: var(--text-muted);">${item.codigo}</span>
                    </td>
                    <td data-label="Precio Unitario">
                        <strong>${formatearMoneda(unitBaseBs, "BS")}</strong>
                    </td>
                    <td data-label="Cantidad">${item.cantidad} U.</td>
                    <td data-label="Subtotal">
                        <strong>${formatearMoneda(subtotalBaseBs, "BS")}</strong>
                    </td>
                `;
            }

            const tdAcciones = document.createElement("td");
            tdAcciones.classList.add("acciones");

            const btnEliminar = document.createElement("button");
            btnEliminar.type = "button";
            btnEliminar.classList.add("btn-eliminar");
            ponerIcono(btnEliminar, "eliminar");
            btnEliminar.addEventListener("click", () => {
                productosSeleccionados = productosSeleccionados.filter(
                    (p) => p.codigo !== item.codigo,
                );
                renderizarTablaProductos();
                recalcularTotalesFiscales();
            });

            tdAcciones.appendChild(btnEliminar);
            fila.appendChild(tdAcciones);
            tablaProductos.appendChild(fila);
        });
    }

    async function actualizarModoDocumentoUI() {
        const esNota = esModoNotaEntrega();
        if (lblPrecioInput) {
            lblPrecioInput.textContent = esNota
                ? "Precio en Divisas por unidad (COP · Sin IVA)"
                : "Base Imponible por unidad (Bs)";
        }
        if (avisoModalidadFiscal) {
            if (esNota) {
                avisoModalidadFiscal.style.background =
                    "rgba(16, 185, 129, 0.1)";
                avisoModalidadFiscal.style.borderColor =
                    "rgba(16, 185, 129, 0.3)";
                avisoModalidadFiscal.style.color = "#065f46";
                avisoModalidadFiscal.innerHTML =
                    "💵 <strong>Nota de Entrega en Divisas:</strong> Se calcula según <code>precio_divisas</code> en COP con su referencia en USD a Tasa COP, <strong>sin IVA ni retenciones</strong>. Emite Nota de Entrega numerada.";
            } else {
                avisoModalidadFiscal.style.background =
                    "rgba(37, 99, 235, 0.08)";
                avisoModalidadFiscal.style.borderColor =
                    "rgba(37, 99, 235, 0.2)";
                avisoModalidadFiscal.style.color = "#1e40af";
                avisoModalidadFiscal.innerHTML =
                    "📌 <strong>Factura Fiscal SENIAT (Bs):</strong> Se emite en Bolívares más IVA. Queda numerada correlativamente y <strong>no puede ser cancelada ni eliminada</strong> (solo admite Nota de Crédito / Devolución).";
            }
        }

        const tituloTabla = document.getElementById("tituloTablaSeleccionados");
        const thPrecioUnitario = document.getElementById("thPrecioUnitario");
        const thSubtotalCol = document.getElementById("thSubtotalCol");
        const eyebrowPaso2 = document.getElementById("eyebrowPaso2");
        const tituloPaso2 = document.getElementById("tituloPaso2");
        const btnFinalizarEl = document.getElementById("btnFinalizar");

        if (tituloTabla) {
            tituloTabla.textContent = esNota
                ? "Productos seleccionados (Nota de Entrega en Divisas · Sin IVA)"
                : "Productos seleccionados (Factura en Bs)";
        }
        if (thPrecioUnitario)
            thPrecioUnitario.textContent = esNota
                ? "Precio Unit. Divisas (COP / USD)"
                : "Precio Unitario (Bs)";
        if (thSubtotalCol)
            thSubtotalCol.textContent = esNota
                ? "Subtotal Divisas"
                : "Subtotal (Bs)";
        if (eyebrowPaso2)
            eyebrowPaso2.textContent = esNota
                ? "Finalizar Nota de Entrega"
                : "Finalizar Factura Fiscal";
        if (tituloPaso2)
            tituloPaso2.textContent = esNota
                ? "Cliente y Pago en Divisas (Sin IVA)"
                : "Cliente, Retenciones de IVA y Pago";
        if (btnFinalizarEl)
            btnFinalizarEl.textContent = esNota
                ? "Emitir Nota de Entrega (Divisas)"
                : "Emitir Factura Fiscal (Bs)";

        if (productoActualEnFormulario) {
            await aplicarPrecioProducto(productoActualEnFormulario);
        } else {
            await actualizarReferenciaPrecio();
        }

        await renderizarTablaProductos();
        recalcularTotalesFiscales();

        const pagosEyebrow = document.getElementById("pagosEyebrow");
        if (pagosEyebrow) {
            pagosEyebrow.textContent = esNota
                ? "Puedes combinar USD y COP (solo divisas). El total cubierto debe coincidir con la nota de entrega."
                : "Puedes combinar USD, COP y Bs. El total cubierto debe coincidir con la venta.";
        }

        if (esNota && Array.isArray(pagosVenta) && pagosVenta.some((p: any) => p.moneda === "BS")) {
            pagosVenta.splice(
                0,
                pagosVenta.length,
                ...pagosVenta.filter((p: any) => p.moneda !== "BS"),
            );
            renderPagosVenta();
        }
        rellenarMonedasPago();
    }

    tipoDocumentoSelect?.addEventListener("change", () => {
        actualizarModoDocumentoUI();
    });

    btnagregarProducto.addEventListener("click", async (e: Event) => {
        e.preventDefault();

        const productoId = productoSelect.value;
        const cantidadInput = document.getElementById(
            "cantidad",
        ) as HTMLInputElement;
        const cantidad = parseFloat(
            (cantidadInput.value || "").replace(",", "."),
        );
        const precioIngresado = parseFloat(
            (precioInput.value || "").replace(",", "."),
        );
        const esNota = esModoNotaEntrega();

        try {
            const response = await fetch(`/api/productos/${productoId}`);
            if (!response.ok) {
                throw new Error(
                    "Error al obtener el producto: " + response.status,
                );
            }
            const producto = await response.json();

            if (!producto || !producto.stock) {
                mostrarError("Producto no encontrado o sin stock disponible");
                return;
            }

            let serialesSeleccionados: string[] = [];
            if (
                producto.serialesDisponibles &&
                producto.serialesDisponibles.length > 0
            ) {
                serialesSeleccionados = [...serialesSeleccionadosMemoria];

                if (serialesSeleccionados.length === 0) {
                    mostrarError(
                        "Debe seleccionar al menos un serial para vender este producto.",
                    );
                    return;
                }
                if (serialesSeleccionados.length !== cantidad) {
                    mostrarError(
                        "La cantidad no coincide con los seriales seleccionados.",
                    );
                    return;
                }
            }

            if (isNaN(cantidad) || Number(cantidad) <= 0) {
                mostrarError("Ingresa una cantidad válida mayor a cero");
                return;
            }

            if (isNaN(precioIngresado) || Number(precioIngresado) <= 0) {
                mostrarError("El precio del producto no es válido");
                return;
            }

            if (Number(cantidad) > producto.stock) {
                mostrarError(
                    `Cantidad insuficiente en stock. Stock disponible: ${producto.stock}`,
                );
                return;
            }

            const pBcvCatalogo =
                Number(producto.precio_bcv ?? producto.venta) ||
                precioIngresado;
            const pDivCatalogo =
                Number(producto.precio_divisas) > 0
                    ? Number(producto.precio_divisas)
                    : pBcvCatalogo;

            const precioUnitarioBcv = esNota
                ? +pBcvCatalogo.toFixed(4)
                : +precioIngresado.toFixed(4);
            const precioUnitarioDivisas = esNota
                ? +precioIngresado.toFixed(4)
                : +pDivCatalogo.toFixed(4);
            const exentoIva = Number(producto.exento_iva) ? 1 : 0;

            productoSelect.value = "";
            cantidadInput.value = "";
            precioInput.value = "";
            productoActualEnFormulario = null;
            await actualizarReferenciaPrecio();
            reiniciarBusquedaProductos();
            enfocarBusquedaProductos();

            productosSeleccionados.push({
                id: producto.id,
                nombre: producto.nombre,
                codigo: producto.codigo,
                precio: precioUnitarioBcv,
                precio_divisas: precioUnitarioDivisas,
                exento_iva: exentoIva,
                cantidad: cantidad,
                stock: producto.stock,
                costo: producto.costo,
                venta: producto.venta,
                unidad_medida: producto.unidad_medida,
                serialesSeleccionados: serialesSeleccionados,
            });

            await renderizarTablaProductos();
            recalcularTotalesFiscales();
        } catch (error) {
            console.error("Error al obtener el producto:", error);
            return;
        }
    });

