---
import Layout from '../../layouts/Layout.astro';
import { verificarToken } from '@/utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}

const fechaVenezuela = new Intl.DateTimeFormat('es-VE', {
        timeZone: 'America/Caracas',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
    }).format(new Date());

// Convertir de formato DD/MM/YYYY a YYYY-MM-DD
const [dia, mes, ano] = fechaVenezuela.split('/');
const fechaCompleta = `${ano}-${mes}-${dia}`;
---

<Layout>
    <h1>AGREGAR VENTA</h1>

    <div class="btn-add_container">
        <a class="btn-add" href="/ventas">Regresar</a>
    </div>

    <section class="form-container venta-form">
        <form>
            <div class="fecha-field">
                <label for="fecha">Fecha de la venta</label>
                <input type="date" name="fecha" id="fecha" value={fechaCompleta}/>
            </div>
            
            <div id="productos-container" class="modulo-agregar-producto">
                <h2 class="section-title">Agregar productos</h2>

                <div class="barcode-container">
                    <label for="barcodeInput">Escanear código de barras</label>
                    <input type="text" id="barcodeInput" placeholder="Escanea para seleccionar el producto y luego ajusta cantidad o precio" autocomplete="off" />
                </div>

                <div class="field-row">
                    <label for="busquedaProductos">Buscar producto</label>
                    <input type="text" id="busquedaProductos" placeholder="Buscar por nombre o código" />
                </div>

                <div class="field-row">
                    <label for="productoSelect">Producto</label>
                    <select name="producto" id="productoSelect"></select>
                </div>

                <div class="field-grid">
                    <div class="field-row">
                        <label for="cantidad">Cantidad</label>
                        <input type="text" id="cantidad" placeholder="Cantidad" value="1"/>
                    </div>
                    <div class="field-row">
                        <label for="precio">Precio por unidad</label>
                        <input type="text" id="precio"/>
                        <span id="precioPesos"></span>
                    </div>
                </div>

                <div class="btns-container">
                    <button id="agregarProducto" type="button">Agregar producto</button>
                </div>
            </div>
        </form>
    </section>

    <div class="table-section">
        <h2 class="section-title table-title">Productos en la venta</h2>

        <div id="emptyProductos" class="empty-state">
            <p>No se han agregado productos a la venta</p>
            <span>Busca o escanea un producto para comenzar</span>
        </div>

        <div id="panelProductos" class="productos-panel hidden">
            <table>
                <thead id="headerTablaProductos">
                    <tr>
                        <th>Producto</th>
                        <th>Precio por Unidad</th>
                        <th>Cantidad Seleccionada</th>
                        <th>Subtotal</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="listaProductos">
                </tbody>
            </table>
        </div>
    </div>

    <div class="btns-container btns-center">
        <button id="btnConfirmacion" disabled style="display: none;">Concretar la venta</button>
    </div>  

            
    <section class="form-container venta-checkout" id="moduloDatosCompletar" style="display: none;">
        <form>
            <h2 class="section-title">Datos de la venta</h2>

            <div class="field-row">
                <label for="busquedaClientes">Buscar cliente</label>
                <input type="text" id="busquedaClientes" placeholder="Buscar cliente por cédula" />
            </div>

            <div class="select-container">
                <select name="cliente" id="cliente"></select>
                <span class="btn-cliente" id="abrirMenuClienteNuevo" title="Agregar cliente">+</span>
            </div>

            <div id="moduloAgregarClienteNuevo" class="modulo-agregar-cliente" style="display: none;">
                <span class="modulo-label">Registrar cliente no existente</span>
                <input type="text" name="nombre" id="nombre" placeholder="Nombre y Apellido" />
                <input type="text" name="telefono" id="telefono" placeholder="Número de Teléfono" />
                <input type="number" name="cedula" id="cedula" placeholder="Cédula del Cliente" min="0"/>
                <button id="btnAgregarClienteNuevo" type="button">Agregar cliente</button>
            </div>

            <div class="select-container" id="tipoPago-container">
                <select name="tipoPago" id="tipoPago">
                    <option value="">Selecciona el Tipo de Pago</option>
                    <option value="contado">De Contado</option>
                    <option value="credito">A Crédito</option>
                </select>
            </div>

            <p id="totalDeVenta"></p>

            <div class="btns-container btns-center">
                <button id="btnFinalizar" type="button">Confirmar Venta</button>
            </div>
        </form>
    </section>
        
    <div id="overlay" class="overlay oculto"> 
        <div id="modal" class="modal"></div>
    </div>
</Layout>

<style>

    .venta-form,
    .venta-checkout {
        max-width: 560px;
    }

    .section-title {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--primary-color);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.75rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--gray-border);
    }

    .table-section {
        width: 100%;
    }

    .productos-panel {
        width: 100%;
    }

    .productos-panel.hidden {
        display: none;
    }

    .table-title {
        margin-bottom: 0.75rem;
    }

    .fecha-field {
        width: 100%;
        margin-bottom: 0.5rem;
    }

    .field-row {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        width: 100%;
    }

    .field-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        width: 100%;
    }

    .btn-cliente {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 38px;
        width: 38px;
        min-width: 38px;
        border-radius: var(--radius-sm);
        cursor: pointer;
        font-weight: 700;
        font-size: 1.1rem;
        color: #fff;
        background: var(--primary-color);
        transition: background var(--transition), transform var(--transition);
        box-shadow: var(--shadow-sm);

        &:hover {
            background-color: var(--secondary-color);
            transform: translateY(-1px);
        }
    }

    .modulo-agregar-cliente,
    .modulo-agregar-producto {
        display: flex;
        flex-direction: column;
        padding: 1.25rem;
        gap: 0.85rem;
        background-color: var(--gray-light);
        border-radius: var(--radius-md);
        border: 1px solid var(--gray-border);
        width: 100%;
    }

    .modulo-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--primary-color);
    }

    .btns-container {
        display: flex;
        justify-content: center;
        margin-top: 0.5rem;
        width: 100%;
    }

    .btns-center {
        justify-content: center;
    }

    #btnConfirmacion,
    #imprimirFacturacion,
    #btnFinalizar,
    #agregarProducto,
    #btnAgregarClienteNuevo {
        background-color: var(--primary-color);
        color: #fff;
        border-radius: var(--radius-sm);
        padding: 0.6rem 1.25rem;
        text-align: center;
        font-size: 0.875rem;
        font-weight: 600;
        border: none;
        outline: none;
        cursor: pointer;
        box-shadow: var(--shadow-sm);
        transition: background var(--transition), transform var(--transition), box-shadow var(--transition), opacity var(--transition);

        &:hover:not(:disabled) {
            background: var(--secondary-color);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        &:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }
    }

    #btnConfirmacion {
        display: block;
        margin: 0.5rem auto;
    }

    #mensaje {
        margin-top: 1rem;
    }

    #totalDeVenta {
        margin-top: 0.5rem;
        font-weight: 700;
        font-size: 1.05rem;
        text-align: center;
        color: var(--primary-color);
        padding: 1rem;
        background: var(--gray-light);
        border-radius: var(--radius-sm);
        border: 1px solid var(--gray-border);
    }

    #precioPesos {
        margin-top: 0.25rem;
        font-weight: 600;
        font-size: 0.75rem;
        color: var(--secondary-color);
    }

    .barcode-container {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1rem;
        background: rgba(0, 42, 73, 0.04);
        border: 2px dashed var(--primary-color);
        border-radius: var(--radius-sm);

        label {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--primary-color);
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        input {
            font-size: 0.95rem;
            letter-spacing: 0.03em;
            background: #fff;
        }
    }

    .barcode-container.barcode-error {
        border-color: var(--danger-color);
        border-style: solid;
        background: rgba(255, 77, 77, 0.06);
        animation: barcode-shake 0.3s ease;
    }

    @keyframes barcode-shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-4px); }
        75% { transform: translateX(4px); }
    }

    @media (max-width: 768px) {
        .field-grid {
            grid-template-columns: 1fr;
        }
    }

</style>

<script>

    import { mostrarError, mostrarMensaje } from '@/utils/helpers/mensajes.js';
    import { obtenerTasasPrecios } from '@/utils/helpers/cambioMoneda.js';
    import { calcularPventaBcv, calcularBsBcv, calcularTotalBsBcv } from '@/utils/helpers/precios.js';
    import { initBarcodeScanner, buscarProductoPorCodigo } from '@/utils/helpers/barcodeScanner.js';

    interface Cliente {
        id: number;
        nombre: string;
        cedula: string;
        telefono: string;
    }

    interface Producto {
        codigo: string;
        nombre: string;
        precio: number;
        pventa_bcv?: number;
        cantidad: number;
        id: number;

        stock: number;
        costo: number;
        venta: number;
        pventa_bcv?: number;
        unidad_medida: string;
    }

    function lineasPrecio(cop: number, cantidad: number, pventaBcv: number, tasaCopUsd: number, tasaBcvUsd: number) {
        const subtotalCop = Math.ceil(cop * cantidad);
        const usdDivisa = tasaCopUsd > 0 ? (cop / tasaCopUsd).toFixed(2) : '0.00';
        const bsUnit = calcularBsBcv(pventaBcv, tasaBcvUsd).toFixed(2);
        const subtotalUsd = tasaCopUsd > 0 ? ((cop * cantidad) / tasaCopUsd).toFixed(2) : '0.00';
        const subtotalBs = (calcularBsBcv(pventaBcv, tasaBcvUsd) * cantidad).toFixed(2);
        return {
            unitario: `${cop} COP<br />${usdDivisa} USD (divisas)<br />${bsUnit} Bs`,
            subtotal: `${subtotalCop} COP<br />${subtotalUsd} USD<br />${subtotalBs} Bs`,
        };
    }

     // Elementos del DOM

    const btnAbrirMenuClienteNuevo = document.getElementById("abrirMenuClienteNuevo") as HTMLSpanElement;
    const btnAgregarClienteNuevo = document.getElementById("btnAgregarClienteNuevo") as HTMLButtonElement;
    const btnImprimirFacturacion = document.getElementById("imprimirFacturacion") as HTMLButtonElement;

    // Eventos
    document.addEventListener("DOMContentLoaded", () => {
        rellenarSelectClientes();
        rellenarSelectProductos();
        actualizarVisibilidadTabla();

        const barcodeInput = document.getElementById("barcodeInput") as HTMLInputElement;
        initBarcodeScanner(barcodeInput, async (codigo) => {
            await seleccionarPorCodigoBarras(codigo);
        }, { refocusInput: false });
    }); 
    
    // cargar clientes y productos al iniciar
    async function rellenarSelectClientes() {

        const selectClientes = document.getElementById("cliente") as HTMLSelectElement;
        const busqueda = document.getElementById("busquedaClientes") as HTMLInputElement;

        let clientesListados : Cliente[] = [];

        try {
            const response = await fetch("/api/clientes");
            const data = await response.json();

            clientesListados = data;

            // Función para renderizar opciones
            const renderOpciones = (clientes : Cliente[]) => {
                selectClientes.innerHTML = ""; // Limpiar opciones previas

                // Opción inicial vacía
                const defaultOption = document.createElement("option");
                defaultOption.value = "";
                defaultOption.textContent = "Selecciona un cliente";
                defaultOption.disabled = true;
                defaultOption.selected = true;
                selectClientes.appendChild(defaultOption);

                // Mensaje si no hay registros para esa busqueda
                if (clientes.length === 0) {
                    const noResultsOption = document.createElement("option");
                    noResultsOption.value = "";
                    noResultsOption.textContent = "— Sin coincidencias para la búsqueda —";
                    noResultsOption.disabled = true;
                    selectClientes.appendChild(noResultsOption);
                    return;
                }

                clientes.forEach(cliente => {
                    const option = document.createElement("option") as HTMLOptionElement;
                    option.value = (cliente.id).toString();
                    option.textContent = `${cliente.nombre.toUpperCase()} - ${cliente.cedula}`;
                    selectClientes.appendChild(option);
                });
            };

            // Render inicial
            renderOpciones(clientesListados);

            // Listener de búsqueda
            busqueda.addEventListener("input", () => {
                const filtro = busqueda.value.trim();

                if (!filtro) {
                    renderOpciones(clientesListados);
                    return;
                }

                const clientesFiltrados = clientesListados.filter(cliente =>
                    String(cliente.cedula || "").includes(filtro)
                );

                renderOpciones(clientesFiltrados);
            });

        } catch (error) {
            console.error("Error al cargar los clientes:", error);
        }
    }

    let productosListados : Producto[] = [];
    let renderOpcionesProductos : ((productos: Producto[]) => void) | null = null;

    async function rellenarSelectProductos() {

        const busqueda = document.getElementById("busquedaProductos") as HTMLInputElement;
        const productoSelect = document.getElementById("productoSelect") as HTMLSelectElement;

        try {

            const response = await fetch("/api/productos");
            const data = await response.json();

            productosListados = data;

            const renderOpciones = (productos : Producto[]) => {
                productoSelect.innerHTML = ""; // Limpiar opciones previas

                // Opción inicial vacía
                const defaultOption = document.createElement("option");
                defaultOption.value = "";
                defaultOption.textContent = "Selecciona un producto";
                defaultOption.disabled = true;
                defaultOption.selected = true;
                productoSelect.appendChild(defaultOption);

                // Mensaje si no hay registros para esa busqueda
                if (productos.length === 0) {
                    const noResultsOption = document.createElement("option");
                    noResultsOption.value = "";
                    noResultsOption.textContent = "— Sin coincidencias para la búsqueda —";
                    noResultsOption.disabled = true;
                    productoSelect.appendChild(noResultsOption);
                    return;
                }

                productos.forEach(producto => {
                    const option = document.createElement("option");
                    option.value = producto.id.toString();
                    option.textContent = `${producto.codigo.toUpperCase()} - ${producto.nombre} - ${producto.stock} ${producto.unidad_medida} - ${producto.venta} COP`;
                    productoSelect.appendChild(option);
                });
            };

            renderOpcionesProductos = renderOpciones;

            // Render inicial
            renderOpciones(productosListados);

            // Listener de búsqueda
            busqueda.addEventListener("input", () => {
                const filtro = busqueda.value.trim().toLowerCase();

                if (!filtro) {
                    renderOpciones(productosListados);
                    return;
                }

                const productosFiltrados = productosListados.filter(producto => {
                    const nombre = String(producto.nombre || "").toLowerCase();
                    const codigo = String(producto.codigo || "").toLowerCase();
                    return nombre.includes(filtro) || codigo.includes(filtro);
                });

                renderOpciones(productosFiltrados);
            });


        } catch (error) {
            console.error("Error al cargar los productos:", error);
        }
    }

    // Seleccionar productos y mostrar input de precio
    const productoSelect = document.getElementById("productoSelect") as HTMLSelectElement;
    const precioInput = document.getElementById("precio") as HTMLInputElement;

    productoSelect.addEventListener("change", async () => {
        const productoId = productoSelect.value;

        if (!productoId) {
            precioInput.value = "";
            return;
        }

        try {
            const response = await fetch(`/api/productos/${productoId}`);

            if (!response.ok) {
                console.error("Error al obtener el producto:", response.status);
                precioInput.value = "";
                return;
            }

            const producto = await response.json();

            if (typeof producto.venta === "number") {
                precioInput.value = producto.venta.toFixed(2);
            } else {
                precioInput.value = "";
            }

        } catch (error) {
            console.error("Error de red o parsing:", error);
            precioInput.value = "";
        }
    });

    // Agregar productos a la tabla y mostrar
    const btnagregarProducto = document.getElementById("agregarProducto") as HTMLButtonElement;
    let productosSeleccionados : Producto[] = [];

    function flashBarcodeError() {
        const container = document.querySelector('.barcode-container') as HTMLDivElement;
        container?.classList.add('barcode-error');
        setTimeout(() => container?.classList.remove('barcode-error'), 400);
    }

    function actualizarVisibilidadTabla() {
        const tablaProductos = document.getElementById("listaProductos") as HTMLTableSectionElement;
        const emptyState = document.getElementById("emptyProductos") as HTMLDivElement;
        const panelProductos = document.getElementById("panelProductos") as HTMLDivElement;
        const btnConfirmacion = document.getElementById("btnConfirmacion") as HTMLButtonElement;
        const hayProductos = tablaProductos.children.length > 0;

        emptyState.classList.toggle("hidden", hayProductos);
        panelProductos.classList.toggle("hidden", !hayProductos);
        btnConfirmacion.style.display = hayProductos ? "inline-block" : "none";
        btnConfirmacion.disabled = !hayProductos;
    }

    async function seleccionarPorCodigoBarras(codigo: string) {
        const producto = await buscarProductoPorCodigo(codigo);

        if (!producto) {
            mostrarError(`Producto no encontrado: ${codigo}`);
            flashBarcodeError();
            document.getElementById("barcodeInput")?.focus();
            return;
        }

        const busqueda = document.getElementById("busquedaProductos") as HTMLInputElement;
        const cantidadInput = document.getElementById("cantidad") as HTMLInputElement;

        busqueda.value = "";
        renderOpcionesProductos?.(productosListados);

        productoSelect.value = String(producto.id);
        productoSelect.dispatchEvent(new Event("change", { bubbles: true }));

        if (!cantidadInput.value || Number(cantidadInput.value) <= 0) {
            cantidadInput.value = "1";
        }

        cantidadInput.focus();
        cantidadInput.select();
    }

    async function agregarProductoAVenta(producto: any, cantidad: number, precio: number) {
        if (!producto || producto.stock === undefined) {
            mostrarError('Producto no encontrado o sin stock disponible');
            return;
        }

        if (isNaN(cantidad) || Number(cantidad) <= 0) {
            mostrarError("Ingresa una cantidad válida mayor a cero");
            return;
        }

        if (isNaN(precio) || Number(precio) <= 0) {
            mostrarError("El precio del producto no es válido");
            return;
        }

        const existente = productosSeleccionados.find(p => p.codigo === producto.codigo);
        const cantidadTotal = existente ? existente.cantidad + cantidad : cantidad;

        if (Number(cantidadTotal) > producto.stock) {
            mostrarError(`Cantidad insuficiente en stock. Stock disponible: ${producto.stock}`);
            return;
        }

        const { tasaCopUsd, tasaBcvUsd, recargoBcv } = await obtenerTasasPrecios();
        const pventaBcv = producto.pventa_bcv != null
            ? Number(producto.pventa_bcv)
            : calcularPventaBcv(precio, tasaCopUsd, recargoBcv);
        const lineas = lineasPrecio(precio, cantidadTotal, pventaBcv, tasaCopUsd, tasaBcvUsd);

        if (existente) {
            existente.cantidad = cantidadTotal;
            existente.precio = precio;
            existente.pventa_bcv = pventaBcv;

            const fila = document.querySelector(`tr[data-codigo="${producto.codigo}"]`) as HTMLTableRowElement;
            if (fila) {
                fila.querySelector('[data-label="Cantidad"]')!.textContent = `${cantidadTotal} U.`;
                const celdasSubtotal = fila.querySelectorAll('td')[3];
                const lineasAct = lineasPrecio(precio, cantidadTotal, pventaBcv, tasaCopUsd, tasaBcvUsd);
                celdasSubtotal.innerHTML = lineasAct.subtotal;
            }
        } else {
            const tablaProductos = document.getElementById("listaProductos") as HTMLTableSectionElement;
            const fila = document.createElement("tr");
            fila.dataset.codigo = producto.codigo;

            fila.innerHTML = `
                <td data-label="Producto">
                    ${producto.nombre.toUpperCase()}
                    <br />
                    ${producto.codigo}
                </td>
                <td data-label="P. Unitario">
                    ${lineas.unitario}
                </td>
                <td data-label="Cantidad">${cantidad} U.</td>
                <td>${lineas.subtotal}</td>
            `;

            const tdAcciones = document.createElement('td');
            tdAcciones.classList.add('acciones');

            const btnEliminar = document.createElement('button');
            btnEliminar.classList.add('btn-eliminar');
            btnEliminar.textContent = 'DEL';
            btnEliminar.addEventListener('click', () => {
                fila.remove();
                productosSeleccionados = productosSeleccionados.filter(p => p.codigo !== producto.codigo);
                actualizarVisibilidadTabla();
            });

            tdAcciones.appendChild(btnEliminar);
            fila.appendChild(tdAcciones);
            tablaProductos.appendChild(fila);

            productosSeleccionados.push({
                id: producto.id,
                nombre: producto.nombre,
                codigo: producto.codigo,
                precio: precio,
                pventa_bcv: pventaBcv,
                cantidad: cantidad,
                stock: producto.stock,
                costo: producto.costo,
                venta: producto.venta,
                unidad_medida: producto.unidad_medida
            });
        }

        actualizarVisibilidadTabla();

        productoSelect.value = "";
        cantidadInput.value = "1";
        precioInput.value = "";
    }

    const cantidadInput = document.getElementById("cantidad") as HTMLInputElement;

    btnagregarProducto.addEventListener("click", async (e : Event) => {
        e.preventDefault();

        const productoId = productoSelect.value;
        const cantidad = parseFloat(cantidadInput.value.replace(",", "."));
        const precio = parseFloat(precioInput.value.replace(",", "."));

        if (!productoId) {
            mostrarError("Selecciona un producto");
            return;
        }

        try {
            const response = await fetch(`/api/productos/${productoId}`);
            if (!response.ok) {
                throw new Error('Error al obtener el producto: ' + response.status);
            }
            const producto = await response.json();
            await agregarProductoAVenta(producto, cantidad, precio);
        } catch (error) {
            console.error("Error al obtener el producto:", error);
        }
    });

    // Boton para concretar la venta que abre el módulo de clientes y tipo de pago
    const btnConfirmacion = document.getElementById("btnConfirmacion") as HTMLButtonElement;

    let totalDeVenta = 0;

    btnConfirmacion.addEventListener("click", async () => {
        
        // Abrir modulo de clientes y tipo de pago
        const moduloDatosCompletar = document.getElementById("moduloDatosCompletar") as HTMLDivElement;
        moduloDatosCompletar.style.display = "flex";

        // Bloquear el boton anterior
        btnConfirmacion.disabled = true;
        btnConfirmacion.textContent = "Procesando...";

        const { tasaCopUsd, tasaBcvUsd } = await obtenerTasasPrecios();

        const totalCop = productosSeleccionados.map(p => p.precio * p.cantidad).reduce((a, b) => a + b, 0);
        const totalUsd = tasaCopUsd > 0 ? totalCop / tasaCopUsd : 0;
        const totalBs = calcularTotalBsBcv(productosSeleccionados, tasaBcvUsd);

        const totalTexto = document.getElementById("totalDeVenta") as HTMLParagraphElement;
        totalTexto.innerHTML = `
            <strong>Total de la venta:</strong><br />
            ${Math.ceil(totalCop)} COP<br />
            ${totalUsd.toFixed(2)} USD (pago en divisas)<br />
            ${totalBs.toFixed(2)} Bs (pago en bolívares)
        `;
        totalDeVenta = totalCop;

    });

    btnAbrirMenuClienteNuevo.addEventListener("click", (e) => {
        e.preventDefault();
        const moduloAgregarCliente = document.getElementById("moduloAgregarClienteNuevo") as HTMLDivElement;

        moduloAgregarCliente.style.display = 
            moduloAgregarCliente.style.display === "none" ? "flex" : "none";
        btnAbrirMenuClienteNuevo.textContent = 
            moduloAgregarCliente.style.display === "flex" ? "-" : "+";
    }); 
    
    // abrir el modulo de cliente nuevo
    btnAgregarClienteNuevo.addEventListener("click", agregarClienteNuevo);

    async function agregarClienteNuevo(event : Event) {

        event.preventDefault();

        const nombre = (document.getElementById('nombre') as HTMLInputElement).value;
        const telefono = (document.getElementById('telefono') as HTMLInputElement).value;
        const cedulaText = (document.getElementById('cedula') as HTMLInputElement).value;

        // Validar campos vacios
        if (nombre === '' || telefono === '' || cedulaText === '') {
            mostrarError('Todos los campos son obligatorios');
            return;
        }

        // Validar formato de teléfono
        const telefonoRegex = /^\d+$/; 
        if (!telefonoRegex.test(telefono)) {
            mostrarError('El número de teléfono debe contener solo números');
            return;
        }

        // Validar cedula
        const cedulaRegex = /^[1-9]\d*$/;
        if (!cedulaRegex.test(cedulaText)) {
            mostrarError("La cédula debe ser un número entero positivo mayor a cero");
            return;
        }

        // Parsear cedula
        const cedula = parseInt(cedulaText);

        // Enviar datos al servidor
        const response = await fetch("/api/clientes", {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ nombre, telefono, cedula })
        });

        // Verificar si la respuesta es exitosa
        if (!response.ok) {
            if (response.status === 409) {
                const mensaje = await response.text();
                mostrarError(mensaje);
            } else {
                mostrarError('Error al agregar cliente: ' + response.status);
            }
            return;
        }

        const data = await response.json();
        const clienteAgregado = data.cliente[0];
        
        // Agregar el nuevo cliente al select
        const selectClientes = document.getElementById("cliente") as HTMLSelectElement;
        const option = document.createElement("option");
        option.value = clienteAgregado.id;
        option.textContent = `${clienteAgregado.nombre.toUpperCase()} - ${clienteAgregado.cedula}`;
        selectClientes.appendChild(option);
        option.selected = true; // Seleccionar el nuevo cliente

        // cerrar el módulo de agregar cliente y limpiar campos
        (document.getElementById('nombre') as HTMLInputElement).value = '';
        (document.getElementById('telefono') as HTMLInputElement).value = '';
        (document.getElementById('cedula') as HTMLInputElement).value = '';
        btnAbrirMenuClienteNuevo.textContent = "+";
        const moduloAgregarCliente = document.getElementById("moduloAgregarClienteNuevo") as HTMLDivElement;
        moduloAgregarCliente.style.display = "none";

        mostrarMensaje('Cliente agregado exitosamente');
    }

    // Enviar datos al servidor y concretar venta
    const btnFinalizar = document.getElementById("btnFinalizar") as HTMLButtonElement;

    btnFinalizar.addEventListener("click", async e => {

        e.preventDefault();

        // Traer informacion necesaria
        const fecha = (document.getElementById('fecha') as HTMLInputElement).value;
        const tipoPago = (document.getElementById('tipoPago') as HTMLSelectElement).value;
        const clienteId = (document.getElementById('cliente') as HTMLSelectElement).value;

        // Validaciones
        if (!fecha || !tipoPago || !clienteId) {
            mostrarError("Todos los campos son obligatorios");
            return;
        }

        if(fecha === '' || tipoPago === '' || clienteId === '') {
            mostrarError("Todos los campos son obligatorios");
            return;
        }

        if (productosSeleccionados.length === 0) {
            mostrarError("No hay productos seleccionados para la venta");
            return;
        }

        if (isNaN(totalDeVenta) || totalDeVenta <= 0) {
            mostrarError("El total de la venta no es válido");
            return;
        }

        // Crear venta y se guarda
        try  {

            const response = await fetch("/api/ventas", {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    fecha,
                    tipoPago,
                    clienteId,
                    totalDeVenta
                })
            });

            if (!response.ok) {
                throw new Error("Error al crear la venta");
            }

            const data = await response.json();

            // Recuperamos el id
            const ventaId = data.ventaId;

            // Agregar los productos a detalle
            for (const producto of productosSeleccionados) {

                const { codigo, nombre, precio, cantidad, id } : Producto = producto;
                let idProducto = id;

                const esDecimalPositivo: RegExp = /^\d+(\.\d+)?$/;

                const cantidadString: string = cantidad.toString();
                const precioString: string = precio.toString();

                const cantidadValida: boolean =
                esDecimalPositivo.test(cantidadString) && Number.isFinite(parseFloat(cantidadString)) && parseFloat(cantidadString) > 0;
                const precioUnitarioValido: boolean =
                esDecimalPositivo.test(precioString) && Number.isFinite(parseFloat(precioString)) && parseFloat(precioString) >= 0;

                if (!codigo || !nombre || !precioUnitarioValido || !cantidadValida) {
                    mostrarError("Faltan datos válidos del producto");
                    continue;
                }

                try {
                    const responseDetalles = await fetch("/api/detalleVentas", {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            ventaId,
                            idProducto,
                            codigo,
                            nombre,
                            precio,
                            cantidad
                        })
                    });

                    if (!responseDetalles.ok) {
                        throw new Error("Error al guardar detalle");
                    }

                } catch (error) {
                    console.error("Error en detalle:", error);
                    mostrarError(`Error al guardar producto ${codigo}`);
                }
            }

            // mostrar mensaje de exito, bloquear btnFinalizar y mostrar btnImprimirFacturacion
            mostrarMensaje('Venta finalizada correctamente. Puede imprimir el comprobante');

            setTimeout(() => {
                window.location.href = `/ventas/${ventaId}`;
            }, 1750);

        } catch (error) {
            console.error("Error al crear la venta:", error);
            mostrarError("Error al crear la venta. Por favor, inténtalo de nuevo.");
            return;
        }

    });
</script>