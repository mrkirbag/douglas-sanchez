    async function agregarClienteNuevo(event: Event) {
        event.preventDefault();

        if (registrandoCliente) return;

        const validado = validarCliente({
            nombre: inputClienteNombre.value,
            telefono: inputClienteTelefono.value,
            cedula: inputClienteCedula.value,
        });

        if (!validado.ok) {
            mostrarError(validado.error);
            return;
        }

        registrandoCliente = true;
        btnAgregarClienteNuevo.disabled = true;
        const textoBoton = btnAgregarClienteNuevo.textContent;
        btnAgregarClienteNuevo.textContent = "Registrando...";

        try {
            const response = await fetch("/api/clientes", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(validado.cliente),
            });

            const raw = await response.text();
            let data: any = null;
            try {
                data = raw ? JSON.parse(raw) : null;
            } catch {}

            if (!response.ok) {
                mostrarError(
                    data?.error ||
                        data?.message ||
                        raw ||
                        `Error al agregar cliente: ${response.status}`,
                );
                return;
            }

            const clienteAgregado = Array.isArray(data?.cliente)
                ? data.cliente[0]
                : data?.cliente;
            if (!clienteAgregado?.id) {
                mostrarError(
                    "El cliente se guardó, pero no se pudo seleccionar. Recarga e inténtalo de nuevo.",
                );
                return;
            }

            seleccionarClienteEnVenta(clienteAgregado);
            cerrarPanelClienteNuevo();
            mostrarMensaje(data?.message || "Cliente agregado exitosamente.");
        } catch (error) {
            console.error("Error al agregar cliente:", error);
            mostrarError("Error al agregar el cliente. Inténtalo de nuevo.");
        } finally {
            registrandoCliente = false;
            btnAgregarClienteNuevo.disabled = false;
            btnAgregarClienteNuevo.textContent =
                textoBoton || "Registrar cliente";
        }
    }

    const btnFinalizar = document.getElementById(
        "btnFinalizar",
    ) as HTMLButtonElement;

    btnFinalizar.addEventListener("click", async (e) => {
        e.preventDefault();

        const fecha = (document.getElementById("fecha") as HTMLInputElement)
            .value;
        const tipoPago = (
            document.getElementById("tipoPago") as HTMLSelectElement
        ).value;
        const clienteId =
            idCliente(clienteDeLaVenta?.id) || idCliente(selectClientes.value);
        const tipo_documento = esModoNotaEntrega() ? "nota_entrega" : "factura";
        const retencion_iva_porcentaje =
            tipo_documento === "nota_entrega"
                ? 0
                : Number(retencionIvaSelect?.value) || 0;
        const comprobante_retencion =
            tipo_documento === "nota_entrega"
                ? ""
                : (comprobanteRetencionInput?.value || "").trim();

        if (!fecha || !tipoPago || !clienteId) {
            mostrarError("Todos los campos son obligatorios");
            return;
        }

        if (productosSeleccionados.length === 0) {
            mostrarError("No hay productos seleccionados para la venta");
            return;
        }

        if (isNaN(totalDeVenta) || totalDeVenta <= 0) {
            mostrarError("El total de la venta no es válido");
            return;
        }

        const pagosValidados = validarPagosVenta({
            tipoPago,
            pagos: pagosVenta,
            totalBase: totalDeVenta,
            monedaBase: monedaBasePagoActual(),
            tasas: tasasVenta,
            soloDivisas: esModoNotaEntrega(),
        });

        if (!pagosValidados.ok) {
            mostrarError(pagosValidados.error);
            return;
        }

        const chkFlete = document.getElementById("chkFlete") as HTMLInputElement;
        const fleteMontoInput = document.getElementById("fleteMonto") as HTMLInputElement;
        const tiene_flete = Boolean(chkFlete?.checked);
        const flete_monto = parseFloat((fleteMontoInput?.value || "0").replace(",", ".")) || 0;

        if (tiene_flete && flete_monto <= 0) {
            mostrarError("Si marcas el campo de flete, debes ingresar un monto válido mayor a 0.");
            fleteMontoInput?.focus();
            return;
        }

        try {
            const response = await fetch("/api/ventas/completa", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({
                    fecha,
                    tipo_documento,
                    tipoPago,
                    clienteId,
                    totalDeVenta,
                    retencion_iva_porcentaje,
                    comprobante_retencion,
                    tiene_flete,
                    flete_monto: tiene_flete ? flete_monto : 0,
                    pagos: pagosValidados.pagos,
                    productos: productosSeleccionados.map(
                        ({
                            codigo,
                            nombre,
                            precio,
                            precio_divisas,
                            exento_iva,
                            cantidad,
                            id,
                            serialesSeleccionados,
                        }) => ({
                            idProducto: id,
                            codigo,
                            nombre,
                            precio,
                            precio_bcv: precio,
                            precio_divisas,
                            exento_iva,
                            cantidad,
                            seriales: serialesSeleccionados,
                        }),
                    ),
                }),
            });

            const data = await response.json();

            if (!response.ok) {
                mostrarError(data.error || "Error al crear la venta");
                return;
            }

            mostrarMensaje(
                tipo_documento === "nota_entrega"
                    ? "¡Nota de Entrega emitida correctamente!"
                    : "¡Factura Fiscal emitida correctamente!",
            );

            setTimeout(() => {
                window.location.href = `/ventas/${data.ventaId}`;
            }, 1500);
        } catch (error) {
            console.error("Error al crear la venta:", error);
            mostrarError(
                "Error al crear la venta. Por favor, inténtalo de nuevo.",
            );
            return;
        }
    });

    const chkFleteToggle = document.getElementById("chkFlete") as HTMLInputElement;
    const grpFleteMonto = document.getElementById("grpFleteMonto") as HTMLElement;
    const fleteMontoEl = document.getElementById("fleteMonto") as HTMLInputElement;
    chkFleteToggle?.addEventListener("change", () => {
        if (grpFleteMonto) grpFleteMonto.style.display = chkFleteToggle.checked ? "block" : "none";
        if (chkFleteToggle.checked) {
            fleteMontoEl?.focus();
        } else if (fleteMontoEl) {
            fleteMontoEl.value = "";
        }
    });

    // --- Lógica del Buscador/Multiselect de Seriales ---
    const selectSeriales = document.getElementById(
        "dropdownSeriales",
    ) as HTMLSelectElement;
    const listaSerialesVenta = document.getElementById(
        "listaSerialesVenta",
    ) as HTMLDivElement;

    selectSeriales?.addEventListener("change", () => {
        const serial = selectSeriales.value;
        if (serial && !serialesSeleccionadosMemoria.includes(serial)) {
            serialesSeleccionadosMemoria.push(serial);
            renderizarTagsSeriales();
            actualizarOpcionesSeriales();

            if (moduloSeriales) {
                moduloSeriales.reset();
            }
        }
    });

    function actualizarOpcionesSeriales() {
        if (!moduloSeriales) return;
        const disponibles = serialesDisponiblesMemoria.filter(
            (s) => !serialesSeleccionadosMemoria.includes(s),
        );
        moduloSeriales.cargarSeriales(disponibles);
    }

    function renderizarTagsSeriales() {
        if (!listaSerialesVenta) return;

        listaSerialesVenta.innerHTML = serialesSeleccionadosMemoria
            .map(
                (s) =>
                    `<div class="serial-tag">
                ${s}
                <div class="serial-tag-remove" data-serial="${s}" title="Remover serial">✕</div>
            </div>`,
            )
            .join("");

        const cantidadInput = document.getElementById(
            "cantidad",
        ) as HTMLInputElement;
        if (cantidadInput && cantidadInput.readOnly) {
            cantidadInput.value =
                serialesSeleccionadosMemoria.length.toString();
        }

        listaSerialesVenta
            .querySelectorAll(".serial-tag-remove")
            .forEach((btn) => {
                btn.addEventListener("click", (e) => {
                    const s = (e.target as HTMLElement).getAttribute(
                        "data-serial",
                    );
                    if (s) {
                        serialesSeleccionadosMemoria =
                            serialesSeleccionadosMemoria.filter(
                                (item) => item !== s,
                            );
                        renderizarTagsSeriales();
                        actualizarOpcionesSeriales();
                    }
                });
            });
    }
</script>
