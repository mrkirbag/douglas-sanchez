    function recalcularTotalesFiscales() {
        const esNota = esModoNotaEntrega();
        const ivaPorc = esNota ? 0 : Number(tasasVenta.iva_porcentaje) || 16;
        const retPorc = esNota ? 0 : Number(retencionIvaSelect?.value) || 0;

        if (grupoRetencionIva) {
            grupoRetencionIva.style.display = esNota ? "none" : "flex";
        }
        if (campoComprobanteRetencion) {
            campoComprobanteRetencion.style.display =
                !esNota && retPorc > 0 ? "block" : "none";
        }

        let subtotalBaseUsd = 0;
        let subtotalExentoUsd = 0;
        let totalDivisasUsd = 0;

        for (const p of productosSeleccionados) {
            if (p.exento_iva) {
                subtotalExentoUsd += p.precio * p.cantidad;
            } else {
                subtotalBaseUsd += p.precio * p.cantidad;
            }
            totalDivisasUsd += p.precio_divisas * p.cantidad;
        }

        subtotalBaseUsd = +subtotalBaseUsd.toFixed(4);
        subtotalExentoUsd = +subtotalExentoUsd.toFixed(4);
        totalDivisasUsd = +totalDivisasUsd.toFixed(4);

        const tBcv = Number(tasasVenta.bs) || 0;
        const tCop = Number(tasasVenta.cop) || 0;

        const filaBaseGravada = document.getElementById(
            "filaBaseGravada",
        ) as HTMLElement;
        const filaExento = document.getElementById("filaExento") as HTMLElement;
        const filaIva = document.getElementById("filaIva") as HTMLElement;
        const filaRetencion = document.getElementById(
            "filaRetencion",
        ) as HTMLElement;
        const separadorFiscal = document.getElementById(
            "separadorFiscal",
        ) as HTMLElement;
        const lblTituloLiquidacion = document.getElementById(
            "lblTituloLiquidacion",
        ) as HTMLElement;
        const lblTotalAPagar = document.getElementById(
            "lblTotalAPagar",
        ) as HTMLElement;
        const filaRefSecundaria = document.getElementById(
            "filaRefSecundaria",
        ) as HTMLElement;
        const lblRefSecundaria = document.getElementById(
            "lblRefSecundaria",
        ) as HTMLElement;

        if (esNota) {
            totalDeVenta = totalDivisasUsd;
            const { usd: totalUsdRef, cop: totalCop } = convertirPrecioDivisas(totalDivisasUsd, tasasVenta);

            if (lblTituloLiquidacion)
                lblTituloLiquidacion.textContent =
                    "Resumen de Nota de Entrega en Divisas (Sin IVA)";
            if (filaBaseGravada) filaBaseGravada.style.display = "none";
            if (filaExento) filaExento.style.display = "none";
            if (filaIva) filaIva.style.display = "none";
            if (filaRetencion) filaRetencion.style.display = "none";
            if (separadorFiscal) separadorFiscal.style.display = "none";
            if (filaRefSecundaria) filaRefSecundaria.style.display = "flex";

            if (lblTotalAPagar)
                lblTotalAPagar.textContent = "TOTAL NOTA DE ENTREGA (COP):";
            (
                document.getElementById("totalDeVenta") as HTMLElement
            ).textContent = formatearMoneda(totalCop, "COP");
            if (lblRefSecundaria)
                lblRefSecundaria.textContent =
                    "Equivalente en Dólares (USD):";
            (
                document.getElementById("resumenRefDivisas") as HTMLElement
            ).textContent = `${formatearMoneda(totalUsdRef, "USD")} (Sin IVA)`;

            renderPagosVenta();
            return;
        }

        if (lblTituloLiquidacion)
            lblTituloLiquidacion.textContent = "Resumen de Factura";
        if (filaBaseGravada) filaBaseGravada.style.display = "flex";
        if (filaIva) filaIva.style.display = "flex";
        if (separadorFiscal) separadorFiscal.style.display = "block";
        if (filaRefSecundaria) filaRefSecundaria.style.display = "none";
        if (lblTotalAPagar)
            lblTotalAPagar.textContent = "TOTAL FACTURA:";

        const ivaUsd = +(subtotalBaseUsd * (ivaPorc / 100)).toFixed(2);
        const retencionUsd = +(ivaUsd * (retPorc / 100)).toFixed(2);
        const netoPagarUsd = +(
            subtotalBaseUsd +
            subtotalExentoUsd +
            ivaUsd -
            retencionUsd
        ).toFixed(2);

        totalDeVenta = netoPagarUsd;

        const baseBs = monedaBase === "COP" ? redondearBS(subtotalBaseUsd) : redondearBS(subtotalBaseUsd * tBcv);
        const exentoBs = monedaBase === "COP" ? redondearBS(subtotalExentoUsd) : redondearBS(subtotalExentoUsd * tBcv);
        const ivaBs = monedaBase === "COP" ? redondearBS(ivaUsd) : redondearBS(ivaUsd * tBcv);
        const retBs = monedaBase === "COP" ? redondearBS(retencionUsd) : redondearBS(retencionUsd * tBcv);
        const netoBs = monedaBase === "COP" ? redondearBS(netoPagarUsd) : redondearBS(netoPagarUsd * tBcv);

        (
            document.getElementById("lblIvaPorcentaje") as HTMLElement
        ).textContent = String(ivaPorc);
        (
            document.getElementById("resumenBaseGravada") as HTMLElement
        ).textContent = `${formatearDecimal(baseBs, 2, 4)} Bs`;

        if (subtotalExentoUsd > 0) {
            filaExento.style.display = "flex";
            (
                document.getElementById("resumenExento") as HTMLElement
            ).textContent = `${formatearDecimal(exentoBs, 2, 4)} Bs`;
        } else {
            filaExento.style.display = "none";
        }

        (document.getElementById("resumenIva") as HTMLElement).textContent =
            `${formatearDecimal(ivaBs, 2, 4)} Bs`;

        if (retPorc > 0 && retencionUsd > 0) {
            filaRetencion.style.display = "flex";
            (
                document.getElementById("lblRetPorcentaje") as HTMLElement
            ).textContent = String(retPorc);
            (
                document.getElementById("resumenRetencion") as HTMLElement
            ).textContent = `-${formatearDecimal(retBs, 2, 4)} Bs`;
        } else {
            filaRetencion.style.display = "none";
        }

        (document.getElementById("totalDeVenta") as HTMLElement).textContent =
            `${formatearDecimal(netoBs, 2, 4)} Bs`;

        renderPagosVenta();
    }

    retencionIvaSelect?.addEventListener("change", recalcularTotalesFiscales);

    function rellenarMetodosPago() {
        const moneda = pagoMonedaSelect.value;
        const metodos = metodosDeMoneda(moneda);
        const actual = pagoMetodoSelect.value;
        pagoMetodoSelect.innerHTML = metodos
            .map(
                (metodo: { id: string; etiqueta: string }) =>
                    `<option value="${metodo.id}">${metodo.etiqueta}</option>`,
            )
            .join("");
        if (metodos.some((metodo: { id: string }) => metodo.id === actual)) {
            pagoMetodoSelect.value = actual;
        }
    }

    function rellenarMonedasPago() {
        const monedas = monedasPagoDisponibles(tasasVenta, {
            soloDivisas: esModoNotaEntrega(),
        });
        const actual = pagoMonedaSelect.value;
        pagoMonedaSelect.innerHTML = monedas
            .map(
                (moneda: { id: string; etiqueta: string }) =>
                    `<option value="${moneda.id}">${moneda.etiqueta}</option>`,
            )
            .join("");
        if (monedas.some((moneda: { id: string }) => moneda.id === actual)) {
            pagoMonedaSelect.value = actual;
        } else if (monedas[0]) {
            pagoMonedaSelect.value = monedas[0].id;
        }
        rellenarMetodosPago();
        sugerirMontoRestante();
    }

    function monedaBasePagoActual() {
        return monedaBase === "COP"
            ? (esModoNotaEntrega() ? "COP" : "BS")
            : monedaBase;
