---
import Layout from '../layouts/Layout.astro';
import { verificarToken } from '../utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}
---

<Layout>
    <h1>COTIZACIONES</h1>

    <section class="form-container">
        <form>
            <div class="barcode-container">
                <label for="barcodeInput">Escanear código de barras</label>
                <input type="text" id="barcodeInput" placeholder="Escanea para seleccionar el producto y luego ajusta cantidad o precio" autocomplete="off" />
            </div>

            <input type="text" id="busquedaProductos" placeholder="Buscar producto por nombre o código..." />

            <select name="producto" id="productoSelect"></select>

            <div>
                <label for="cantidad">Cantidad:</label>
                <input type="number" min="1" id="cantidad" placeholder="Ingrese la cantidad" value="1"/>
            </div>

            <div>
                <label for="precio">Precio por Unidad:</label>
                <input type="text" id="precio"/>
            </div>

            <div>
                <button id="agregarProducto">Agregar</button>
            </div>
        </form>
    </section>
    

    <div class="table-section">
        <h2 class="section-title">Productos en el presupuesto</h2>

        <div id="emptyProductos" class="empty-state">
            <p>No se han agregado productos al presupuesto</p>
            <span>Busca o escanea un producto para comenzar</span>
        </div>

        <div id="panelProductos" class="productos-panel hidden">
            <table id="contenidoImpresion">
                <thead id="headerTablaProductos">
                    <tr>
                        <th>Producto</th>
                        <th>Precio por Unidad</th>
                        <th>Cantidad Seleccionada</th>
                        <th>Subtotal</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="listaProductos">
                </tbody>
            </table>
        </div>
    </div>
    
    <p id="totalWrapper" class="total-wrapper hidden"><span id="total"></span></p>

    <div class="btns-container hidden" id="btns">
        <button id="imprimir" disabled>Imprimir</button>
        <button id="reiniciar" disabled>Cancelar</button>
    </div>
    
    <div id="overlay" class="overlay oculto"> 
        <div id="modal" class="modal"></div>
    </div>

    <div id="mensaje"></div>
</Layout>

<style>
    .section-title {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--primary-color);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.75rem;
    }

    .table-section {
        width: 100%;
    }

    .productos-panel {
        width: 100%;
    }

    .productos-panel.hidden,
    .total-wrapper.hidden,
    .btns-container.hidden {
        display: none;
    }

    .btns-container {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 1rem;

        & button {
            display: block;
            background-color: var(--primary-color);
            color: #fff;
            border-radius: var(--radius-sm);
            padding: 0.6rem 1.25rem;
            text-align: center;
            font-size: 0.875rem;
            font-weight: 600;
            border: none;
            outline: none;
            box-shadow: var(--shadow-sm);
            transition: background var(--transition), transform var(--transition);

            &:hover:not(:disabled) {
                background: var(--secondary-color);
                transform: translateY(-1px);
                cursor: pointer;
            }

            &:disabled {
                opacity: 0.45;
                cursor: not-allowed;
            }
        }
    }

    .total-wrapper {
        margin-top: 1rem;
        text-align: center;
    }

    #total {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--primary-color);
        padding: 1rem;
        background: var(--gray-light);
        border-radius: var(--radius-sm);
        border: 1px solid var(--gray-border);
        display: inline-block;
    }

    .barcode-container {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1rem;
        background: rgba(0, 42, 73, 0.04);
        border: 2px dashed var(--primary-color);
        border-radius: var(--radius-sm);
        margin-bottom: 0.75rem;
        width: 100%;

        label {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--primary-color);
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        input {
            font-size: 0.95rem;
            letter-spacing: 0.03em;
        }
    }

    .barcode-container.barcode-error {
        border-color: var(--danger-color);
        border-style: solid;
        background: rgba(255, 77, 77, 0.06);
        animation: barcode-shake 0.3s ease;
    }

    @keyframes barcode-shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-4px); }
        75% { transform: translateX(4px); }
    }
</style>

<script >

    import { obtenerTasasPrecios } from "@/utils/helpers/cambioMoneda";
    import { calcularPventaBcv, calcularBsBcv, calcularBsBcvDesdeCop } from "@/utils/helpers/precios";
    import { mostrarError } from "@/utils/helpers/mensajes";
    import { initBarcodeScanner, buscarProductoPorCodigo } from "@/utils/helpers/barcodeScanner.js";

    interface Producto {
        codigo: string;
        nombre: string;
        precio: number;
        cantidad: number;
        id: number;

        stock: number;
        costo: number;
        venta: number;
        unidad_medida: string;
    }

    (document.querySelector('#imprimir') as HTMLButtonElement).addEventListener('click', () => {

        const tablaOriginal = document.querySelector('#contenidoImpresion') as HTMLTableElement;
        const totalTexto = (document.querySelector('#total') as HTMLParagraphElement).textContent;

        // Clonar solo las filas visibles y omitir columna de acciones
        const filas = Array.from(tablaOriginal.querySelectorAll('tbody tr')).map(fila => {
            const celdas = fila.querySelectorAll('td');
            return `
            <tr>
                <td>${celdas[0]?.textContent}</td>
                <td>${celdas[1]?.textContent}</td>
                <td>${celdas[2]?.textContent}</td>
                <td>${celdas[3]?.textContent}</td>
            </tr>
            `;
        }).join('');

        const ventana = window.open('', '', 'width=800,height=600') as Window;

        ventana.document.write(`
            <!DOCTYPE html>
            <html>
            <head>
                <title>Presupuestos</title>
                <style>
                body {
                    font-family: Arial, sans-serif;
                    margin: 20px;
                    font-size: 13px;
                }
                h2 {
                    text-align: center;
                    margin-bottom: 1rem;
                }
                table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-bottom: 1.5rem;
                }
                th, td {
                    border: 1px solid #000;
                    padding: 8px;
                    text-align: left;
                }
                thead {
                    background: #ddd;
                    font-weight: bold;
                }
                p.total {
                    text-align: right;
                    font-size: 14px;
                    font-weight: bold;
                    margin-top: 1rem;
                }
                </style>
            </head>
            <body>
                <h2>Presupuesto</h2>
                <table>
                <thead>
                    <tr>
                    <th>Producto</th>
                    <th>Precio por Unidad</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    ${filas}
                </tbody>
                </table>
                <p class="total">${totalTexto}</p>
            </body>
            </html>
        `);

        ventana.document.close();
        ventana.print();
    });

    document.addEventListener('DOMContentLoaded', () => {
        rellenarSelectProductos();
        actualizarVisibilidadPresupuesto();

        const barcodeInput = document.getElementById("barcodeInput") as HTMLInputElement;
        initBarcodeScanner(barcodeInput, async (codigo: string) => {
            await seleccionarPorCodigoBarras(codigo);
        }, { refocusInput: false });
    });

    function actualizarVisibilidadPresupuesto() {
        const tbody = document.querySelector('#listaProductos') as HTMLTableSectionElement;
        const emptyState = document.getElementById('emptyProductos') as HTMLDivElement;
        const panelProductos = document.getElementById('panelProductos') as HTMLDivElement;
        const btnsContainer = document.querySelector('#btns') as HTMLDivElement;
        const totalWrapper = document.getElementById('totalWrapper') as HTMLParagraphElement;
        const btnImprimir = document.querySelector('#imprimir') as HTMLButtonElement;
        const btnCancelar = document.querySelector('#reiniciar') as HTMLButtonElement;
        const hayProductos = tbody.children.length > 0;

        emptyState.classList.toggle('hidden', hayProductos);
        panelProductos.classList.toggle('hidden', !hayProductos);
        btnsContainer.classList.toggle('hidden', !hayProductos);
        totalWrapper.classList.toggle('hidden', !hayProductos);
        btnImprimir.disabled = !hayProductos;
        btnCancelar.disabled = !hayProductos;
    }

    function flashBarcodeError() {
        const container = document.querySelector('.barcode-container') as HTMLDivElement;
        container?.classList.add('barcode-error');
        setTimeout(() => container?.classList.remove('barcode-error'), 400);
    }

    async function seleccionarPorCodigoBarras(codigo: string) {
        const producto = await buscarProductoPorCodigo(codigo);

        if (!producto) {
            mostrarError(`Producto no encontrado: ${codigo}`);
            flashBarcodeError();
            document.getElementById("barcodeInput")?.focus();
            return;
        }

        const busqueda = document.getElementById("busquedaProductos") as HTMLInputElement;
        const cantidadInput = document.getElementById("cantidad") as HTMLInputElement;
        const productoSelect = document.getElementById("productoSelect") as HTMLSelectElement;

        busqueda.value = "";
        renderOpcionesProductos?.(productosListados);

        productoSelect.value = String(producto.id);
        productoSelect.dispatchEvent(new Event("change", { bubbles: true }));

        if (!cantidadInput.value || Number(cantidadInput.value) <= 0) {
            cantidadInput.value = "1";
        }

        cantidadInput.focus();
        cantidadInput.select();
    }

    async function procesarAgregarProducto(producto: any, cantidad: number, precio: number) {
        if (!producto || producto.stock === undefined) {
            mostrarError('Producto no encontrado o sin stock disponible');
            return;
        }
        if (isNaN(cantidad) || Number(cantidad) <= 0) {
            mostrarError("Ingresa una cantidad válida mayor a cero");
            return;
        }
        if (isNaN(precio) || Number(precio) <= 0) {
            mostrarError("El precio del producto no es válido");
            return;
        }

        const tbody = document.querySelector('#listaProductos') as HTMLTableSectionElement;
        const filaExistente = tbody.querySelector(`tr[data-codigo="${producto.codigo}"]`) as HTMLTableRowElement;
        const cantidadActual = filaExistente
            ? Number(filaExistente.querySelector('[data-label="Cantidad"]')?.textContent) || 0
            : 0;
        const cantidadTotal = cantidadActual + cantidad;

        if (Number(cantidadTotal) > producto.stock) {
            mostrarError(`Cantidad insuficiente en stock. Stock disponible: ${producto.stock}`);
            return;
        }

        if (filaExistente) {
            filaExistente.remove();
        }

        await mostrarProductosEnTabla({
            codigo: producto.codigo,
            nombre: producto.nombre,
            cantidad: cantidadTotal,
            precio,
            subtotal: precio * cantidadTotal,
            pventa_bcv: producto.pventa_bcv,
        });
    }

    let productosListados: Producto[] = [];
    let renderOpcionesProductos: ((productos: Producto[]) => void) | null = null;

    async function rellenarSelectProductos() {

        const busqueda = document.getElementById("busquedaProductos") as HTMLInputElement;
        const productoSelect = document.getElementById("productoSelect") as HTMLSelectElement;

        try {

            const response = await fetch("/api/productos");
            const data = await response.json();

            productosListados = data;

            const renderOpciones = (productos: Producto[]) => {
                productoSelect.innerHTML = ""; // Limpiar opciones previas

                // Opción inicial vacía
                const defaultOption = document.createElement("option");
                defaultOption.value = "";
                defaultOption.textContent = "Selecciona un producto";
                defaultOption.disabled = true;
                defaultOption.selected = true;
                productoSelect.appendChild(defaultOption);

                // Mensaje si no hay registros para esa busqueda
                if (productos.length === 0) {
                    const noResultsOption = document.createElement("option");
                    noResultsOption.value = "";
                    noResultsOption.textContent = "— Sin coincidencias para la búsqueda —";
                    noResultsOption.disabled = true;
                    productoSelect.appendChild(noResultsOption);
                    return;
                }

                productos.forEach(producto => {
                    const option = document.createElement("option");
                    option.value = producto.id.toString();
                    option.textContent = `${producto.codigo.toUpperCase()} - ${producto.nombre} - ${producto.stock} ${producto.unidad_medida} - ${producto.venta} COP`;
                    productoSelect.appendChild(option);
                });
            };

            renderOpcionesProductos = renderOpciones;

            // Render inicial
            renderOpciones(productosListados);

            // Listener de búsqueda
            busqueda.addEventListener("input", () => {
                const filtro = busqueda.value.trim().toLowerCase();

                if (!filtro) {
                    renderOpciones(productosListados);
                    return;
                }

                const productosFiltrados = productosListados.filter(producto => {
                    const nombre = String(producto.nombre || "").toLowerCase();
                    const codigo = String(producto.codigo || "").toLowerCase();
                    return nombre.includes(filtro) || codigo.includes(filtro);
                });

                renderOpciones(productosFiltrados);
            });


        } catch (error) {
            console.error("Error al cargar los productos:", error);
        }
    }

    // Reiniciar presupuesto
    const btnReiniciar = document.querySelector('#reiniciar') as HTMLButtonElement;
    btnReiniciar.addEventListener('click', () => {
        window.location.reload();
    });

    const productoSelect = document.getElementById("productoSelect") as HTMLSelectElement;
    const precioInput = document.getElementById("precio") as HTMLInputElement;

    // Evento para actualizar el input del precio segun el inventario
    productoSelect.addEventListener("change", async () => {

        const productoId = productoSelect.value;

        if (!productoId) {
            precioInput.value = "";
            return;
        }

        try {
            const response = await fetch(`/api/productos/${productoId}`);

            if (!response.ok) {
                console.error("Error al obtener el producto:", response.status);
                precioInput.value = "";
                return;
            }

            const producto = await response.json();

            if (typeof producto.venta === "number") {
                precioInput.value = producto.venta.toFixed(2); // Formato profesional
            } else {
                precioInput.value = "";
            }

        } catch (error) {
            console.error("Error de red o parsing:", error);
            precioInput.value = "";
        }
    });

    const btnagregarProducto = document.getElementById("agregarProducto") as HTMLButtonElement;

    // Agregar el producto a la tabla
    btnagregarProducto.addEventListener("click", async (e) => {

        e.preventDefault();

        const productoId = productoSelect.value;
        const cantidadInput = document.getElementById("cantidad") as HTMLInputElement;

        const cantidad = Number(cantidadInput.value);
        const precio = parseFloat(precioInput.value);

        if (!productoId) {
            mostrarError("Selecciona un producto");
            return;
        }

        try {

            const response = await fetch(`/api/productos/${productoId}`);
            if (!response.ok) {
                throw new Error('Error al obtener el producto: ' + response.status);
            }
            const producto = await response.json();
            await procesarAgregarProducto(producto, cantidad, precio);

        } catch (error) {
            console.error("Error al obtener el producto:", error);
            return;
        }
    });

    async function mostrarProductosEnTabla(productoSeleccionado : { codigo: string; nombre: string; cantidad: number; precio: number; subtotal: number; pventa_bcv?: number; }) {
        
        const tbody = document.querySelector('#listaProductos') as HTMLTableSectionElement;
        const cantidadInput = document.getElementById("cantidad") as HTMLInputElement;
        const productoSelect = document.getElementById("productoSelect") as HTMLSelectElement;
        const precioInput = document.getElementById("precio") as HTMLInputElement;

        const { tasaCopUsd, tasaBcvUsd, recargoBcv } = await obtenerTasasPrecios();

        const pventaBcv = productoSeleccionado.pventa_bcv != null
            ? Number(productoSeleccionado.pventa_bcv)
            : calcularPventaBcv(productoSeleccionado.precio, tasaCopUsd, recargoBcv);

        let precioUsd = (productoSeleccionado.precio / tasaCopUsd).toFixed(2);
        let subtotalUsd = (productoSeleccionado.subtotal / tasaCopUsd).toFixed(2);

        let precioBs = calcularBsBcv(pventaBcv, tasaBcvUsd).toFixed(2);
        let subtotalBs = (calcularBsBcv(pventaBcv, tasaBcvUsd) * productoSeleccionado.cantidad).toFixed(2);

        const tr = document.createElement('tr');
        tr.dataset.codigo = productoSeleccionado.codigo;
        tr.innerHTML = `
                        <td data-label="Producto">
                            ${productoSeleccionado.codigo.toUpperCase()}
                            <br />
                            ${productoSeleccionado.nombre.toUpperCase()}
                        </td>

                        <td data-label="Precio por Unidad">
                            ${productoSeleccionado.precio.toFixed(2)} COP
                            <br />
                            <span style="font-size: .75rem;">${precioUsd} USD (divisas)</span>
                            <br />
                            <span style="font-size: .75rem;">${precioBs} Bs BCV</span>
                        </td>

                        <td data-label="Cantidad">${productoSeleccionado.cantidad}</td>

                        <td data-label="Subtotal">
                            <span class='subtotal'>${productoSeleccionado.subtotal.toFixed(2)}</span> COP
                            <br />    
                            <span style="font-size: .75rem;">${subtotalUsd} USD</span>
                            <br />    
                            <span style="font-size: .75rem;">${subtotalBs} Bs BCV</span>
                        </td>
                    `;

        // Botones de acciones
        const tdAcciones = document.createElement('td');
        tdAcciones.classList.add('acciones');

        // Boton de eliminar
        const btnEliminar = document.createElement('button');
        btnEliminar.classList.add('btn-eliminar');
        btnEliminar.textContent = 'DEL';
        btnEliminar.addEventListener('click', () => {
            tr.remove();
            totalizar();
            actualizarVisibilidadPresupuesto();
        });

        tdAcciones.appendChild(btnEliminar);
        tr.appendChild(tdAcciones);
        tbody.appendChild(tr);

        actualizarVisibilidadPresupuesto();

        // Resetear el formulario
        productoSelect.value = "";
        cantidadInput.value = "1";
        precioInput.value = "";
        
        //Manejo del total
        totalizar();
    }

    async function totalizar(){
        const elementosSubtotal = document.querySelectorAll('.subtotal') as NodeListOf<HTMLSpanElement>;
        const total = document.querySelector('#total') as HTMLSpanElement;

        if (elementosSubtotal.length === 0) {
            total.textContent = '';
            return;
        }

        total.innerHTML = '';

        const valoresSubtotal = Array.from(elementosSubtotal)
            .map(el => {
                const texto = el.textContent.trim();
                const match = texto.match(/[\d,.]+/); // Extrae el primer número
                return match ? parseFloat(match[0].replace(',', '')) : 0;
            });

        const { tasaCopUsd, tasaBcvUsd, recargoBcv } = await obtenerTasasPrecios();

        let totalCop = 0;

        valoresSubtotal.forEach(subtotal => {
            totalCop += subtotal;
        });

        const totalUsd = tasaCopUsd > 0 ? totalCop / tasaCopUsd : 0;
        const totalBs = calcularBsBcvDesdeCop(totalCop, tasaCopUsd, tasaBcvUsd, recargoBcv);
        
        total.textContent =  `Total: ${totalCop.toFixed(2)} COP | ${totalUsd.toFixed(2)} USD (divisas) | ${totalBs.toFixed(2)} Bs BCV` ;
    }



</script>