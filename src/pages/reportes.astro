                const iva = Number(c.iva_monto) || 0;
                const ret = Number(c.retencion_iva_monto) || 0;
                const tot = Number(c.monto_total) || 0;

                totalComprasPrincipal += tot;
                totalComprasUsd += convertirAMonedaBase(tot, monedaBase, 'USD', tasasC);
                if (!esNota) {
                    facturasCount += 1;
                    baseTotalBs += convertirAMonedaBase(base, monedaBase, 'BS', tasasC);
                    exentoTotalBs += convertirAMonedaBase(exento, monedaBase, 'BS', tasasC);
                    ivaCreditoBs += convertirAMonedaBase(iva, monedaBase, 'BS', tasasC);
