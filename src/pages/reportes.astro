---
import Layout from '../layouts/Layout.astro';
import { verificarToken } from '../utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}
if (usuario.rol !== 'admin') {
    return Astro.redirect('/dashboard'); 
}

const fechaActual = new Date().toLocaleDateString("es-VE", {
    timeZone: "America/Caracas",
    year: "numeric",
    month: "2-digit",
    day: "2-digit"
}).split('/').reverse().join('-');
---

<Layout>
    <section class="reportes-hero">
        <p class="eyebrow">Inteligencia comercial y fiscal</p>
        <h1>Reportes y Estadísticas</h1>
        <p>Explora el rendimiento del negocio, la facturación fiscal en Bolívares, las notas de entrega en divisas y los cierres de caja.</p>
    </section>

    <main class="form-container filtros-shell">
        <form onsubmit="return false;">
            <div>
                <label for="desde">Desde:</label>
                <input type="date" id="desde" name="desde" value={fechaActual} required />
            </div>

            <div>
                <label for="hasta">Hasta:</label>
                <input type="date" id="hasta" name="hasta" value={fechaActual} required />
            </div>
        </form>
    </main>

    <section class="menu-reportes">
        <nav>
            <button type="button" id="masVendido" data-label="Rendimiento comercial">Rendimiento</button>
            <button type="button" id="stock" data-label="Baja existencia">Baja Existencia</button>
            <button type="button" id="caja" data-label="Reporte de caja y fiscal">Reporte de Caja</button>
            <button type="button" id="metodosPago" data-label="Métodos de pago">Métodos de pago</button>
            <button type="button" id="ventas" data-label="Ventas totales (Facturas y Notas)">Ventas Totales</button>
            <button type="button" id="reportesZ" data-label="Cierres de Caja (Reportes Z)">Reportes Z</button>
            <button type="button" id="libroCompras" data-label="Libro de Compras (IVA Crédito Fiscal)">Libro de Compras</button>
            <button type="button" id="devoluciones" data-label="Devoluciones y Notas de Crédito">Devoluciones</button>
            <button type="button" id="creditos" data-label="Ventas a crédito">Créditos</button>
            <button type="button" id="fletes" data-label="Constancia y control de fletes">Fletes</button>
        </nav>
    </section>

    <section class="reportes-panel">
        <header class="reportes-panel__header">
            <div class="reportes-panel__info">
                <p class="eyebrow">Resultados</p>
                <h2 id="reporte-activo-titulo">Selecciona un reporte</h2>
                <p id="reporte-activo-desc">Elige un tipo de reporte arriba y, si aplica, define el rango de fechas.</p>
            </div>

            <div class="reportes-toolbar" id="reportes-toolbar" hidden>
                <button type="button" class="btn-excel" id="btnExportarExcel" aria-label="Exportar a Excel">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <path d="M8 13h2l2 3 2-3h2"></path>
                        <path d="M8 17h8"></path>
                    </svg>
                    Exportar Excel
                </button>
                <button type="button" class="btn-imprimir" id="imprimir" aria-label="Imprimir reporte">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                        <rect x="6" y="14" width="12" height="8"></rect>
                    </svg>
                    Imprimir reporte
                </button>
            </div>
        </header>

        <div id="reportes-empty" class="reportes-empty">
            <div class="reportes-empty__icon" aria-hidden="true">📊</div>
            <p class="reportes-empty__title">Sin resultados todavía</p>
            <p class="reportes-empty__text">Usa los botones superiores para generar gráficos, tablas o resúmenes de caja.</p>
        </div>

        <div id="reportes" class="reportes-output" hidden></div>
    </section>

    <div id="overlay" class="overlay oculto"> 
        <div id="modal" class="modal"></div>
    </div>
</Layout>

<style>

    .reportes-hero {
        padding: 1.6rem 1.8rem;
        border-radius: 28px;
        background: linear-gradient(135deg, #ffffff 0%, #f3f4f6 100%);
        color: #111827;
        border: 1px solid #e5e7eb;
        border-left: 5px solid var(--accent-brand);
        display: grid;
        gap: 0.6rem;
        box-shadow: 0 12px 24px rgba(17, 24, 39, 0.06);
    }

    .eyebrow {
        font-size: 0.74rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent-brand);
        font-weight: 700;
    }

    .reportes-hero h1 {
        max-width: none;
        color: #111827;
    }

    .reportes-hero p:not(.eyebrow) {
        max-width: 68ch;
        color: #4b5563;
    }

    .filtros-shell {
        width: min(100%, 780px);
    }

    form {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .menu-reportes nav {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 1.25rem;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
        box-shadow: 0 18px 32px rgba(var(--primary-rgb), 0.08);
    }

    .menu-reportes button {
        white-space: nowrap;
    }

    .menu-reportes button.is-active {
        background: linear-gradient(135deg, var(--accent-brand), color-mix(in srgb, var(--accent-brand) 62%, white));
        box-shadow: 0 14px 28px rgba(var(--accent-rgb), 0.32);
        transform: translateY(-1px);
    }

    .reportes-panel {
        display: grid;
        gap: 1.25rem;
        padding: 1.35rem;
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.86);
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
        box-shadow: 0 18px 32px rgba(var(--primary-rgb), 0.08);
    }

    .reportes-panel__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .reportes-panel__info {
        display: grid;
        gap: 0.35rem;
        flex: 1;
        min-width: min(100%, 280px);
    }

    .reportes-panel__info .eyebrow {
        color: var(--secondary-color);
    }

    .reportes-panel__info h2 {
        font-size: 1.35rem;
        color: var(--primary-color);
        margin: 0;
    }

    .reportes-panel__info p:last-child {
        color: var(--text-muted);
        font-size: 0.92rem;
        max-width: 52ch;
    }

    .reportes-toolbar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    .btn-imprimir {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 0.78rem 1.35rem;
        border: none;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--primary-color), var(--accent-brand));
        color: #fffaff;
        font-size: 0.88rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        box-shadow: 0 12px 26px rgba(var(--primary-rgb), 0.22);
        cursor: pointer;
        transition:
            transform 160ms ease,
            box-shadow 160ms ease,
            background 160ms ease;
    }

    .btn-imprimir:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 30px rgba(var(--primary-rgb), 0.28);
    }

    .btn-imprimir:active {
        transform: translateY(0);
    }

    .btn-imprimir svg {
        flex-shrink: 0;
    }

    .reportes-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
    }

    .btn-excel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.78rem 1.25rem;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #15803d, #166534);
        color: #fff;
        font-weight: 700;
        font-size: 0.92rem;
        cursor: pointer;
        box-shadow: 0 10px 22px rgba(21, 128, 61, 0.22);
        transition: transform 0.16s ease, box-shadow 0.16s ease;
    }

    .btn-excel:hover {
        transform: translateY(-1px);
        box-shadow: 0 14px 26px rgba(21, 128, 61, 0.28);
    }

    .btn-excel:disabled {
        opacity: 0.65;
        cursor: not-allowed;
        transform: none;
    }

    .reportes-toolbar[hidden],
    .reportes-empty[hidden],
    .reportes-output[hidden] {
        display: none !important;
    }

    .reportes-empty {
        display: grid;
        place-items: center;
        gap: 0.45rem;
        min-height: 220px;
        padding: 2rem 1.5rem;
        border-radius: 22px;
        border: 1px dashed rgba(var(--secondary-rgb), 0.16);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(237, 231, 248, 0.55));
        text-align: center;
    }

    .reportes-empty__icon {
        font-size: 2rem;
        line-height: 1;
        opacity: 0.85;
    }

    .reportes-empty__title {
        font-weight: 700;
        color: var(--secondary-color);
        font-size: 1rem;
    }

    .reportes-empty__text {
        color: var(--text-muted);
        font-size: 0.9rem;
        max-width: 42ch;
    }

    .reportes-output {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        width: 100%;
        overflow-x: auto;
    }

    @media (max-width: 640px) {
        form {
            grid-template-columns: 1fr;
        }

        .reportes-hero {
            padding: 1.3rem;
        }

        .reportes-panel__header {
            flex-direction: column;
        }

        .reportes-toolbar {
            width: 100%;
        }

        .btn-imprimir {
            width: 100%;
        }
    }

    @media (max-width: 600px) {
        .menu-reportes nav {
            flex-direction: column;
            align-items: stretch;
        }

        .menu-reportes button {
            width: 100%;
        }
    }

    :global(.grid-reportes) {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.2rem;
    }

    @media (max-width: 900px) {
        :global(.grid-reportes) {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        :global(.grid-reportes) {
            grid-template-columns: 1fr;
        }
    }

    :global(.card) {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(237, 231, 248, 0.9));
        border-radius: 22px;
        padding: 1.2rem;
        text-align: center;
        box-shadow: 0 16px 28px rgba(var(--primary-rgb), 0.08);
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
    }

    :global(.card h3) {
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
        color: var(--primary-color);
    }

    :global(.card p) {
        font-size: 1.4rem;
        font-weight: bold;
        margin: 0;
        color: var(--secondary-color); 
    }

    :global(.card small) {
        display: block;
        margin-top: 0.3rem;
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    :global(.card.highlight) {
        background: linear-gradient(135deg, rgba(var(--primary-rgb), 0.96), rgba(var(--secondary-rgb), 0.92));
        color: #fff;
    }

    :global(.card.highlight h3),
    :global(.card.highlight p),
    :global(.card.highlight small) {
        color: #fff;
    }

    .menu-reportes button:hover {
        scale: 1.03;
    }

    .menu-reportes button:active {
        scale: 0.98;
    }

    :global(.reporte-subseccion) {
        display: grid;
        gap: 0.85rem;
        padding: 1.1rem;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
    }

    :global(.reporte-subseccion h3) {
        font-size: 1rem;
        color: var(--secondary-color);
        margin: 0;
    }

    :global(.tabla-wrapper) {
        width: 100%;
        overflow-x: auto;
    }

    :global(table.tabla-reportes) {
        width: 100%;
        min-width: 520px;
        white-space: normal;
    }

</style>

<script>

    import { mostrarError } from '@/utils/helpers/mensajes.js';
    import { cambioUSDaCOP, obtenerTasas } from '@/utils/helpers/cambioMoneda.js';
    import { formatearFecha } from '@/utils/helpers/formateoFecha';
    import { renderChart, destroyCharts } from '@/utils/helpers/chart.js';
    import { imprimir } from '@/utils/helpers/imprimir.js';
    import { toPng } from "html-to-image";
    import { convertirAMonedaBase, formatearMoneda, obtenerMonedaBase } from '@/utils/helpers/tasas.js';
    import { descargarExcel } from '@/utils/helpers/exportarExcel.js';

    const masVendidoBtn = document.querySelector('#masVendido');
    const stockBtn = document.querySelector('#stock');
    const reportesZBtn = document.querySelector('#reportesZ');
    const libroComprasBtn = document.querySelector('#libroCompras');
    const cajaBtn = document.querySelector('#caja');
    const metodosPagoBtn = document.querySelector('#metodosPago');
    const ventasBtn = document.querySelector('#ventas');    
    const creditosBtn = document.querySelector('#creditos');
    const devolucionesBtn = document.querySelector('#devoluciones');
    const fletesBtn = document.querySelector('#fletes');
    const menuButtons = document.querySelectorAll('.menu-reportes button');
    const reportesContainer = document.getElementById('reportes') as HTMLDivElement;
    const reportesEmpty = document.getElementById('reportes-empty') as HTMLDivElement;
    const reportesToolbar = document.getElementById('reportes-toolbar') as HTMLDivElement;
    const reporteActivoTitulo = document.getElementById('reporte-activo-titulo') as HTMLHeadingElement;
    const reporteActivoDesc = document.getElementById('reporte-activo-desc') as HTMLParagraphElement;
    const btnImprimir = document.getElementById('imprimir') as HTMLButtonElement;
    const btnExportarExcel = document.getElementById('btnExportarExcel') as HTMLButtonElement;

    let exportPayloadActual: { nombreArchivo: string; hojas: Array<{ nombre: string; filas: any[] }> } | null = null;

    interface Producto {
        codigo_producto: string;
        nombre_producto: string;
        cantidad_total: number;
        total_usd: number;
        unidad_medida: string;
    }

    interface ReporteZ {
        id: string;
        nro_reporte_z: number | null;
        fecha_apertura: string;
        hora_apertura: string;
        fecha_cierre: string | null;
        hora_cierre: string | null;
        usuario_apertura_nombre: string;
        usuario_cierre_nombre: string | null;
        tasa_bcv_cierre: number;
        total_ventas_contado: number;
        total_ventas_credito: number;
        base_imponible_usd: number;
        base_imponible_bs: number;
        exento_usd: number;
        exento_bs: number;
        iva_usd: number;
        iva_bs: number;
        retencion_iva_usd: number;
        retencion_iva_bs: number;
        total_facturado_usd: number;
        total_facturado_bs: number;
        total_devoluciones_usd: number;
        total_devoluciones_bs: number;
        cantidad_facturas: number;
        primera_factura: number | null;
        ultima_factura: number | null;
        observaciones: string;
    }

    interface DevolucionReporte {
        id: string;
        id_venta: number;
        monto_total: number;
        tipo_resolucion: string;
        saldo_disponible: number;
        motivo: string;
        fecha_creacion: string;
        cliente_nombre: string;
        cliente_cedula: string;
    }

    interface VentaReporte {
        id?: string;
        tipo_documento?: string;
        nro_factura?: number | null;
        nro_nota_entrega?: number | null;
        fecha_venta: string;
        nombre_cliente: string;
        cedula_cliente: string;
        subtotal_base?: number;
        subtotal_exento?: number;
        iva_monto?: number;
        retencion_iva_monto?: number;
        tasa_bcv?: number;
        tasa_cop?: number;
        total_usd: number;
        saldo_pendiente?: number;
        tipo_pago: string;
        estado: string;
        facturada_en_venta_id?: string | null;
        nota_entrega_origen_id?: string | null;
    }

    function setActiveButton(activeBtn: HTMLElement | null) {
        menuButtons.forEach((btn) => {
            btn.classList.toggle('is-active', btn === activeBtn);
        });
    }

    function setImprimirVisible(visible: boolean) {
        reportesToolbar.hidden = !visible;
    }

    function setResultadosVisibles(visible: boolean) {
        reportesContainer.toggleAttribute('hidden', !visible);
        reportesEmpty.toggleAttribute('hidden', visible);
    }

    function setEstadoInicial() {
        reportesContainer.toggleAttribute('hidden', true);
        reportesEmpty.toggleAttribute('hidden', false);
        setImprimirVisible(false);
    }

    function setEstadoCargando() {
        reportesContainer.toggleAttribute('hidden', true);
        reportesEmpty.toggleAttribute('hidden', true);
        setImprimirVisible(false);
    }

    function restablecerVistaInicial() {
        setActiveButton(null);
        setEstadoInicial();
        setReporteMeta('Selecciona un reporte', 'Elige un tipo de reporte arriba y, si aplica, define el rango de fechas.');
    }

    function setReporteMeta(titulo: string, descripcion: string) {
        reporteActivoTitulo.textContent = titulo;
        reporteActivoDesc.textContent = descripcion;
    }

    function mostrarResultados(titulo: string, descripcion: string) {
        setReporteMeta(titulo, descripcion);
        setResultadosVisibles(true);
        setImprimirVisible(true);
    }

    function resetContenedor() {
        destroyCharts('reportes');
        exportPayloadActual = null;
        reportesContainer.innerHTML = '';
        reportesContainer.classList.remove('charts-grid');
        setEstadoCargando();
        setReporteMeta('Generando reporte…', 'Estamos preparando la información solicitada.');
    }

    setEstadoInicial();

    function prepararGraficos(cantidad = 1) {
        if (cantidad > 1) {
            reportesContainer.classList.add('charts-grid');
        }
    }

    function validarFechas(desde: string, hasta: string): boolean {
        if (!desde || !hasta) {
            mostrarError('Debe seleccionar ambas fechas');
            return false;
        }
        if (hasta < desde) {
            mostrarError('La fecha final no puede ser menor que la inicial');
            return false;
        }
        return true;
    }

    function getButtonMeta(button: HTMLElement) {
        return {
            titulo: button.dataset.label || button.textContent?.trim() || 'Reporte',
            descripcion: 'Resultados listos para revisión e impresión.',
        };
    }

    masVendidoBtn?.addEventListener("click", async (e: Event) => {

        e.preventDefault();
        const button = e.currentTarget as HTMLElement;
        resetContenedor();
        setActiveButton(button);

        const desde = (document.querySelector("#desde") as HTMLInputElement)?.value;
        const hasta = (document.querySelector("#hasta") as HTMLInputElement)?.value;

        if (!validarFechas(desde, hasta)) {
            restablecerVistaInicial();
            return;
        }

        try {
            const response = await fetch(`/api/reportes/productosMasVendidos?desde=${desde}&hasta=${hasta}`);
            if (!response.ok) throw new Error(`Error ${response.status}`);

            const productos: {
                mas_vendidos: Producto[];
                menos_vendidos: Producto[];
            } = await response.json();

            if (!productos || !Array.isArray(productos.mas_vendidos) || !Array.isArray(productos.menos_vendidos) || (productos.mas_vendidos.length === 0 && productos.menos_vendidos.length === 0)) {
                restablecerVistaInicial();
                mostrarError('No hay productos vendidos en ese rango de fecha');
                return;
            }

            const meta = getButtonMeta(button);
            mostrarResultados(meta.titulo, `Comparativo de productos entre ${desde} y ${hasta}.`);
            prepararGraficos(2);

            renderChart(
                "Productos Más Vendidos",
                productos.mas_vendidos.map((p: Producto) => p.nombre_producto.toUpperCase()),
                productos.mas_vendidos.map((p: Producto) => p.cantidad_total),
                { valueLabel: "Unidades vendidas" }
            );

            renderChart(
                "Productos Menos Vendidos",
                productos.menos_vendidos.map((p: Producto) => p.nombre_producto.toUpperCase()),
                productos.menos_vendidos.map((p: Producto) => p.cantidad_total),
                { valueLabel: "Unidades vendidas" }
            );

        } catch (error) {
            console.error("Error al generar reporte:", error);
            restablecerVistaInicial();
            mostrarError('No se pudo generar el reporte');
        }
    });

    stockBtn?.addEventListener('click', async (e: Event) => {

        e.preventDefault();
        const button = e.currentTarget as HTMLElement;
        resetContenedor();
        setActiveButton(button);

        try {
            const response = await fetch(`/api/reportes/menosStock`);
            if (!response.ok) throw new Error(`Error ${response.status}`);

            const productos = await response.json();

            if (!productos || !Array.isArray(productos.bajos) 
                || !Array.isArray(productos.agotados) 
                || (productos.bajos.length === 0 && productos.agotados.length === 0)
            ) {
                restablecerVistaInicial();
                mostrarError('No hay productos con poco stock');
                return;
            }

            const meta = getButtonMeta(button);
            mostrarResultados(meta.titulo, 'Inventario crítico y productos agotados en el sistema.');

            if (productos.bajos.length > 0) {
                renderChart(
                    "Productos Bajos en Stock",
                    productos.bajos.map((p: Producto) => p.nombre_producto.toUpperCase()),
                    productos.bajos.map((p: Producto) => p.cantidad_total),
                    { valueLabel: "Stock disponible" }
                );
            }

            if (productos.agotados.length > 0) {
                const tablaAgotados = `
                    <section class="reporte-subseccion">
                        <h3>Productos Agotados</h3>
                        <div class="tabla-wrapper">
                            <table class="tabla-reportes">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Código</th>
                                        <th>Cantidad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${productos.agotados.map((p: Producto) => `
                                        <tr>
                                            <td>${p.nombre_producto.toUpperCase()}</td>
                                            <td>${p.codigo_producto}</td>
                                            <td>${p.cantidad_total} ${p.unidad_medida}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
