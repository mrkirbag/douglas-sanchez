                                return `
                                    <tr>
                                        <td><span style="padding:0.2rem 0.55rem; border-radius:999px; font-weight:700; font-size:0.8rem; color:${badgeColor}; background:${badgeBg};">${m.origen}</span></td>
                                        <td><a href="${m.url_detalle}" style="color:var(--primary-color); font-weight:700; text-decoration:underline;">#${m.id_transaccion}</a></td>
                                        <td>${m.documento || '-'}</td>
                                        <td>${formatearFecha(m.fecha)}</td>
                                        <td>${m.contraparte || '-'}${m.contraparte_doc ? ` <small style="color:var(--text-muted);">(${m.contraparte_doc})</small>` : ''}</td>
                                        <td style="font-weight:700; color:#b45309;">${fmtFlete(m.flete_monto || 0)}<br/><small>${fmtFleteUsd(m.flete_monto || 0)}</small></td>
                                        <td>${fmtFlete(m.total_operacion || 0)}<br/><small>${fmtFleteUsd(m.total_operacion || 0)}</small></td>
                                    </tr>
                                `;
                            }).join('')}
                    </tbody>
                </table>
            `;
            reportesContainer.appendChild(tablaWrapper);

            exportPayloadActual = {
                nombreArchivo: `Reporte_Fletes_${desde}_${hasta}.xlsx`,
                hojas: [
                    {
                        nombre: 'Resumen',
                        filas: [
                            { Concepto: `Total Fletes General (${monedaBase})`, Monto: Number((res.total_fletes_general || 0).toFixed(2)), Cantidad: Number(res.cantidad_total || 0) },
                            { Concepto: `Fletes en Ventas (${monedaBase})`, Monto: Number((res.total_fletes_ventas || 0).toFixed(2)), Cantidad: Number(res.cantidad_ventas || 0) },
                            { Concepto: `Fletes en Compras (${monedaBase})`, Monto: Number((res.total_fletes_compras || 0).toFixed(2)), Cantidad: Number(res.cantidad_compras || 0) },
                        ],
                    },
                    {
                        nombre: 'Detalle_Fletes',
                        filas: movs.map((m: any) => ({
                            Tipo: m.origen,
                            ID_Transaccion: m.id_transaccion,
                            Documento: m.documento,
                            Fecha: m.fecha,
                            Contraparte: m.contraparte,
                            RIF_Cedula: m.contraparte_doc || '',
                            [`Monto_Flete_${monedaBase}`]: Number((m.flete_monto || 0).toFixed(2)),
                            [`Total_Operacion_${monedaBase}`]: Number((m.total_operacion || 0).toFixed(2)),
                        })),
                    },
                ],
            };
        } catch (error) {
            console.error('Error al generar reporte de fletes:', error);
            restablecerVistaInicial();
            mostrarError('No se pudo generar el reporte de fletes');
        }
    });

    btnExportarExcel?.addEventListener('click', async () => {
        if (reportesContainer.hidden || !reportesContainer.children.length) {
            mostrarError('Genera un reporte primero para exportar');
            return;
        }

        let payload = exportPayloadActual;

        if (!payload) {
            const hojas: Array<{ nombre: string; filas: any[] }> = [];
            const cards = reportesContainer.querySelectorAll('.cards-resumen .card, .grid-reportes .card');
            if (cards.length > 0) {
                const filasResumen = Array.from(cards).map((card) => ({
                    Indicador: card.querySelector('h3')?.textContent?.trim() || '',
                    Valor: card.querySelector('p')?.textContent?.trim() || '',
                    Detalle: card.querySelector('small')?.textContent?.trim() || '',
                }));
                hojas.push({ nombre: 'Resumen', filas: filasResumen });
            }

            const tablas = reportesContainer.querySelectorAll('table.tabla-reportes');
            tablas.forEach((tbl, idx) => {
                const headers = Array.from(tbl.querySelectorAll('thead th')).map((th) => th.textContent?.trim() || `Col_${idx + 1}`);
                const filas = Array.from(tbl.querySelectorAll('tbody tr')).map((tr) => {
                    const obj: Record<string, string> = {};
                    Array.from(tr.querySelectorAll('td')).forEach((td, cIdx) => {
                        const key = headers[cIdx] || `Col_${cIdx + 1}`;
                        obj[key] = (td.textContent || '').replace(/\s+/g, ' ').trim();
                    });
                    return obj;
                });
                if (filas.length > 0) {
                    hojas.push({ nombre: tablas.length > 1 ? `Detalle_${idx + 1}` : 'Detalle', filas });
                }
            });

            if (hojas.length === 0) {
                mostrarError('Este reporte no contiene tablas o tarjetas exportables');
                return;
            }

            const slug = (reporteActivoTitulo.textContent || 'reporte')
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, '_');
            payload = { nombreArchivo: slug, hojas };
        }

        btnExportarExcel.disabled = true;
        const textoOrig = btnExportarExcel.textContent;
        try {
            await descargarExcel(payload);
        } catch (err: any) {
            mostrarError(err?.message || 'Error al exportar a Excel');
        } finally {
            btnExportarExcel.disabled = false;
            if (textoOrig) {
                // mantiene el SVG intacto si no se sobreescribió
            }
        }
    });

    btnImprimir?.addEventListener("click", async () => {
        if (reportesContainer.hidden || !reportesContainer.children.length) {
            mostrarError('No hay contenido disponible para imprimir');
            return;
        }

        btnImprimir.disabled = true;

        try {
            const imgData = await toPng(reportesContainer, { cacheBust: true, pixelRatio: 2 });
            const tituloReporte = reporteActivoTitulo.textContent?.trim() || 'REPORTE';

            imprimir({
                titulo: 'Impresion',
                tituloDocumento: tituloReporte,
                estilosExtra: 'body { text-align: center; } img { max-width: 100%; height: auto; }',
                contenido: `<img src="${imgData}" alt="Reporte" />`,
                onReady: (ventana: Window) => {
                    const img = ventana.document.querySelector('img');
                    const ejecutarImpresion = () => {
                        ventana.focus();
                        ventana.print();
                        ventana.close();
                    };

                    if (!img) return;

                    if (img.complete) {
                        ejecutarImpresion();
                        return;
                    }

                    img.addEventListener('load', ejecutarImpresion);
                },
            } as Parameters<typeof imprimir>[0]);
        } catch (error) {
            console.error('Error al imprimir:', error);
            mostrarError('No se pudo preparar la impresión');
        } finally {
            btnImprimir.disabled = false;
        }
    });

</script>
